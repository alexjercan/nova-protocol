// The Ledger - the alt storyline campaign (task 20260716-123535, spike
// 20260716-183104). Chapters chained with NextScenario: chapter one is
// the campaign's entry in the Scenarios picker; everything after is hidden
// (reached only by playing). Chapter two plays in two acts across two
// scenario files (claim jumpers, then the heavies) so a death retries the
// current act, not the chapter - the difficulty rework of task
// 20260717-112630. Chapter five is a REWARD FINALE reached only by the fight
// (SELL) ending of chapter four - the big-gunship raid on the Magpie base
// (task 20260723-182855). A PORTAL mod like gauntlet: lives under webmods/,
// published by scripts/gen-portal.py, never shipped inside assets/.
//
// Since task 20260824-125959 it also carries its own FLEET: the Kenney-cut
// Racer, CargoB and CargoA parts, ships and GLB art that used to be base
// content. The base game is block-built now, and this mod is where the cast
// meshes live - which is what makes it look like a different game.
(
    content: [
        // The mod's own parts and craft first: a ship names its section
        // prototypes by id, so the catalog it reads must merge before it, and
        // a scenario's inline hulls must find both.
        "ledger_sections.content.ron",
        "ledger_ships.content.ron",
        "ledger_campaign.content.ron",
        "ledger_ch1.content.ron",
        "ledger_ch2.content.ron",
        "ledger_ch2b.content.ron",
        "ledger_ch3.content.ron",
        "ledger_ch4.content.ron",
        "ledger_ch5_the_raid.content.ron",
    ],
    // The mod's OWN art. One picker thumbnail per chapter, generated by
    // `scripts/gen-scenario-thumbnails.py` until real art lands at the same
    // paths (task 20260715-220011). Before this every chapter pointed at
    // `dep://base/textures/asteroid.png`, so the picker showed one rock for the
    // whole campaign.
    //
    // The `gltf/parts/` meshes are the semantic craft cuts (Kenney Space Kit,
    // CC0; see `credits/CREDITS.md`), named by the prototypes in
    // `ledger_sections.content.ron` with `self://`.
    resources: [
        "thumbnails/ledger_ch1_dead_weight.png",
        "thumbnails/ledger_ch2_claim_jumpers.png",
        "thumbnails/ledger_ch2b_the_heavies.png",
        "thumbnails/ledger_ch3_quiet_channel.png",
        "thumbnails/ledger_ch4_the_buyer.png",
        "thumbnails/ledger_ch5_the_raid.png",
        "gltf/parts/racer/engine_port.glb",
        "gltf/parts/racer/engine_starboard.glb",
        "gltf/parts/racer/fuselage.glb",
        "gltf/parts/racer/nose.glb",
        "gltf/parts/racer/tail.glb",
        "gltf/parts/racer/wing_port.glb",
        "gltf/parts/racer/wing_starboard.glb",
        "gltf/parts/cargob/engine_port.glb",
        "gltf/parts/cargob/engine_starboard.glb",
        "gltf/parts/cargob/fuselage.glb",
        "gltf/parts/cargob/nose.glb",
        "gltf/parts/cargob/pod_port.glb",
        "gltf/parts/cargob/pod_starboard.glb",
        "gltf/parts/cargob/tail.glb",
        "gltf/parts/cargoa/engine_port.glb",
        "gltf/parts/cargoa/engine_starboard.glb",
        "gltf/parts/cargoa/fuselage.glb",
        "gltf/parts/cargoa/nose.glb",
        "gltf/parts/cargoa/pod_port.glb",
        "gltf/parts/cargoa/pod_starboard.glb",
        "gltf/parts/cargoa/tail.glb",
    ],
    meta: (
        name: "The Ledger",
        description: "A salvage crew in over its head: four chapters and a reward finale, one sealed crate everyone in the belt wants.",
        author: "Nova Protocol",
        version: "1.28.0",
        dependencies: ["base"],
    ),
)
