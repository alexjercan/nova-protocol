+    /// Assembly tensor in the PD, torque on the player root only.
+    Comp,
+    /// Assembly tensor in the PD, `splitW` over both roots.
+    SplitW,
+    /// Partner sections built into the player root, partner computers removed.
+    Rigid,
+}
+
+impl Mode {
+    fn label(self) -> &'static str {
+        match self {
+            Self::Base => "base",
+            Self::Comp => "comp",
+            Self::SplitW => "splitW",
+            Self::Rigid => "rigid",
