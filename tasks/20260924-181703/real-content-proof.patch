+    saturated: f32,
+    joint_m: f32,
+    joint_deg: f32,
+    max_joint_rate: f32,
+    tail_rate: f32,
+    tail_error: f32,
+    tail_joint_rate: f32,
+    burn_arm_m: f32,
+    joint_alive: bool,
+    /// Authority: assembly rotation and `|dL| / Iasm yaw` over the neutral
+    /// window. Redock: whether the re-dock took and the pose change.
+    neutral_turn_deg: f32,
+    neutral_dl: f32,
+    redocked: bool,
+    redock_m: f32,
+    redock_deg: f32,
+    after_settle: f32,
+    after_error: f32,
+}
+
+fn diag(tensor: Mat3) -> Vec3 {
+    Vec3::new(tensor.x_axis.x, tensor.y_axis.y, tensor.z_axis.z)
+}
+
+fn apply_split(app: &mut App, ship: Entity, body: Entity, mode: Mode) {
+    let (tensor, _, parts) = assembly(app, ship, Some(body));
+    let mut ship = app.world_mut().entity_mut(ship);
+    ship.remove::<(TemporaryAssemblyInertia, TemporarySplit)>();
+    if mode == Mode::Comp || mode == Mode::SplitW {
+        ship.insert(TemporaryAssemblyInertia(
+            ComputedAngularInertia::from_tensor(
+                avian3d::math::SymmetricMatrix::from_mat3_unchecked(tensor),
+            ),
+        ));
+    }
+    if mode == Mode::SplitW {
+        ship.insert(TemporarySplit {
+            parts: [parts[0], parts[1]],
+            inverse_assembly: tensor.inverse(),
+        });
+    }
+}
+
+fn dock(app: &mut App, ship: Entity, body: Entity) -> Option<Entity> {
+    app.world_mut().trigger(DockingConnectionRequest {
+        entity: ship,
+        target: body,
+    });
+    app.update();
+    let connection = app.world().get::<DockedShip>(ship)?.connection;
+    assert!(app.world().get::<DockedShip>(body).is_some());
+    assert!(app.world().get::<FixedJoint>(connection).is_some());
+    Some(connection)
+}
+
+fn run(partner: Option<&'static str>, case: Case, mode: Mode, report: bool) -> Row {
+    let mut app = app();
+    let offset = partner.map(|partner| partner_offset(&app, partner));
+    let design = match (partner, mode) {
+        (Some(partner), Mode::Rigid) => {
+            let player = app
+                .world()
+                .resource::<GameShipDesigns>()
+                .get_design(&WARSHIP.into())
+                .unwrap()
+                .design
+                .clone();
+            let other = app
+                .world()
+                .resource::<GameShipDesigns>()
+                .get_design(&partner.into())
+                .unwrap()
+                .design
+                .clone();
+            let mut merged = player;
+            merged
+                .sections
+                .extend(other.sections.into_iter().map(|mut section| {
+                    section.id = format!("partner_{}", section.id);
+                    section.position += offset.unwrap();
+                    section
+                }));
+            ShipDesignSource::Inline(merged)
+        }
+        _ => ShipDesignSource::prototype(WARSHIP),
+    };
+    let ship = spawn_ship(&mut app, design, Vec3::ZERO);
+    let body = match (partner, mode) {
+        (Some(partner), Mode::Base | Mode::Comp | Mode::SplitW) => Some(spawn_ship(
+            &mut app,
+            ShipDesignSource::prototype(partner),
+            offset.unwrap(),
+        )),
+        _ => None,
+    };
+    settle(&mut app);
+    if mode == Mode::Rigid && partner.is_some() {
+        // The partner's computers are neutral in the docked modes, so the
+        // reference flies on the player's computers alone.
+        let mut query = app
+            .world_mut()
+            .query_filtered::<(Entity, &nova_events::EntityId, &ChildOf), With<ControllerSectionMarker>>();
+        let partner_computers: Vec<Entity> = query
+            .iter(app.world())
+            .filter(|(_, id, parent)| parent.0 == ship && id.0.starts_with("partner_"))
+            .map(|(entity, ..)| entity)
+            .collect();
+        for computer in partner_computers {
+            app.world_mut().entity_mut(computer).remove::<(
+                ControllerSectionMarker,
+                PDController,
+                PDControllerInput,
+                PDControllerOutput,
+                PDControllerTarget,
+                ControllerSectionRotationInput,
+                ControllerSectionTuning,
+            )>();
+        }
+    }
+    settle(&mut app);
+    let roots_before = app
+        .world_mut()
+        .query_filtered::<(), With<SpaceshipRootMarker>>()
+        .iter(app.world())
+        .count();
+    let speeds: Vec<(f32, f32)> = [Some(ship), body]
+        .into_iter()
+        .flatten()
+        .map(|entity| {
+            (
+                app.world().get::<LinearVelocity>(entity).unwrap().0.length(),
+                app.world().get::<AngularVelocity>(entity).unwrap().0.length(),
+            )
+        })
+        .collect();
+    assert!(
+        speeds.iter().all(|(v, w)| *v < 1e-4 && *w < 1e-4),
+        "hulls touch before docking: {speeds:?}"
+    );
+    let mut connection = match body {
+        Some(body) => {
+            let connection = dock(&mut app, ship, body).expect("real dock refused");
+            // Take control: the player root leaves neutral, the partner stays.
+            app.world_mut().entity_mut(ship).remove::<DockedShip>();
+            Some(connection)
+        }
+        None => None,
+    };
+    settle(&mut app);
+    let (tensor, com, _) = assembly(&app, ship, body);
+    let player_tensor = Mat3::from(
+        app.world()
+            .get::<ComputedAngularInertia>(ship)
+            .unwrap()
+            .tensor(),
+    );
+    let (computer_count, total_torque) = controllers(&mut app, ship);
+    let player_mass = app.world().get::<ComputedMass>(ship).unwrap().value();
+    let mass_ratio =
+        body.map_or(0.0, |body| app.world().get::<ComputedMass>(body).unwrap().value())
+            / player_mass;
+    if let Some(body) = body {
+        apply_split(&mut app, ship, body, mode);
+    }
+    let forward: Vec<_> = drives(&mut app, ship)
+        .into_iter()
+        .filter(|(_, push, ..)| push.dot(Vec3::NEG_Z) > 0.9)
+        .collect();
+    // Burn subset: the forward drives whose summed moment about the assembly
+    // centre of mass is smallest per unit thrust.
+    let mut best = (f32::INFINITY, 0u32);
+    for mask in 1u32..(1 << forward.len()) {
+        let (force, moment) = forward
+            .iter()
+            .enumerate()
+            .filter(|(index, _)| mask & (1 << index) != 0)
+            .fold((Vec3::ZERO, Vec3::ZERO), |(f, m), (_, drive)| {
+                let push = drive.1 * drive.3;
+                (f + push, m + (drive.2 - com).cross(push))
+            });
+        let arm = moment.length() / force.length();
+        if arm < best.0 - 1e-4 {
+            best = (arm, mask);
+        }
+    }
+    let (burn_mask, burn_arm_m) = match case {
+        Case::BurnAll => {
+            let all = (1u32 << forward.len()) - 1;
+            let (force, moment) = forward
+                .iter()
+                .fold((Vec3::ZERO, Vec3::ZERO), |(f, m), drive| {
+                    let push = drive.1 * drive.3;
+                    (f + push, m + (drive.2 - com).cross(push))
+                });
+            (all, moment.length() / force.length() * 10.0)
+        }
+        Case::BurnBalanced => (best.1, best.0 * 10.0),
+        _ => (0, 0.0),
+    };
+    if report {
+        println!(
+            "  setup {:>9} {:>6}: player {} sections, mass {:.1}, partner/player {:.3}, \
+             computers {}, sum max_torque {:.0}, HullRadius {:.2}, forward drives {:?}, \
+             assembly COM {:.2?}, burn mask {:b}",
+            partner.unwrap_or("undocked"),
+            mode.label(),
+            children_count(&app, ship),
+            player_mass,
+            mass_ratio,
+            computer_count,
+            total_torque,
+            app.world().get::<HullRadius>(ship).map_or(0.0, |r| r.0),
+            forward
+                .iter()
+                .map(|d| (d.2.to_array(), d.3))
+                .collect::<Vec<_>>(),
+            com,
+            burn_mask,
+        );
+    }
+
+    let bodies: Vec<Entity> = [Some(ship), body].into_iter().flatten().collect();
+    let start = app.world().get::<Rotation>(ship).unwrap().0;
+    app.world_mut().entity_mut(ship).insert(Helm(start));
+    app.update();
+
+    let (axis, command) = match case {
+        Case::Step(axis, _) => (axis, 90.0f32.to_radians()),
+        Case::Authority => (Vec3::Y, 45.0f32.to_radians()),
+        Case::Redock => (Vec3::Y, 90.0f32.to_radians()),
+        _ => (Vec3::Y, 0.0),
+    };
+    let mut target = Quat::from_axis_angle(axis, command);
+    app.world_mut().get_mut::<Helm>(ship).unwrap().0 = target;
+    let mut rest = body.map(|body| relative(&app, ship, body));
+    let steps = (case.seconds() / DT) as usize;
+    let tail = steps - (10.0 / DT) as usize;
+    let mut row = Row {
+        mass_ratio,
+        player_inertia: diag(player_tensor),
+        assembly_inertia: diag(tensor),
+        burn_arm_m,
+        ..default()
+    };
+    let (mut reached, mut sign, mut last_outside, mut peak_along) = (false, 1.0f32, 0usize, 0.0f32);
+    let mut saturated = 0usize;
+    let mut q_output = app
+        .world_mut()
+        .query::<(&PDControllerOutput, &PDController, &PDControllerTarget)>();
+    let neutral_window = ((2.0 / DT) as usize, (12.0 / DT) as usize);
+    let redock_window = ((20.0 / DT) as usize, (22.0 / DT) as usize);
+    let mut neutral_start = (Vec3::ZERO, Quat::IDENTITY);
+    let mut after_start = 0usize;
+    for step in 0..steps {
+        // Scripted events before the tick.
+        if matches!(case, Case::BurnAll | Case::BurnBalanced) {
+            for (index, drive) in forward.iter().enumerate() {
+                let on = step < 180 && burn_mask & (1 << index) != 0;
+                app.world_mut()
+                    .get_mut::<ThrusterSectionInput>(drive.0)
+                    .unwrap()
+                    .0 = if on { 1.0 } else { 0.0 };
+            }
+        }
+        if case == Case::Authority && step == neutral_window.0 {
+            let rotation = app.world().get::<Rotation>(ship).unwrap().0;
+            app.world_mut().entity_mut(ship).insert(DockedShip {
+                connection: connection.unwrap_or(Entity::PLACEHOLDER),
+                helm: rotation,
+            });
+            neutral_start = (angular_momentum(&app, &bodies), rotation);
+        }
+        if case == Case::Authority && step == neutral_window.1 {
+            let rotation = app.world().get::<Rotation>(ship).unwrap().0;
+            row.neutral_turn_deg = neutral_start.1.angle_between(rotation).to_degrees();
+            row.neutral_dl = (angular_momentum(&app, &bodies) - neutral_start.0).length()
+                / tensor.y_axis.y;
+            app.world_mut().entity_mut(ship).remove::<DockedShip>();
+            after_start = step;
+        }
+        if case == Case::Redock && step == redock_window.0 {
+            if let Some(body) = body {
+                app.world_mut()
+                    .trigger(DockingReleaseRequest { entity: body });
+                app.world_mut()
+                    .entity_mut(ship)
+                    .remove::<(TemporaryAssemblyInertia, TemporarySplit)>();
+            }
+        }
+        if case == Case::Redock && step == redock_window.1 {
+            if let Some(body) = body {
+                let before = rest.unwrap();
+                connection = dock(&mut app, ship, body);
+                row.redocked = connection.is_some();
+                if row.redocked {
+                    app.world_mut().entity_mut(ship).remove::<DockedShip>();
+                    apply_split(&mut app, ship, body, mode);
+                    let now = relative(&app, ship, body);
+                    row.redock_m = (now.0 - before.0).length() * 10.0;
+                    row.redock_deg = (before.1.inverse() * now.1).to_axis_angle().1.to_degrees();
+                    rest = Some(now);
+                }
+            } else {
+                row.redocked = true;
+            }
+            target = Quat::IDENTITY;
+            app.world_mut().get_mut::<Helm>(ship).unwrap().0 = target;
+            after_start = step;
+            reached = false;
+            sign = 1.0;
+        }
+
+        app.update();
+
+        let rotation = app.world().get::<Rotation>(ship).unwrap().0;
+        let rate = app.world().get::<AngularVelocity>(ship).unwrap().0.length();
+        let step_axis = if case == Case::Redock && step >= redock_window.1 {
+            -axis
+        } else {
+            axis
+        };
+        let (along, off) = residual(rotation, target, step_axis);
+        let error = along.abs().max(off);
+        let in_window = !(case == Case::Redock
+            && (redock_window.0..=redock_window.1).contains(&step));
+        if error > 1.0f32.to_radians() || rate > 0.05 {
+            last_outside = step;
+        }
+        if command != 0.0 && in_window {
+            if !reached && along >= 0.0 {
+                reached = true;
+                sign = 1.0;
+            }
+            if reached {
+                peak_along = peak_along.max(along);
+                if along.abs() > 1.0f32.to_radians() && along.signum() != sign {
+                    sign = along.signum();
+                    row.reversals += 1;
+                }
+            }
+        } else if command == 0.0 {
+            row.error = row.error.max(rotation.angle_between(target));
+        }
+        row.off_axis = row.off_axis.max(off);
+        if step >= tail {
+            row.tail_rate = row.tail_rate.max(rate);
+            row.tail_error = row.tail_error.max(error);
+        }
+        let (torque, acceleration) = q_output
+            .iter(app.world())
+            .filter(|(.., target)| target.0 == ship)
+            .fold((Vec3::ZERO, 0.0), |(torque, acceleration), (output, pd, _)| {
+                (torque + output.0, acceleration + pd.max_angular_acceleration)
+            });
+        if step == 0 {
+            row.budget = acceleration;
+        }
+        let neutral = app.world().get::<DockedShip>(ship).is_some();
+        if !neutral {
+            let share = torque.length() / total_torque;
+            row.peak_torque = row.peak_torque.max(share);
+            if share >= 0.99 {
+                saturated += 1;
+            }
+        }
+        if let (Some(body), Some((p0, r0))) = (body, rest) {
+            let attached = connection.is_some_and(|c| app.world().get_entity(c).is_ok());
+            if attached {
+                let (p, r) = relative(&app, ship, body);
+                row.joint_m = row.joint_m.max((p - p0).length() * 10.0);
+                row.joint_deg = row
+                    .joint_deg
+                    .max((r0.inverse() * r).to_axis_angle().1.to_degrees());
+                let spin = (app.world().get::<AngularVelocity>(body).unwrap().0
+                    - app.world().get::<AngularVelocity>(ship).unwrap().0)
+                    .length();
+                row.max_joint_rate = row.max_joint_rate.max(spin);
+                if step >= tail {
+                    row.tail_joint_rate = row.tail_joint_rate.max(spin);
+                }
+            }
+        }
+    }
+    if command != 0.0 {
+        row.error = peak_along.max(0.0);
+    }
+    row.error = row.error.to_degrees();
+    row.off_axis = row.off_axis.to_degrees();
+    row.tail_error = row.tail_error.to_degrees();
+    row.settle = (last_outside + 1) as f32 * DT;
+    row.saturated = saturated as f32 * DT;
+    if matches!(case, Case::Authority | Case::Redock) {
+        row.after_settle = (last_outside.saturating_sub(after_start) + 1) as f32 * DT;
+        let rotation = app.world().get::<Rotation>(ship).unwrap().0;
+        row.after_error = rotation.angle_between(target).to_degrees();
+    }
+    row.joint_alive = match (body, connection) {
+        (Some(_), Some(connection)) => {
+            app.world().get::<FixedJoint>(connection).is_some()
+                && app.world().get::<DockingConnection>(connection).is_some()
+        }
+        (Some(_), None) => false,
+        (None, _) => true,
+    };
+    let roots_after = app
+        .world_mut()
+        .query_filtered::<(), With<SpaceshipRootMarker>>()
+        .iter(app.world())
+        .count();
+    assert_eq!(roots_before, roots_after, "a hull split during the run");
+    row
+}
+
+const PARTNERS: [Option<&str>; 4] = [None, Some(WORKSHIP), Some(TENDER), Some(WARSHIP)];
+
+/// `PROOF_STATION` runs the test-only station rows alone, so the 91 real
+/// content rows stay as recorded.
+fn partners() -> Vec<Option<&'static str>> {
+    if std::env::var("PROOF_STATION").is_ok() {
+        vec![Some(STATION)]
+    } else {
+        PARTNERS.to_vec()
+    }
+}
+
+fn table(report: bool) -> BTreeMap<String, Row> {
+    let cases = [
+        Case::Step(Vec3::Y, "yaw90"),
+        Case::Step(Vec3::X, "pitch90"),
+        Case::Step(Vec3::Z, "roll90"),
+        Case::BurnAll,
+        Case::BurnBalanced,
+        Case::Authority,
+        Case::Redock,
+    ];
+    let mut rows = BTreeMap::new();
+    for (case_index, case) in cases.into_iter().enumerate() {
+        for (partner_index, partner) in partners().into_iter().enumerate() {
+            let modes: &[Mode] = if partner.is_none() {
+                &[Mode::Base]
+            } else {
+                &[Mode::Base, Mode::Comp, Mode::SplitW, Mode::Rigid]
+            };
+            for (mode_index, &mode) in modes.iter().enumerate() {
+                let key = format!(
+                    "{case_index}{partner_index}{mode_index} {:>8} {:>18} {:>6}",
+                    case.label(),
+                    partner.unwrap_or("undocked"),
+                    mode.label()
+                );
+                let row = run(partner, case, mode, report && case_index == 3);
+                eprintln!("{key} done");
+                rows.insert(key, row);
+            }
+        }
+    }
+    rows
+}
+
+fn print(rows: &BTreeMap<String, Row>) {
+    println!(
+        "{:>3} {:>8} {:>18} {:>6} {:>6} {:>21} {:>21} {:>6} {:>7} {:>6} {:>7} {:>4} {:>6} {:>6} {:>7} {:>7} {:>7} {:>7} {:>7} {:>7} {:>6} {:>5}",
+        "key", "case", "partner", "mode", "m2/m1", "I1 diag x/y/z", "Iasm diag x/y/z",
+        "budget", "err deg", "off deg", "settle", "rng", "peakT", "sat s", "joint m",
+        "joint d", "jw max", "tail w", "tail er", "tail jw", "arm m", "alive"
+    );
+    for (key, row) in rows {
+        println!(
+            "{key} {:>6.3} {:>6.0}/{:>6.0}/{:>6.0} {:>6.0}/{:>6.0}/{:>6.0} {:>6.3} {:>7.2} {:>6.2} {:>7.2} {:>4} {:>6.3} {:>6.2} {:>7.3} {:>7.3} {:>7.4} {:>7.4} {:>7.3} {:>7.4} {:>6.2} {:>5}",
+            row.mass_ratio,
+            row.player_inertia.x,
+            row.player_inertia.y,
+            row.player_inertia.z,
+            row.assembly_inertia.x,
+            row.assembly_inertia.y,
+            row.assembly_inertia.z,
+            row.budget,
+            row.error,
+            row.off_axis,
+            row.settle,
+            row.reversals,
+            row.peak_torque,
+            row.saturated,
+            row.joint_m,
+            row.joint_deg,
+            row.max_joint_rate,
+            row.tail_rate,
+            row.tail_error,
+            row.tail_joint_rate,
+            row.burn_arm_m,
+            row.joint_alive,
+        );
+    }
+    println!("transition rows (auth: neutral 2-12 s; redock: release 20 s, re-dock 22 s)");
+    println!(
+        "{:>3} {:>8} {:>18} {:>6} {:>9} {:>8} {:>8} {:>8} {:>8} {:>9} {:>9}",
+        "key", "case", "partner", "mode", "neut deg", "neut dL", "redock", "re m", "re deg",
+        "after s", "after er"
+    );
+    for (key, row) in rows
+        .iter()
+        .filter(|(key, _)| key.contains(" auth ") || key.contains(" redock "))
+    {
+        println!(
+            "{key} {:>9.2} {:>8.4} {:>8} {:>8.3} {:>8.3} {:>9.2} {:>9.3}",
+            row.neutral_turn_deg,
+            row.neutral_dl,
+            row.redocked,
+            row.redock_m,
+            row.redock_deg,
+            row.after_settle,
+            row.after_error
+        );
+    }
+}
