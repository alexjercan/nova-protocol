+use crate::prelude::*;
+
+const WARSHIP: &str = "block_line_warship";
+const TENDER: &str = "block_frame_tender";
+const WORKSHIP: &str = "block_workship";
+/// TEST-ONLY station: never shipped, never in the catalog. A dynamic ship of
+/// real `reinforced_hull_section` cells with one real docking port.
+const STATION: &str = "temporary_test_station";
+const STATION_CELLS: IVec3 = IVec3::new(16, 10, 24);
+const PLAYER_COLLAR: &str = "starboard_collar";
+const PARTNER_COLLAR: &str = "port_collar";
+/// Face-to-face gap at capture, cells. Inside the 1-cell capture distance;
+/// 0.1 put a workship collider into the warship before the dock.
+fn gap() -> f32 {
+    std::env::var("PROOF_GAP").map_or(0.5, |gap| gap.parse().unwrap())
+}
+const DT: f32 = 1.0 / 60.0;
+
+#[derive(Deserialize)]
+enum Entry {
+    Section(SectionConfig),
+    Ship(ShipDesignPrototype),
+}
+
+fn load(path: &str) -> Vec<Entry> {
+    let file = format!("{}/../../assets/base/{path}", env!("CARGO_MANIFEST_DIR"));
+    ron::from_str(&std::fs::read_to_string(&file).unwrap()).unwrap()
+}
+
+fn catalogs() -> (GameSections, GameShipDesigns) {
+    let sections = load("sections/base.content.ron")
+        .into_iter()
+        .filter_map(|entry| match entry {
+            Entry::Section(section) => Some(section),
+            Entry::Ship(_) => None,
+        })
+        .collect();
+    let ships = load("ships/base.content.ron")
+        .into_iter()
+        .filter_map(|entry| match entry {
+            Entry::Ship(ship) => Some(ship),
+            Entry::Section(_) => None,
+        })
+        .collect();
+    (GameSections(sections), GameShipDesigns(ships))
+}
+
+/// Solid box of real hull cells, x in `0..16`, collar at `(-1, 0, 0)` with its
+/// hatch on `-X`, like the catalog's port flank collars.
+fn station_design() -> ShipDesignPrototype {
+    let mut sections = Vec::new();
+    for x in 0..STATION_CELLS.x {
+        for y in 0..STATION_CELLS.y {
+            for z in 0..STATION_CELLS.z {
+                let cell = IVec3::new(x, y - STATION_CELLS.y / 2, z - STATION_CELLS.z / 2);
+                sections.push(SpaceshipSectionConfig {
+                    id: format!("hull_{}_{}_{}", cell.x, cell.y, cell.z),
+                    position: cell.as_vec3(),
+                    rotation: Quat::IDENTITY,
+                    source: SectionSource::prototype(REINFORCED_HULL_SECTION_ID),
+                });
+            }
+        }
+    }
+    sections.push(SpaceshipSectionConfig {
+        id: PARTNER_COLLAR.to_string(),
+        position: Vec3::new(-1.0, 0.0, 0.0),
+        rotation: Quat::from_rotation_y(std::f32::consts::FRAC_PI_2),
+        source: SectionSource::prototype(DOCKING_PORT_SECTION_ID),
+    });
+    ShipDesignPrototype {
+        id: STATION.into(),
+        name: "TEST-ONLY station".to_string(),
+        design: ShipDesign {
+            sections,
+            ..default()
+        },
+    }
+}
+
+/// Player helm target, one per flown root.
+#[derive(Component, Clone, Copy)]
+struct Helm(Quat);
+
+/// The shipped command path of the stacking rig: `ship_turn_rate` then
+/// `slew_rotation`. A root in neutral (`DockedShip`) parks on its attitude.
+fn slew_helm(
+    time: Res<Time>,
+    settings: Res<FlightSettings>,
+    q_ship: Query<(Entity, &Helm, &Rotation, Has<DockedShip>)>,
+    mut q_command: Query<
+        (&mut ControllerSectionRotationInput, &ChildOf),
+        With<ControllerSectionMarker>,
+    >,
+    q_computer: Query<
+        (&PDController, &ChildOf),
+        (
+            With<ControllerSectionMarker>,
+            Without<SectionInactiveMarker>,
+        ),
+    >,
+) {
+    for (ship, helm, rotation, neutral) in &q_ship {
+        let Some(turn_rate) = ship_turn_rate(
+            q_computer
+                .iter()
+                .filter(|(_, &ChildOf(parent))| parent == ship)
+                .map(|(pd, _)| pd.max_angular_acceleration),
+            &settings,
+        ) else {
+            continue;
+        };
+        let max_step = turn_rate * time.delta_secs();
+        for (mut command, _) in q_command
+            .iter_mut()
+            .filter(|(_, &ChildOf(parent))| parent == ship)
+        {
+            **command = if neutral {
+                rotation.0
+            } else {
+                slew_rotation(**command, helm.0, max_step)
+            };
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+struct SplitPart {
+    entity: Entity,
+    mass: f32,
+    offset: Vec3,
+    own: Mat3,
+    about_assembly: Mat3,
+}
+
+/// `splitW`: each root gets `I_own * a` plus `m * (a x r)` at its centre of
+/// mass, with `a = Iasm^-1 * tau`. Skipped while the player is neutral, the
+/// same gate `sync_controller_section_forces` uses.
+#[derive(Component, Clone, Copy)]
+struct TemporarySplit {
+    parts: [SplitPart; 2],
+    inverse_assembly: Mat3,
+}
+
+fn split_helm_torque(
+    q_split: Query<(Entity, &TemporarySplit, &Rotation), Without<DockedShip>>,
+    q_output: Query<(&PDControllerOutput, &PDControllerTarget)>,
+    mut q_forces: Query<Forces>,
+) {
+    for (ship, split, rotation) in &q_split {
+        let commanded = q_output
+            .iter()
+            .filter(|(_, target)| ***target == ship)
+            .map(|(output, _)| output.0)
+            .sum::<Vec3>();
+        let r0 = rotation.0;
+        let alpha = split.inverse_assembly * (r0.inverse() * commanded);
+        for (index, part) in split.parts.iter().enumerate() {
+            let mut torque = r0 * (part.own * alpha);
+            // `sync_controller_section_forces` already put all of it on the
+            // player root.
+            if index == 0 {
+                torque -= commanded;
+            }
+            let mut forces = q_forces.get_mut(part.entity).unwrap();
+            forces.apply_torque(torque);
+            forces.apply_force(r0 * (alpha.cross(part.offset) * part.mass));
+        }
+    }
+}
+
+fn app() -> App {
+    let mut app = unfinished_integrity_physics_app();
+    app.add_plugins((
+        PDControllerPlugin,
+        SpaceshipSectionPlugin { render: false },
+        SpaceshipPlugin,
+    ));
+    app.init_resource::<FlightSettings>();
+    let (sections, mut ships) = catalogs();
+    ships.0.push(station_design());
+    app.insert_resource(sections);
+    app.insert_resource(ships);
+    app.add_systems(
+        FixedUpdate,
+        (
+            slew_helm
+                .after(DockingSystems::Release)
+                .before(ControllerSectionSystems::SyncRotationInput),
+            split_helm_torque.after(SpaceshipSectionSystems),
+        ),
+    );
+    app.finish();
+    app
+}
+
+fn resolved(app: &App, id: &str) -> ResolvedShipDesign {
+    let (design, errors) = resolve_ship_design(
+        &ShipDesignSource::prototype(id),
+        app.world().resource::<GameShipDesigns>(),
+        app.world().resource::<GameSections>(),
+    );
+    assert!(errors.is_empty(), "{id}: {errors:?}");
+    design
+}
