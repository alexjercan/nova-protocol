+fn collar(design: &ResolvedShipDesign, id: &str) -> Vec3 {
+    design
+        .sections
+        .iter()
+        .find(|section| section.id == id)
+        .unwrap_or_else(|| panic!("no '{id}'"))
+        .position
+}
+
+/// Partner root offset from the player root, both unrotated: the partner's
+/// port collar one cell plus `gap()` outboard of the player's starboard collar.
+fn partner_offset(app: &App, partner: &str) -> Vec3 {
+    let player = resolved(app, WARSHIP);
+    let partner = resolved(app, partner);
+    collar(&player, PLAYER_COLLAR) + Vec3::X * (1.0 + gap()) - collar(&partner, PARTNER_COLLAR)
+}
+
+fn spawn_ship(app: &mut App, design: ShipDesignSource, at: Vec3) -> Entity {
+    app.world_mut()
+        .spawn((
+            Transform::from_translation(at),
+            spaceship_scenario_object(SpaceshipConfig {
+                design,
+                controller: SpaceshipController::None,
+                allegiance: None,
+                capabilities: default(),
+            }),
+        ))
+        .id()
+}
+
+fn children_count(app: &App, root: Entity) -> usize {
+    app.world()
+        .get::<Children>(root)
+        .map_or(0, |children| children.len())
+}
+
+fn controllers(app: &mut App, root: Entity) -> (usize, f32) {
+    let mut query = app
+        .world_mut()
+        .query_filtered::<(&ChildOf, &ControllerSectionTuning), With<ControllerSectionMarker>>();
+    query
+        .iter(app.world())
+        .filter(|(parent, _)| parent.0 == root)
+        .fold((0, 0.0), |(count, torque), (_, tuning)| {
+            (count + 1, torque + tuning.max_torque)
+        })
+}
+
+/// Forward drives on `root`: entity, local push direction, local mount point.
+fn drives(app: &mut App, root: Entity) -> Vec<(Entity, Vec3, Vec3, f32)> {
+    let mut query = app.world_mut().query_filtered::<(
+        Entity,
+        &ChildOf,
+        &Transform,
+        &ThrusterSectionMagnitude,
+        &nova_events::EntityId,
+    ), With<ThrusterSectionMarker>>();
+    // A rigid reference burns only the player's own drives.
+    let mut drives: Vec<_> = query
+        .iter(app.world())
+        .filter(|(_, parent, .., id)| parent.0 == root && !id.0.starts_with("partner_"))
+        .map(|(entity, _, transform, magnitude, _)| {
+            (
+                entity,
+                transform.rotation * Vec3::NEG_Z,
+                transform.translation,
+                magnitude.0,
+            )
+        })
+        .collect();
+    drives.sort_by(|a, b| a.2.x.total_cmp(&b.2.x).then(a.2.z.total_cmp(&b.2.z)));
+    drives
+}
+
+/// Mass, tensors and offsets in the player frame, fixed at call time.
+fn assembly(app: &App, ship: Entity, body: Option<Entity>) -> (Mat3, Vec3, Vec<SplitPart>) {
+    let world = app.world();
+    let (p0, r0) = (
+        world.get::<Position>(ship).unwrap().0,
+        world.get::<Rotation>(ship).unwrap().0,
+    );
+    let parts: Vec<(f32, Vec3, Mat3, Entity)> = [Some(ship), body]
+        .into_iter()
+        .flatten()
+        .map(|entity| {
+            let mass = world.get::<ComputedMass>(entity).unwrap().value();
+            let rotation = world.get::<Rotation>(entity).unwrap().0;
+            let com = world.get::<Position>(entity).unwrap().0
+                + rotation * world.get::<ComputedCenterOfMass>(entity).unwrap().0;
+            let tensor = Mat3::from(
+                world
+                    .get::<ComputedAngularInertia>(entity)
+                    .unwrap()
+                    .rotated(r0.inverse() * rotation)
+                    .tensor(),
+            );
+            (mass, r0.inverse() * (com - p0), tensor, entity)
+        })
+        .collect();
+    let total: f32 = parts.iter().map(|part| part.0).sum();
+    let com = parts.iter().map(|part| part.1 * part.0).sum::<Vec3>() / total;
+    // Parallel axis written out: avian 0.7 `shifted_tensor` adds the outer
+    // product.
+    let split: Vec<SplitPart> = parts
+        .iter()
+        .map(|&(mass, at, own, entity)| {
+            let offset = at - com;
+            let outer = Mat3::from_cols(offset * offset.x, offset * offset.y, offset * offset.z);
+            SplitPart {
+                entity,
+                mass,
+                offset,
+                own,
+                about_assembly: own
+                    + (Mat3::from_diagonal(Vec3::splat(offset.length_squared())) - outer) * mass,
+            }
+        })
+        .collect();
+    let tensor = split
+        .iter()
+        .fold(Mat3::ZERO, |sum, part| sum + part.about_assembly);
+    (tensor, com, split)
+}
+
+fn angular_momentum(app: &App, bodies: &[Entity]) -> Vec3 {
+    let world = app.world();
+    let parts: Vec<(f32, Vec3, Vec3, Vec3)> = bodies
+        .iter()
+        .map(|&entity| {
+            let mass = world.get::<ComputedMass>(entity).unwrap().value();
+            let rotation = world.get::<Rotation>(entity).unwrap().0;
+            let com = world.get::<Position>(entity).unwrap().0
+                + rotation * world.get::<ComputedCenterOfMass>(entity).unwrap().0;
+            let tensor = Mat3::from(
+                world
+                    .get::<ComputedAngularInertia>(entity)
+                    .unwrap()
+                    .rotated(rotation)
+                    .tensor(),
+            );
+            let spin = tensor * world.get::<AngularVelocity>(entity).unwrap().0;
+            (
+                mass,
+                com,
+                world.get::<LinearVelocity>(entity).unwrap().0,
+                spin,
+            )
+        })
+        .collect();
+    let total: f32 = parts.iter().map(|part| part.0).sum();
+    let com = parts.iter().map(|part| part.1 * part.0).sum::<Vec3>() / total;
+    let velocity = parts.iter().map(|part| part.2 * part.0).sum::<Vec3>() / total;
+    parts
+        .iter()
+        .map(|(mass, at, v, spin)| *spin + (*at - com).cross(*v - velocity) * *mass)
+        .sum()
+}
+
+fn relative(app: &App, ship: Entity, body: Entity) -> (Vec3, Quat) {
+    let world = app.world();
+    let (p0, r0) = (
+        world.get::<Position>(ship).unwrap().0,
+        world.get::<Rotation>(ship).unwrap().0,
+    );
+    let (p1, r1) = (
+        world.get::<Position>(body).unwrap().0,
+        world.get::<Rotation>(body).unwrap().0,
+    );
+    (r0.inverse() * (p1 - p0), r0.inverse() * r1)
+}
+
+/// Signed residual along the command axis (positive = past the target) and
+/// the off-axis residual, both radians.
+fn residual(rotation: Quat, target: Quat, axis: Vec3) -> (f32, f32) {
+    let mut error = target.inverse() * rotation;
+    if error.w < 0.0 {
+        error = -error;
+    }
+    let scaled = error.to_scaled_axis();
+    let along = scaled.dot(axis);
+    (along, (scaled - axis * along).length())
+}
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+enum Case {
+    Step(Vec3, &'static str),
+    /// All forward drives at full for 3 s.
+    BurnAll,
+    /// The forward-drive subset whose thrust line passes nearest the assembly
+    /// centre of mass, for 3 s.
+    BurnBalanced,
+    /// Yaw 45 deg; neutral at 2 s mid-slew for 10 s; resume.
+    Authority,
+    /// Yaw 90 deg; release at 20 s; re-dock at 22 s; yaw back to 0.
+    Redock,
+}
+
+impl Case {
+    fn label(self) -> &'static str {
+        match self {
+            Self::Step(_, label) => label,
+            Self::BurnAll => "burn-all",
+            Self::BurnBalanced => "burn-bal",
+            Self::Authority => "auth",
+            Self::Redock => "redock",
+        }
+    }
+
+    fn seconds(self) -> f32 {
+        match self {
+            Self::Step(..) => 40.0,
+            Self::BurnAll | Self::BurnBalanced => 30.0,
+            Self::Authority => 40.0,
+            Self::Redock => 50.0,
+        }
+    }
+}
