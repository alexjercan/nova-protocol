+#[test]
+#[ignore = "TEMPORARY docked helm proof, run by hand"]
+fn temporary_docked_helm_real_content_table() {
+    let only = std::env::var("PROOF_ONLY").ok();
+    if let Some(only) = only {
+        // One quick row for smoke and timing: "<case> <partner> <mode>".
+        let parts: Vec<&str> = only.split(' ').collect();
+        let case = match parts[0] {
+            "yaw90" => Case::Step(Vec3::Y, "yaw90"),
+            "pitch90" => Case::Step(Vec3::X, "pitch90"),
+            "roll90" => Case::Step(Vec3::Z, "roll90"),
+            "burn-all" => Case::BurnAll,
+            "burn-bal" => Case::BurnBalanced,
+            "auth" => Case::Authority,
+            _ => Case::Redock,
+        };
+        let partner = [None, Some(WORKSHIP), Some(TENDER), Some(WARSHIP), Some(STATION)]
+            .into_iter()
+            .find(|partner| partner.unwrap_or("undocked") == parts[1])
+            .unwrap();
+        let mode = [Mode::Base, Mode::Comp, Mode::SplitW, Mode::Rigid]
+            .into_iter()
+            .find(|mode| mode.label() == parts[2])
+            .unwrap();
+        let row = run(partner, case, mode, true);
+        let mut rows = BTreeMap::new();
+        rows.insert(format!("000 {only}"), row);
+        print(&rows);
+        return;
+    }
+    let first = table(true);
+    print(&first);
+    if std::env::var("PROOF_REPEAT").is_ok() {
+        let second = table(false);
+        assert_eq!(first, second, "repeat run must match bit for bit");
+        println!("repeat: identical ({} rows)", second.len());
+    }
+}
