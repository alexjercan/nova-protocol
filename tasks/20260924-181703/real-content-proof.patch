+//! TEMPORARY(docked-helm-mass-proof): owner-approved disposable proof of the
+//! player-commanded `splitW` helm split on REAL catalog ships. Delete this
+//! file, its `mod` line, `TemporaryAssemblyInertia` and the widened helm
+//! functions after the owner reads the tables.
+
+use std::collections::BTreeMap;
+
+use avian3d::prelude::*;
+use bevy::prelude::*;
+use nova_gameplay::{
+    prelude::*,
+    test_support::{settle, unfinished_integrity_physics_app},
+};
+use nova_ship::{
+    flight::{ship_turn_rate, slew_rotation},
+    prelude::*,
+    sections::controller_section::TemporaryAssemblyInertia,
+};
+use serde::Deserialize;
