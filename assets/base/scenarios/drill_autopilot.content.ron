[
    Scenario((
        id: "drill_autopilot",
        name: "Autopilot practice",
        description: "Use GOTO and ORBIT to fly out to a planetoid and back.",
        cubemap: "self://textures/cubemap.png",
        role: Lesson,
        events: [
            (
                name: OnStart,
                once: true,
                actions: [
                    SpawnScenarioObject((
                        base: (
                            id: "trainer",
                            name: "Your ship",
                            position: (
                                0.0,
                                0.0,
                                0.0,
                            ),
                            rotation: (
                                0.0,
                                0.0,
                                0.0,
                                1.0,
                            ),
                        ),
                        kind: Spaceship((
                            design: Prototype(
                                id: "block_picket",
                                section_patches: {
                                    "bridge": (
                                        config: (
                                            health: Some(1300.0),
                                        ),
                                    ),
                                    "pdc": (
                                        config: (
                                            health: Some(1300.0),
                                        ),
                                    ),
                                },
                            ),
                            controller: Player((
                                input_mapping: {
                                    "pdc": [
                                        Mouse(Left),
                                        Gamepad(RightTrigger2),
                                    ],
                                },
                                speed_cap: Some(150.0),
                            )),
                            capabilities: (
                                stop_enabled: false,
                            ),
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "drill_autopilot_key",
                            name: "Key Light",
                            position: (
                                -1500.0,
                                1250.0,
                                -500.0,
                            ),
                            rotation: (
                                -0.24307884,
                                -0.36920026,
                                -0.10068656,
                                0.8913283,
                            ),
                        ),
                        kind: Light(Directional(
                            illuminance: 11000.0,
                            color: Srgba((
                                red: 1.0,
                                green: 0.96,
                                blue: 0.9,
                                alpha: 1.0,
                            )),
                            shadows: true,
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "drill_autopilot_rim",
                            name: "Rim Light",
                            position: (
                                750.0,
                                1000.0,
                                -4000.0,
                            ),
                            rotation: (
                                -0.03875094,
                                0.9604674,
                                0.21369855,
                                0.17416595,
                            ),
                        ),
                        kind: Light(Directional(
                            illuminance: 16000.0,
                            color: Srgba((
                                red: 0.72,
                                green: 0.86,
                                blue: 1.0,
                                alpha: 1.0,
                            )),
                            shadows: false,
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "drill_autopilot_fill",
                            name: "Fill Light",
                            position: (
                                1750.0,
                                -500.0,
                                -1000.0,
                            ),
                            rotation: (
                                0.10489727,
                                0.49822173,
                                -0.060874246,
                                0.8585255,
                            ),
                        ),
                        kind: Light(Directional(
                            illuminance: 2600.0,
                            color: Srgba((
                                red: 0.62,
                                green: 0.72,
                                blue: 0.95,
                                alpha: 1.0,
                            )),
                            shadows: false,
                        )),
                    )),
                    ScatterObjects((
                        id_prefix: "shallow_rock_",
                        count: 30,
                        seed: 433757351519980343,
                        region: Box(
                            min: (
                                700.0,
                                -500.0,
                                -4400.0,
                            ),
                            max: (
                                4300.0,
                                500.0,
                                -400.0,
                            ),
                        ),
                        template: (
                            base: (
                                id: "shallow_rock_",
                                name: "Shallow Belt Rock",
                                position: (
                                    0.0,
                                    0.0,
                                    0.0,
                                ),
                                rotation: (
                                    0.0,
                                    0.0,
                                    0.0,
                                    1.0,
                                ),
                            ),
                            kind: Asteroid((
                                radius: 10.0,
                                texture: "self://textures/asteroid.png",
                                kind: "rock",
                                destroy_sound: Some("self://sounds/destroy_rock.wav"),
                                invulnerable: false,
                            )),
                        ),
                        asteroid_radius: Some((
                            10.0,
                            30.0,
                        )),
                        asteroid_kinds: [
                            (
                                "rock",
                                10,
                            ),
                            (
                                "carbon",
                                3,
                            ),
                            (
                                "ice",
                                2,
                            ),
                            (
                                "metal",
                                1,
                            ),
                        ],
                        min_separation: Some(450.0),
                    )),
                    ScatterObjects((
                        id_prefix: "deep_rock_",
                        count: 34,
                        seed: 433757353748728849,
                        region: Box(
                            min: (
                                -2800.0,
                                -600.0,
                                -8400.0,
                            ),
                            max: (
                                3000.0,
                                600.0,
                                -5400.0,
                            ),
                        ),
                        template: (
                            base: (
                                id: "deep_rock_",
                                name: "Deep Belt Rock",
                                position: (
                                    0.0,
                                    0.0,
                                    0.0,
                                ),
                                rotation: (
                                    0.0,
                                    0.0,
                                    0.0,
                                    1.0,
                                ),
                            ),
                            kind: Asteroid((
                                radius: 15.0,
                                texture: "self://textures/asteroid.png",
                                kind: "rock",
                                destroy_sound: Some("self://sounds/destroy_rock.wav"),
                                invulnerable: false,
                            )),
                        ),
                        asteroid_radius: Some((
                            15.0,
                            40.0,
                        )),
                        asteroid_kinds: [
                            (
                                "rock",
                                10,
                            ),
                            (
                                "carbon",
                                3,
                            ),
                            (
                                "ice",
                                2,
                            ),
                            (
                                "metal",
                                1,
                            ),
                        ],
                        min_separation: Some(550.0),
                    )),
                    CreateScenarioArea((
                        id: "range_boundary",
                        name: "Range Boundary",
                        position: (
                            0.0,
                            0.0,
                            -2500.0,
                        ),
                        rotation: (
                            0.0,
                            0.0,
                            0.0,
                            1.0,
                        ),
                        radius: 7000.0,
                    )),
                    VariableSet((
                        key: "beat",
                        expression: Term(Factor(Literal(Number(1.0)))),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "range_planetoid",
                            name: "Range Planetoid",
                            position: (
                                -5600.0,
                                -1100.0,
                                -3800.0,
                            ),
                            rotation: (
                                0.0,
                                0.0,
                                0.0,
                                1.0,
                            ),
                        ),
                        kind: Planet((
                            radius: 600.0,
                            planet_type: BarrenRock,
                            seed: 20260815,
                            mass: Some(10000.0),
                            invulnerable: true,
                        )),
                    )),
                    ObjectiveMarkerAttach((
                        target_id: "range_planetoid",
                        label: "PLANETOID",
                    )),
                    Objective((
                        id: "out",
                        message: "Use GOTO to reach the planetoid.",
                    )),
                    HintEmphasisSet((
                        verb: "RADAR",
                    )),
                    NarrativeCue((
                        speaker: "Training",
                        text: "Keep your weapons lowered for this flight. Hold radar on the planetoid until the white travel lock takes. The flight computer only flies to a white lock.",
                    )),
                ],
            ),
            (
                name: OnCombatLockStart,
                once: true,
                filters: [
                    Entity((
                        id: Some("range_planetoid"),
                        other_id: Some("trainer"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(1.0)))),
                    ))),
                ],
                actions: [
                    NarrativeCue((
                        speaker: "Training",
                        text: "That red lock is the weapon lock. Lower your weapons and take the lock again. The flight computer will not fly to a red lock.",
                    )),
                ],
            ),
            (
                name: OnTravelLockStart,
                once: true,
                filters: [
                    Entity((
                        id: Some("range_planetoid"),
                        other_id: Some("trainer"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(1.0)))),
                    ))),
                ],
                actions: [
                    VariableSet((
                        key: "beat",
                        expression: Term(Factor(Literal(Number(2.0)))),
                    )),
                    HintEmphasisClear((
                        verb: "RADAR",
                    )),
                    HintEmphasisSet((
                        verb: "GOTO",
                    )),
                    NarrativeCue((
                        speaker: "Training",
                        text: "Travel lock set. Give the GOTO order and the flight computer flies the whole leg for you.",
                    )),
                ],
            ),
            (
                name: OnGotoComplete,
                once: true,
                filters: [
                    Entity((
                        id: Some("range_planetoid"),
                        other_id: Some("trainer"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(2.0)))),
                    ))),
                ],
                actions: [
                    ObjectiveComplete((
                        id: "out",
                    )),
                    VariableSet((
                        key: "beat",
                        expression: Term(Factor(Literal(Number(3.0)))),
                    )),
                    HintEmphasisClear((
                        verb: "GOTO",
                    )),
                    Objective((
                        id: "orbit",
                        message: "Use ORBIT to circle the planetoid.",
                    )),
                    HintEmphasisSet((
                        verb: "ORBIT",
                    )),
                    NarrativeCue((
                        speaker: "Training",
                        text: "You have arrived, and you are inside the planetoid\'s gravity. ORBIT settles the ship into a circle and holds it.",
                    )),
                ],
            ),
            (
                name: OnOrbitStable,
                once: true,
                filters: [
                    Entity((
                        id: Some("range_planetoid"),
                        other_id: Some("trainer"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(3.0)))),
                    ))),
                ],
                actions: [
                    ObjectiveComplete((
                        id: "orbit",
                    )),
                    VariableSet((
                        key: "beat",
                        expression: Term(Factor(Literal(Number(4.0)))),
                    )),
                    HintEmphasisClear((
                        verb: "ORBIT",
                    )),
                    ObjectiveMarkerDetach((
                        target_id: "range_planetoid",
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "mark_charlie",
                            name: "CHARLIE",
                            position: (
                                0.0,
                                0.0,
                                -1500.0,
                            ),
                            rotation: (
                                0.0,
                                0.0,
                                0.0,
                                1.0,
                            ),
                        ),
                        kind: Beacon((
                            label: "CHARLIE",
                            radius: 20.0,
                            color: Srgba((
                                red: 0.3,
                                green: 0.9,
                                blue: 1.0,
                                alpha: 1.0,
                            )),
                            area_radius: Some(700.0),
                        )),
                    )),
                    ObjectiveMarkerAttach((
                        target_id: "mark_charlie",
                        label: "CHARLIE",
                    )),
                    CreateScenarioArea((
                        id: "mark_charlie_gate",
                        name: "CHARLIE Gate",
                        position: (
                            0.0,
                            0.0,
                            -1500.0,
                        ),
                        rotation: (
                            0.0,
                            0.0,
                            0.0,
                            1.0,
                        ),
                        radius: 700.0,
                    )),
                    Objective((
                        id: "home",
                        message: "Use GOTO to reach mark CHARLIE.",
                    )),
                    HintEmphasisSet((
                        verb: "GOTO",
                    )),
                    NarrativeCue((
                        speaker: "Training",
                        text: "The orbit is stable. Mark CHARLIE next, then use GOTO to fly back to it.",
                    )),
                ],
            ),
            (
                name: OnEnter,
                once: true,
                filters: [
                    Entity((
                        id: Some("mark_charlie_gate"),
                        other_id: Some("trainer"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(4.0)))),
                    ))),
                ],
                actions: [
                    HintEmphasisClear((
                        verb: "GOTO",
                    )),
                    ObjectiveMarkerDetach((
                        target_id: "mark_charlie",
                    )),
                    DespawnScenarioObject((
                        id: "mark_charlie",
                    )),
                    DespawnScenarioObject((
                        id: "mark_charlie_gate",
                    )),
                    ObjectiveComplete((
                        id: "home",
                    )),
                    VariableSet((
                        key: "beat",
                        expression: Term(Factor(Literal(Number(90.0)))),
                    )),
                    NarrativeCue((
                        speaker: "Training",
                        text: "You are on mark CHARLIE. The flight computer flew the whole route, out and back.",
                    )),
                    Sequence((
                        key: "drill_outro",
                        steps: [
                            (
                                after: Some(3.0),
                                actions: [
                                    Outcome((
                                        outcome: Victory,
                                        message: Some("Autopilot practice complete."),
                                    )),
                                ],
                            ),
                        ],
                    )),
                ],
            ),
            (
                name: OnDestroyed,
                once: true,
                filters: [
                    Entity((
                        id: Some("trainer"),
                    )),
                    Expression((LessThan(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(90.0)))),
                    ))),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("Your ship was destroyed. Starting again."),
                    )),
                    NextScenario((
                        scenario_id: "drill_autopilot",
                        linger: true,
                    )),
                ],
            ),
            (
                name: OnNeutralized,
                once: true,
                filters: [
                    Entity((
                        id: Some("trainer"),
                    )),
                    Expression((LessThan(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(90.0)))),
                    ))),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("Your ship was destroyed. Starting again."),
                    )),
                    NextScenario((
                        scenario_id: "drill_autopilot",
                        linger: true,
                    )),
                ],
            ),
        ],
    )),
]
