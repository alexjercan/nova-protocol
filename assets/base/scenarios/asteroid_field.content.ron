            (
                name: OnStart,
                actions: [
                    Objective((
                        id: "break_ore_rock",
                        message: "Break apart the marked ore rock.",
                    )),
                    ObjectiveMarkerAttach((
                        target_id: "ore_rock",
                        label: "ORE ROCK",
                    )),
                    VariableSet((
                        key: "ore_broken",
                        expression: Term(Factor(Literal(Boolean(false)))),
                    )),
                ],
            ),
            (
                name: OnDestroyed,
                filters: [
                    Entity((
                        id: Some("player_spaceship"),
                    )),
                ],
                actions: [
                    DebugMessage((
                        message: "The player\'s spaceship was destroyed!",
                    )),
                    Outcome((
                        outcome: Defeat,
                        message: Some("Your ship is one more rock in the field."),
                    )),
                    NextScenario((
                        scenario_id: "asteroid_field",
                        linger: true,
                    )),
                ],
            ),
            (
                name: OnNeutralized,
                filters: [
                    Entity((
                        id: Some("player_spaceship"),
                    )),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("Nothing left to fight with - you drift dead in the belt."),
                    )),
                    NextScenario((
                        scenario_id: "asteroid_field",
                        linger: true,
                    )),
                ],
            ),
            (
                name: OnDestroyed,
                filters: [
                    Entity((
                        id: Some("ore_rock"),
                        type_name: Some("asteroid"),
                    )),
                ],
                actions: [
                    VariableSet((
                        key: "ore_broken",
                        expression: Term(Factor(Literal(Boolean(true)))),
                    )),
                    ObjectiveComplete((
                        id: "break_ore_rock",
                    )),
                    Objective((
                        id: "reach_zone",
                        message: "Reach the safe zone.",
                    )),
                ],
            ),
            (
                name: OnEnter,
                filters: [
                    Entity((
                        id: Some("asteroid_zone"),
                        other_id: Some("player_spaceship"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("ore_broken"))),
                        Term(Factor(Literal(Boolean(true)))),
                    ))),
                ],
                actions: [
                    ObjectiveComplete((
                        id: "reach_zone",
                    )),
                    Outcome((
                        outcome: Victory,
                        message: Some("Zone reached - the field is yours to run again."),
                    )),
                    NextScenario((
                        scenario_id: "asteroid_next",
                        linger: true,
                    )),
                ],
            ),
        ],
