[
    Scenario((
        id: "open_world",
        name: "Open World",
        description: "An open world generated from your seed: sparse asteroid clusters, planetoids and generated ships, streamed in around your ship as you fly.",
        cubemap: "self://textures/cubemap.png",
        world: Generated((
            seed: None,
            bounds: None,
        )),
        events: [
            (
                name: OnStart,
                once: true,
                actions: [
                    SpawnStartRole((
                        id: "player",
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "open_world_key",
                            name: "Key Light",
                            position: (
                                -1500.0,
                                1250.0,
                                1500.0,
                            ),
                            rotation: (
                                -0.24307884,
                                -0.36920026,
                                -0.10068656,
                                0.8913283,
                            ),
                        ),
                        kind: Light(Directional(
                            illuminance: 11000.0,
                            color: Srgba((
                                red: 1.0,
                                green: 0.96,
                                blue: 0.9,
                                alpha: 1.0,
                            )),
                            shadows: true,
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "open_world_rim",
                            name: "Rim Light",
                            position: (
                                750.0,
                                1000.0,
                                -2000.0,
                            ),
                            rotation: (
                                -0.03875094,
                                0.9604674,
                                0.21369855,
                                0.17416595,
                            ),
                        ),
                        kind: Light(Directional(
                            illuminance: 16000.0,
                            color: Srgba((
                                red: 0.72,
                                green: 0.86,
                                blue: 1.0,
                                alpha: 1.0,
                            )),
                            shadows: false,
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "open_world_fill",
                            name: "Fill Light",
                            position: (
                                1750.0,
                                -500.0,
                                1000.0,
                            ),
                            rotation: (
                                0.10489727,
                                0.49822173,
                                -0.060874246,
                                0.8585255,
                            ),
                        ),
                        kind: Light(Directional(
                            illuminance: 2600.0,
                            color: Srgba((
                                red: 0.62,
                                green: 0.72,
                                blue: 0.95,
                                alpha: 1.0,
                            )),
                            shadows: false,
                        )),
                    )),
                    Objective((
                        id: "take_a_job",
                        message: "Take a job",
                    )),
                    ObjectiveChipHold((
                        id: "take_a_job",
                    )),
                ],
            ),
            (
                name: OnResume,
                once: true,
                actions: [
                    SpawnStartRole((
                        id: "player",
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "open_world_key",
                            name: "Key Light",
                            position: (
                                -1500.0,
                                1250.0,
                                1500.0,
                            ),
                            rotation: (
                                -0.24307884,
                                -0.36920026,
                                -0.10068656,
                                0.8913283,
                            ),
                        ),
                        kind: Light(Directional(
                            illuminance: 11000.0,
                            color: Srgba((
                                red: 1.0,
                                green: 0.96,
                                blue: 0.9,
                                alpha: 1.0,
                            )),
                            shadows: true,
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "open_world_rim",
                            name: "Rim Light",
                            position: (
                                750.0,
                                1000.0,
                                -2000.0,
                            ),
                            rotation: (
                                -0.03875094,
                                0.9604674,
                                0.21369855,
                                0.17416595,
                            ),
                        ),
                        kind: Light(Directional(
                            illuminance: 16000.0,
                            color: Srgba((
                                red: 0.72,
                                green: 0.86,
                                blue: 1.0,
                                alpha: 1.0,
                            )),
                            shadows: false,
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "open_world_fill",
                            name: "Fill Light",
                            position: (
                                1750.0,
                                -500.0,
                                1000.0,
                            ),
                            rotation: (
                                0.10489727,
                                0.49822173,
                                -0.060874246,
                                0.8585255,
                            ),
                        ),
                        kind: Light(Directional(
                            illuminance: 2600.0,
                            color: Srgba((
                                red: 0.62,
                                green: 0.72,
                                blue: 0.95,
                                alpha: 1.0,
                            )),
                            shadows: false,
                        )),
                    )),
                    ObjectiveChipHold((
                        id: "take_a_job",
                    )),
                ],
            ),
            (
                name: OnDestroyed,
                once: true,
                filters: [
                    Entity((
                        id: Some("player"),
                    )),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("Your ship was destroyed."),
                    )),
                ],
            ),
            (
                name: OnJobAccepted,
                once: true,
                actions: [
                    ObjectiveComplete((
                        id: "take_a_job",
                    )),
                ],
            ),
            (
                name: OnJobDone,
                once: true,
                actions: [
                    NarrativeCue((
                        speaker: "Station Control",
                        text: "Work confirmed. Return to the station that posted the job and hand it in.",
                    )),
                ],
            ),
            (
                name: OnJobHandedIn,
                once: true,
                actions: [
                    GrantCredits((
                        ship: "player",
                        amount: 50,
                    )),
                    NarrativeCue((
                        speaker: "Station Control",
                        text: "First delivery logged. A 50 cr bonus is on your account. The board has more work.",
                    )),
                ],
            ),
            (
                name: OnJobDropped,
                once: true,
                filters: [
                    Expression((Equal(
                        Term(Factor(Event("cause"))),
                        Term(Factor(Literal(String("Lost")))),
                    ))),
                ],
                actions: [
                    NarrativeCue((
                        speaker: "Station Control",
                        text: "Contract void. The target of the job is lost. The board has other work.",
                    )),
                ],
            ),
        ],
    )),
]
