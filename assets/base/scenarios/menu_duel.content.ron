                ],
            ),
            (
                name: OnTimerEnd,
                filters: [
                    Timer((
                        key: "duel_finisher_beat",
                    )),
                ],
                actions: [
                    SetAllegiance((
                        id: "duel_finisher",
                        allegiance: Enemy,
                    )),
                    ForceTorpedoFire((
                        ship: "duel_finisher",
                        section: "siege_bay",
                        target: "duel_victor",
                    )),
                    TimerStart((
                        key: "duel_finisher_beat",
                        seconds: Term(Factor(Literal(Number(20.0)))),
                    )),
                ],
            ),
            (
                name: OnDefeated,
                filters: [
                    Entity((
                        id: Some("duel_victor"),
                    )),
                ],
                actions: [
                    TimerCancel((
                        key: "duel_finisher_beat",
                    )),
                    TimerStart((
                        key: "duel_reset",
                        seconds: Term(Factor(Literal(Number(8.0)))),
                    )),
                ],
            ),
            (
                name: OnTimerEnd,
                filters: [
                    Timer((
                        key: "duel_reset",
                    )),
                ],
                actions: [
