            (
                name: OnDefeated,
                filters: [
                    Entity((
                        id: Some("duel_rival"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("duel_decided"))),
                        Term(Factor(Literal(Number(0.0)))),
                    ))),
                ],
                actions: [
                    VariableSet((
                        key: "duel_decided",
                        expression: Term(Factor(Literal(Number(1.0)))),
                    )),
                    TimerStart((
                        key: "duel_finisher_beat",
                        seconds: Term(Factor(Literal(Number(4.0)))),
                    )),
                ],
            ),
            (
                name: OnExit,
                filters: [
                    Entity((
                        id: Some("duel_arena"),
                        other_id: Some("duel_rival"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("duel_decided"))),
                        Term(Factor(Literal(Number(0.0)))),
                    ))),
                ],
                actions: [
                    VariableSet((
                        key: "duel_decided",
                        expression: Term(Factor(Literal(Number(1.0)))),
                    )),
                    SetAllegiance((
                        id: "duel_rival",
                        allegiance: Neutral,
                    )),
                    TimerStart((
                        key: "duel_finisher_beat",
                        seconds: Term(Factor(Literal(Number(4.0)))),
                    )),
                ],
            ),
            (
                name: OnExit,
                filters: [
                    Entity((
                        id: Some("duel_arena"),
                        other_id: Some("duel_victor"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("duel_decided"))),
                        Term(Factor(Literal(Number(0.0)))),
                    ))),
                ],
                actions: [
                    VariableSet((
                        key: "duel_decided",
                        expression: Term(Factor(Literal(Number(1.0)))),
                    )),
                    SetAllegiance((
                        id: "duel_victor",
                        allegiance: Neutral,
                    )),
                    TimerStart((
                        key: "duel_reset",
                        seconds: Term(Factor(Literal(Number(8.0)))),
