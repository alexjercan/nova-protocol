                name: OnNeutralized,
                once: true,
                filters: [
                    Entity((
                        id: Some("player_spaceship"),
                    )),
                    Expression((LessThan(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(13.0)))),
                    ))),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("Nothing left to fight with - you drift derelict in the belt."),
                    )),
                    NextScenario((
                        scenario_id: "shakedown_run",
                        linger: true,
                    )),
                ],
            ),
        ],
    )),
]
