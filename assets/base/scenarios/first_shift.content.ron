                    )),
                    CinematicTitle((
                        corner: TopLeft,
                        location: "SECTOR M, THE RINGS OF SATURN",
                        date: "Y0",
                        note: "The EWI carrier Meridian: a refinery that moves to the ice.",
                        seconds: 9.0,
                    )),
                    Sequence((
                        key: "opening",
                        steps: [
                            (
                                after: Some(2.0),
                                actions: [
                                    NarrativeCue((
                                        channel: "comms",
                                        speaker: "Demir",
                                        text: "Cutter One, Meridian Control. Boat bay is clear. You are released.",
                                        icon: Some("self://portraits/meridian-control.png"),
                                    )),
                                ],
                            ),
                            (
                                after: Some(4.0),
                                actions: [
                                    NarrativeCue((
                                        channel: "comms",
                                        speaker: "Halloran",
                                        text: "Clamps are open. Drive and thrusters read green.",
                                        icon: Some("self://portraits/copilot.png"),
                                    )),
                                ],
                            ),
                            (
                                after: Some(6.0),
                                actions: [
                                    NarrativeCue((
                                        channel: "crew",
                                        speaker: "Okoro",
                                        text: "You stopped at the plaque again.",
                                        icon: Some("self://portraits/engineer.png"),
                                    )),
                                ],
                            ),
                            (
                                after: Some(3.0),
                                actions: [
                                    NarrativeCue((
                                        channel: "crew",
                                        speaker: "You",
                                        text: "I stop at it every shift.",
                                        icon: Some("self://portraits/player.png"),
                                    )),
                                ],
                            ),
                            (
                                after: Some(3.0),
                                actions: [
                                    NarrativeCue((
                                        channel: "crew",
                                        speaker: "Okoro",
                                        text: "Brandt taught him to fit boats. Then he taught me, same deck.",
                                        icon: Some("self://portraits/engineer.png"),
                                    )),
                                ],
                            ),
                            (
                                after: Some(4.0),
                                actions: [
                                    NarrativeCue((
                                        channel: "crew",
                                        speaker: "Halloran",
                                        text: "A banner the length of the bay, and one plaque under it. Nobody ever hangs those the other way round.",
                                        icon: Some("self://portraits/copilot.png"),
                                    )),
                                ],
                            ),
                            (
                                after: Some(6.0),
                                actions: [
                                    NarrativeCue((
                                        channel: "comms",
                                        speaker: "Brandt",
                                        text: "Cutter One, deck. You\'re flying a re-qualification card today - the yard had your port thrusters open.",
                                        icon: Some("self://portraits/deck-chief.png"),
                                    )),
                                ],
                            ),
                            (
                                after: Some(4.0),
                                actions: [
                                    NarrativeCue((
                                        channel: "comms",
                                        speaker: "Demir",
                                        text: "Work sheet after that: tag the hulls on Plate Seven, then pull the cache logged off the far side of the survey body.",
                                        icon: Some("self://portraits/meridian-control.png"),
                                    )),
                                ],
                            ),
                            (
                                after: Some(6.0),
                                actions: [
                                    NarrativeCue((
                                        channel: "comms",
                                        speaker: "You",
                                        text: "Cutter One copies. Card, two hulls, one cache.",
                                        icon: Some("self://portraits/player.png"),
                                    )),
                                ],
                            ),
                            (
                                after: Some(4.0),
                                actions: [
                                    NarrativeCue((
                                        channel: "comms",
                                        speaker: "Demir",
                                        text: "Correct. Meridian gets under way in fifty-six minutes. Don\'t make me come looking for you.",
                                        icon: Some("self://portraits/meridian-control.png"),
                                    )),
                                ],
                            ),
                            (
                                after: Some(6.0),
                                actions: [
                                    NarrativeCue((
                                        channel: "crew",
                                        speaker: "Halloran",
                                        text: "She says that like they\'d leave without us.",
                                        icon: Some("self://portraits/copilot.png"),
                                    )),
                                ],
                            ),
                            (
                                after: Some(2.0),
                                actions: [
                                    NarrativeCue((
                                        channel: "crew",
                                        speaker: "Okoro",
                                        text: "They\'d leave without you.",
                                        icon: Some("self://portraits/engineer.png"),
                                    )),
                                ],
                            ),
                            (
                                after: Some(2.0),
                                actions: [
                                    NarrativeCue((
                                        channel: "crew",
                                        speaker: "Halloran",
                                        text: "Cruel.",
                                        icon: Some("self://portraits/copilot.png"),
                                    )),
                                ],
                            ),
                            (
                                after: Some(2.0),
                                actions: [
                                    NarrativeCue((
