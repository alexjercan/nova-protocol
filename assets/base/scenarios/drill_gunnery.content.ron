                    )),
                    Objective((
                        id: "target",
                        message: "Destroy Target 1.",
                    )),
                    HintEmphasisSet((
                        verb: "RADAR",
                    )),
                    NarrativeCue((
                        speaker: "Training",
                        text: "Five unarmed targets are on the range, and none of them shoot back. Find Target 1 with the radar, raise your weapons, and destroy it.",
                    )),
                ],
            ),
            (
                name: OnTravelLockStart,
                once: true,
                filters: [
                    Entity((
                        id: Some("target_1"),
                        other_id: Some("trainer"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(1.0)))),
                    ))),
                ],
                actions: [
                    NarrativeCue((
                        speaker: "Training",
                        text: "That white lock is the travel lock and it does not feed the guns. Raise your weapons and take the lock again.",
                    )),
                ],
            ),
            (
                name: OnCombatLockStart,
                once: true,
                filters: [
                    Entity((
                        id: Some("target_1"),
                        other_id: Some("trainer"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(1.0)))),
                    ))),
                ],
                actions: [
                    VariableSet((
                        key: "beat",
                        expression: Term(Factor(Literal(Number(2.0)))),
                    )),
                    HintEmphasisClear((
                        verb: "RADAR",
                    )),
                    NarrativeCue((
                        speaker: "Training",
                        text: "That red lock is the weapon lock. Scroll the wheel to step the lock onto one section, such as a drive or a turret.",
                    )),
                ],
            ),
            (
                name: OnDestroyed,
                once: true,
                filters: [
                    Entity((
                        id: Some("target_1"),
                    )),
                    Expression((LessThan(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(90.0)))),
                    ))),
                ],
                actions: [
                    ObjectiveComplete((
                        id: "target",
                    )),
                    VariableSet((
                        key: "beat",
                        expression: Term(Factor(Literal(Number(90.0)))),
                    )),
                    NarrativeCue((
                        speaker: "Training",
                        text: "Target 1 is destroyed. The other four stay on the range, so you can come back and practise.",
                    )),
                    Sequence((
                        key: "drill_outro",
                        steps: [
                            (
                                after: Some(3.0),
                                actions: [
                                    Outcome((
                                        outcome: Victory,
                                        message: Some("Turret practice complete."),
                                    )),
                                ],
                            ),
                        ],
                    )),
                ],
            ),
            (
                name: OnDestroyed,
                once: true,
                filters: [
                    Entity((
                        id: Some("trainer"),
                    )),
                    Expression((LessThan(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(90.0)))),
                    ))),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("Your ship was destroyed. Starting again."),
                    )),
                    NextScenario((
                        scenario_id: "drill_gunnery",
                        linger: true,
                    )),
                ],
            ),
            (
                name: OnNeutralized,
                once: true,
                filters: [
                    Entity((
                        id: Some("trainer"),
                    )),
                    Expression((LessThan(
                        Term(Factor(Name("beat"))),
                        Term(Factor(Literal(Number(90.0)))),
                    ))),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("Your ship was destroyed. Starting again."),
                    )),
                    NextScenario((
                        scenario_id: "drill_gunnery",
                        linger: true,
                    )),
                ],
            ),
        ],
    )),
]
