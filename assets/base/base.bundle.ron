// The base game's own bundle - the base game is just a mod. `meta` is the mod's
// SELF-DESCRIPTION (the single source of truth for name/description/author/...,
// shown in the Mods menu); `version` stays empty for base because the GAME
// version is authoritative here.
(
    content: [
        "sections/base.content.ron",
        "styles/base.content.ron",
        // After the sections it is built from: a ship references section
        // prototypes by id, so the catalog it reads must merge first.
        "ships/base.content.ron",
        "campaigns/nova_protocol.content.ron",
        "scenarios/asteroid_field.content.ron",
        "scenarios/broadside.content.ron",
        "scenarios/broadside_gunship.content.ron",
        "scenarios/asteroid_next.content.ron",
        "scenarios/menu_waystation.content.ron",
        "scenarios/menu_gauntlet.content.ron",
        "scenarios/menu_weave.content.ron",
        "scenarios/menu_duel.content.ron",
        "scenarios/shakedown_run.content.ron",
        "scenarios/lifeline.content.ron",
        "scenarios/final_tally.content.ron",
    ],
    // The base game's own art, now shipped UNDER assets/base/ and referenced from
    // base content with `self://` (and by mods with `dep://base/<path>`). Every
    // `self://` ref in base content must name one of these (the content gate
    // enforces completeness; sidecar `.meta` files ride along and are not listed).
    resources: [
        "textures/cubemap.png",
        "textures/cubemap_alt.png",
        "textures/asteroid.png",
        "gltf/hull-01.glb",
        "gltf/turret-yaw-01.glb",
        "gltf/turret-pitch-01.glb",
        "gltf/turret-barrel-01.glb",
        "gltf/torpedo-bay-01.glb",
        // Semantic ship parts generated from the approved Kenney recipes.
        "gltf/parts/cargoa/engine_port.glb",
        "gltf/parts/cargoa/engine_starboard.glb",
        "gltf/parts/cargoa/fuselage.glb",
        "gltf/parts/cargoa/nose.glb",
        "gltf/parts/cargoa/pod_port.glb",
        "gltf/parts/cargoa/pod_starboard.glb",
        "gltf/parts/cargoa/tail.glb",
        "gltf/parts/cargob/engine_port.glb",
        "gltf/parts/cargob/engine_starboard.glb",
        "gltf/parts/cargob/fuselage.glb",
        "gltf/parts/cargob/nose.glb",
        "gltf/parts/cargob/pod_port.glb",
        "gltf/parts/cargob/pod_starboard.glb",
        "gltf/parts/cargob/tail.glb",
        "gltf/parts/racer/engine_port.glb",
        "gltf/parts/racer/engine_starboard.glb",
        "gltf/parts/racer/fuselage.glb",
        "gltf/parts/racer/nose.glb",
        "gltf/parts/racer/tail.glb",
        "gltf/parts/racer/wing_port.glb",
        "gltf/parts/racer/wing_starboard.glb",
        // Decoration fixtures for the derived skin, generated from the recipes
        // in `scripts/greeble-recipes/` by `scripts/gen-greebles.py`. Declared
        // here so a style can name one with `self://gltf/greebles/<id>.glb` and
        // a mod can reuse one with `dep://base/gltf/greebles/<id>.glb`. Each
        // prefix is one authored KIT worn by the style of that name; the
        // `placeholder_` four are the scaffolding that proved the pipeline.
        "gltf/greebles/armoured_cap.glb",
        "gltf/greebles/armoured_hatch.glb",
        "gltf/greebles/armoured_sensor.glb",
        "gltf/greebles/armoured_strake.glb",
        "gltf/greebles/civilian_beacon.glb",
        "gltf/greebles/civilian_fairing.glb",
        "gltf/greebles/civilian_fin.glb",
        "gltf/greebles/civilian_stripe.glb",
        "gltf/greebles/civilian_windows.glb",
        "gltf/greebles/industrial_duct.glb",
        "gltf/greebles/industrial_hatch.glb",
        "gltf/greebles/industrial_hazard_band.glb",
        "gltf/greebles/industrial_louvre.glb",
        "gltf/greebles/industrial_radiator.glb",
        "gltf/greebles/industrial_ribbing.glb",
        "gltf/greebles/industrial_stack.glb",
        "gltf/greebles/placeholder_blister.glb",
        "gltf/greebles/placeholder_block.glb",
        "gltf/greebles/placeholder_mast.glb",
        "gltf/greebles/placeholder_vent.glb",
        "gltf/greebles/salvage_drum.glb",
        "gltf/greebles/salvage_hook.glb",
        "gltf/greebles/salvage_patch_plate.glb",
        "gltf/greebles/salvage_patch_scab.glb",
        "gltf/greebles/salvage_patch_strip.glb",
        "gltf/greebles/salvage_weld_seam.glb",
        "gltf/greebles/salvage_whip.glb",
        // NOTE: the cladding shells ship no meshes. Every one of the 954
        // shapes is built at load from the eight boundary samples its id
        // spells - see `nova_ship`'s `shell_shape`. Art shipped here under a
        // shape's id would override its generated twin, which is how a tile
        // gets dressed.
        "banner.png",
        // One picker thumbnail per picker-visible base scenario, generated by
        // `scripts/gen-scenario-thumbnails.py` until real art lands at the same
        // paths (task 20260715-220011).
        "thumbnails/asteroid_field.png",
        "thumbnails/shakedown_run.png",
        "thumbnails/broadside.png",
        "thumbnails/broadside_gunship.png",
        "thumbnails/lifeline.png",
        "thumbnails/final_tally.png",
        // The base mod's WORLD sound effects (task 20260717-002228; ownership
        // split in spike 20260717-101524). Base content references
        // `turret_fire.wav` via `self://sounds/...` (the turret section's authorable
        // `fire_sound`); the rest are played by the game's cue observers (the
        // transitional WorldSfx bank) until their families migrate onto section/
        // object configs. Listed here so mods can reference any of them via
        // `dep://base/sounds/<name>.wav`. UI/interface sounds (menu clicks,
        // objective chimes) are engine chrome like `icons/` and live at the
        // asset root, NOT here.
        "sounds/dry_fire.wav",
        "sounds/explosion.wav",
        "sounds/impact.wav",
        "sounds/lock_off.wav",
        "sounds/lock_on.wav",
        "sounds/radar_deny.wav",
        "sounds/radar_retarget.wav",
        "sounds/rcs_loop.wav",
        "sounds/safety_on.wav",
        "sounds/salvage_pickup.wav",
        "sounds/thruster_loop.wav",
        "sounds/torpedo_launch.wav",
        "sounds/turret_fire.wav",
    ],
    meta: (
        name: "Base Game",
        description: "Nova Protocol - the core sections, ships and scenarios.",
        author: "Nova Protocol",
    ),
    // The New Game start. Honored ONLY from the base bundle; the merge warns
    // and ignores it on any other bundle (mods cannot redirect New Game).
    new_game_scenario: Some("shakedown_run"),
)
