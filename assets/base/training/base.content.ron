[
    Lesson((
        id: "start_welcome",
        category: StartHere,
        order: 10,
        title: "How training works",
        media: Image(
            image: "self://training/start_welcome.webp",
            alt: "the training screen with a lesson open",
        ),
        body: "Each lesson is one screen: a picture or a short loop, a few lines of text, and the controls it uses. Some lessons open a practice flight. Every lesson links to a longer page on the wiki.",
        wiki_path: "wiki/getting-started",
    )),
    Lesson((
        id: "start_hud",
        category: StartHere,
        order: 20,
        title: "Reading the HUD",
        media: Image(
            image: "self://training/start_hud.webp",
            alt: "the velocity sphere and speed readout drawn around a ship",
        ),
        body: "The HUD only shows what you need right now. Your speed and a velocity sphere sit around your ship. The sphere points the way you are actually moving, which is not always where the nose points.",
        actions: [
            "hud_cinematic",
        ],
        wiki_path: "wiki/hud",
        field_notes: [
            "The velocity sphere points the way you are moving. That is not always where the nose points.",
        ],
    )),
    Lesson((
        id: "start_camera",
        category: StartHere,
        order: 30,
        title: "Looking around",
        media: Loop(
            sheet: "self://training/start_camera.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the camera orbiting a stationary ship",
        ),
        body: "You can turn the camera without turning the ship. Use it to look around and find a contact before you choose a heading.",
        actions: [
            "camera_rotate",
            "free_look",
        ],
        wiki_path: "wiki/keybinds#targeting-and-camera",
        field_notes: [
            "The camera turns without turning the ship. Use it to look around first.",
        ],
    )),
    Lesson((
        id: "flight_aim",
        category: Flight,
        order: 10,
        title: "Turn, then thrust",
        media: Loop(
            sheet: "self://training/flight_aim.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a ship holding a heading with its main drive lit behind it",
        ),
        body: "The main drive only pushes in the direction the nose points. Turn to face where you want to go, then thrust. Thrust while you are still turning and you push yourself onto a heading you are leaving.",
        actions: [
            "main_drive",
        ],
        wiki_path: "wiki/flight-autopilot#manual-flight",
        practice: Some("drill_momentum"),
        proven_by: [
            "tutorial",
            "drill_momentum",
        ],
        field_notes: [
            "The drive only pushes where the nose points. Turn first, then thrust.",
        ],
    )),
    Lesson((
        id: "flight_momentum",
        category: Flight,
        order: 20,
        title: "You keep your speed",
        media: Loop(
            sheet: "self://training/flight_momentum.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "thrust released; the ship keeps its speed and heading",
        ),
        body: "Releasing the drive does not slow you down. Nothing in space does. You keep your current speed and heading until something pushes you the other way.",
        actions: [
            "main_drive",
        ],
        wiki_path: "wiki/flight-autopilot#manual-flight",
        practice: Some("drill_momentum"),
        proven_by: [
            "drill_momentum",
        ],
        field_notes: [
            "Nothing slows you down in space. Release the drive and your speed stays the same.",
        ],
    )),
    Lesson((
        id: "flight_stop",
        category: Flight,
        order: 30,
        title: "The STOP order",
        media: Loop(
            sheet: "self://training/flight_stop.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the flight computer turning the ship around and slowing it to zero",
        ),
        body: "STOP hands the ship to the flight computer. The computer turns the ship around and thrusts until your speed reads zero. That takes time and distance, so start it early.",
        actions: [
            "autopilot_stop",
        ],
        wiki_path: "wiki/flight-autopilot#the-autopilot-flies-the-hull",
        practice: Some("drill_stop"),
        proven_by: [
            "tutorial",
            "drill_stop",
        ],
        field_notes: [
            "STOP is not instant. The flight computer thrusts until your speed reads zero.",
        ],
    )),
    Lesson((
        id: "flight_rcs",
        category: Flight,
        order: 40,
        title: "Using the RCS thrusters",
        media: Loop(
            sheet: "self://training/flight_rcs.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "small thruster bursts moving a ship onto a mark",
        ),
        body: "Hold the RCS modifier and the mouse drives the small thrusters. They move the ship sideways without turning it. Use them for small corrections the main drive would overshoot.",
        actions: [
            "rcs_modifier",
            "rcs_aim",
        ],
        wiki_path: "wiki/flight-autopilot#rcs-fine-docking-thrusters",
        practice: Some("drill_stop"),
        proven_by: [
            "tutorial",
            "drill_stop",
        ],
    )),
    Lesson((
        id: "flight_goto",
        category: Flight,
        order: 50,
        title: "GOTO a mark",
        media: Loop(
            sheet: "self://training/flight_goto.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a ship turning towards a marked contact and flying to it",
        ),
        body: "GOTO flies the ship to your current mark and stops there. Mark a contact with the radar first, then give the order. Use it for long transits.",
        actions: [
            "autopilot_goto",
        ],
        wiki_path: "wiki/flight-autopilot#the-autopilot-flies-the-hull",
        practice: Some("drill_autopilot"),
        proven_by: [
            "tutorial",
            "drill_autopilot",
        ],
        field_notes: [
            "GOTO flies to your mark and stops there. Use it for long transits.",
        ],
    )),
    Lesson((
        id: "flight_orbit",
        category: Flight,
        order: 60,
        title: "ORBIT a mark",
        media: Loop(
            sheet: "self://training/flight_orbit.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a ship settling into a circle around a planetoid",
        ),
        body: "ORBIT flies a circle around your mark and holds it. It keeps the target in view while you do something else. Taking the controls back turns the flight computer off.",
        actions: [
            "autopilot_orbit",
            "autopilot_off",
        ],
        wiki_path: "wiki/gravity-wells#the-dominant-well",
        practice: Some("drill_autopilot"),
        proven_by: [
            "tutorial",
            "drill_autopilot",
        ],
        field_notes: [
            "Taking the controls back turns the flight computer off.",
        ],
    )),
    Lesson((
        id: "combat_radar",
        category: Combat,
        order: 10,
        title: "Using the radar",
        media: Loop(
            sheet: "self://training/combat_radar.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the radar marking a contact ahead of the ship: the lock charges, then the bracket lands on it",
        ),
        body: "Hold radar to sweep for contacts and mark one. A tap clears the mark. Autopilot orders and weapon locks both work from the contact you mark here.",
        actions: [
            "radar_hold",
        ],
        wiki_path: "wiki/targeting-radar#holding-to-sweep",
        practice: Some("drill_gunnery"),
        proven_by: [
            "tutorial",
            "drill_gunnery",
        ],
    )),
    Lesson((
        id: "combat_stance",
        category: Combat,
        order: 20,
        title: "Raising weapons",
        media: Loop(
            sheet: "self://training/combat_stance.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "weapons coming up and the flight computer changing how it flies",
        ),
        body: "Raising weapons changes how the flight computer flies. Instead of taking the shortest line to your mark, it holds the nose where the guns can reach the target.",
        actions: [
            "combat_stance",
        ],
        wiki_path: "wiki/targeting-radar#stances-and-slots",
        practice: Some("drill_gunnery"),
        proven_by: [
            "tutorial",
            "drill_gunnery",
        ],
        field_notes: [
            "Raising weapons changes how the flight computer flies the ship.",
        ],
    )),
    Lesson((
        id: "combat_components",
        category: Combat,
        order: 30,
        title: "Lock a component",
        media: Loop(
            sheet: "self://training/combat_components.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the lock stepping from a whole ship to its drive, then its turret",
        ),
        body: "A lock can target one section instead of the whole ship. Step it onto the drive to stop the ship moving, or onto a turret to stop it shooting back.",
        actions: [
            "component_next",
            "component_prev",
        ],
        wiki_path: "wiki/targeting-radar#per-section-fine-lock",
        practice: Some("drill_gunnery"),
        proven_by: [
            "drill_gunnery",
        ],
        field_notes: [
            "A lock can target one section of a ship, such as its drive or a turret.",
        ],
    )),
    Lesson((
        id: "combat_turrets",
        category: Combat,
        order: 40,
        title: "Turret arcs",
        media: Image(
            image: "self://training/combat_turrets.webp",
            alt: "turret firing arcs drawn over a ship",
        ),
        body: "A turret only fires within its own arc. Your own ship blocks part of that arc, so a turret cannot shoot a target hidden behind your drive.",
        wiki_path: "wiki/sections/turret",
        proven_by: [
            "tutorial",
            "drill_gunnery",
        ],
        field_notes: [
            "A turret only fires within its arc. Your own ship blocks part of it.",
        ],
    )),
    Lesson((
        id: "combat_torpedoes",
        category: Combat,
        order: 50,
        title: "Torpedoes",
        media: Loop(
            sheet: "self://training/combat_torpedoes.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a torpedo dropping clear of a ship, then homing on a locked target",
        ),
        body: "A torpedo needs a combat lock. The bay drops it cold and the drive catches a moment later, then it steers itself onto the lock. It will not arm until it is well clear of you.",
        wiki_path: "wiki/sections/torpedo-bay",
        field_notes: [
            "A torpedo needs a combat lock, and it will not arm close to your ship.",
        ],
    )),
    Lesson((
        id: "build_sections",
        category: Shipbuilding,
        order: 10,
        title: "Ships are built from sections",
        media: Image(
            image: "self://training/build_sections.webp",
            alt: "the editor with one section selected on a frame",
        ),
        body: "Ships are built from sections bolted to a frame, and each section does one job. Every section you add costs mass, so nothing on a ship is there only for looks.",
        wiki_path: "wiki/sections#what-every-section-shares",
    )),
    Lesson((
        id: "build_mass",
        category: Shipbuilding,
        order: 20,
        title: "Mass and thrust",
        media: Image(
            image: "self://training/build_mass.webp",
            alt: "the same frame with a heavier loadout, its numbers beside it",
        ),
        body: "Every section you add is mass the drive has to move and stop. The same drive handles a light ship and a heavy ship very differently. The clearest sign is how long STOP takes.",
        wiki_path: "wiki/sections#what-every-section-shares",
        field_notes: [
            "Every section you add is mass the drive has to move and stop.",
        ],
    )),
    Lesson((
        id: "build_balance",
        category: Shipbuilding,
        order: 30,
        title: "Thruster placement",
        media: Image(
            image: "self://training/build_balance.webp",
            alt: "thrusters on a lopsided frame firing at different throttles",
        ),
        body: "Thrusters sit wherever you bolt them, so an off-centre burn would spin the ship. The flight computer sets each throttle to cancel that spin. A lopsided or damaged ship still flies straight, with less thrust.",
        wiki_path: "wiki/sections/thruster",
        field_notes: [
            "The flight computer balances your thrusters, so a lopsided ship still flies straight.",
        ],
    )),
    Lesson((
        id: "build_flight_test",
        category: Shipbuilding,
        order: 40,
        title: "Fly what you built",
        media: Loop(
            sheet: "self://training/build_flight_test.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a newly built ship leaving the yard under its own drive",
        ),
        body: "Test a new ship before you use it. Take it out, run the drive up to speed, then STOP. That shows you how quickly it accelerates and how long it needs to stop.",
        wiki_path: "wiki/flight-autopilot#the-hull-decides-the-handling",
    )),
    Lesson((
        id: "novaos_open",
        category: NovaOs,
        order: 10,
        title: "Opening NOVA OS",
        media: Loop(
            sheet: "self://training/novaos_open.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the NOVA OS screen coming up over the cockpit",
        ),
        body: "NOVA OS runs while you fly. Open it to read contacts, check your ship and give orders. The ship keeps flying while the screen is open.",
        actions: [
            "novaos_toggle",
        ],
        wiki_path: "wiki/nova-os#opening-and-closing",
        field_notes: [
            "NOVA OS runs while you fly. Open it to read contacts and give orders.",
        ],
    )),
    Lesson((
        id: "novaos_view",
        category: NovaOs,
        order: 20,
        title: "Turning the model",
        media: Loop(
            sheet: "self://training/novaos_view.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the ship model turning under the cursor, then reframing",
        ),
        body: "Drag to turn and pan the ship model, and use reframe to put it back where it started. Moving the model does not move the ship. The ship keeps flying while you look.",
        actions: [
            "novaos_reframe",
        ],
        wiki_path: "wiki/nova-os#the-ship",
    )),
    Lesson((
        id: "novaos_contacts",
        category: NovaOs,
        order: 30,
        title: "Reading contacts",
        media: Image(
            image: "self://training/novaos_contacts.webp",
            alt: "the contacts list with one entry selected",
        ),
        body: "The contacts list shows what is known about each contact. Selecting one here sets the same mark the flight computer uses for GOTO and ORBIT.",
        actions: [
            "novaos_next",
            "novaos_prev",
        ],
        wiki_path: "wiki/nova-os#the-map",
    )),
    Lesson((
        id: "advanced_scenarios",
        category: Advanced,
        order: 10,
        title: "Scenarios and campaigns",
        media: Image(
            image: "self://training/advanced_scenarios.webp",
            alt: "the scenario picker with a campaign expanded",
        ),
        body: "A scenario is a single flight. A campaign is a set of scenarios played in order. Both are loaded from content files, so a mod can add or replace them.",
        wiki_path: "wiki/scenarios#browsing-and-replaying-scenarios",
    )),
    Lesson((
        id: "advanced_mods",
        category: Advanced,
        order: 20,
        title: "Mods",
        media: Image(
            image: "self://training/advanced_mods.webp",
            alt: "the mods screen with one enabled mod selected",
        ),
        body: "Ships, weapons and scenarios all come from content files. A mod adds or replaces those files. The base game is itself a mod, so you can open and read every file in it.",
        wiki_path: "create/mod-files",
        field_notes: [
            "The base game is itself a mod, and you can read every file in it.",
        ],
    )),
    Lesson((
        id: "advanced_bindings",
        category: Advanced,
        order: 30,
        title: "Rebinding controls",
        media: Image(
            image: "self://training/advanced_bindings.webp",
            alt: "the settings screen on its bindings tab",
        ),
        body: "You can rebind every control in Settings. Lessons read your current bindings, so the key each lesson shows is the key you have set.",
        actions: [
            "main_drive",
        ],
        wiki_path: "wiki/settings#controls",
    )),
]
