    Lesson((
        id: "advanced_graphics",
        category: Advanced,
        order: 40,
        title: "Graphics presets",
        media: Image(
            image: "self://training/advanced_graphics.webp",
            alt: "the settings screen on its graphics row with the Low, Medium and High preset picked out",
        ),
        body: "One Low, Medium or High preset trades richness for framerate. High adds camera shake; Medium drops it and keeps hit flashes; Low drops both, spawns no particle bursts at all, and renders the world at a reduced resolution upscaled to the window.",
        wiki_path: "wiki/settings#graphics-quality",
    )),
    Lesson((
        id: "advanced_audio",
        category: Advanced,
        order: 45,
        title: "Audio mix",
        media: Image(
            image: "self://training/advanced_audio.webp",
            alt: "the settings screen on its audio tab: the Master, Interface, World and Music sliders with their levels as whole percents",
        ),
        body: "Four sliders: Master, Interface, World and Music. Interface is the cockpit - menu clicks, HUD ticks, the flight computer. World is everything out there, heard at the distance it happens. Master multiplies the other three. Music is reserved; the game ships none yet.",
        wiki_path: "wiki/settings#audio",
        field_notes: [
            "Master multiplies the other three channels, so a channel you turned down stays down.",
        ],
