    Lesson((
        id: "novaos_shell",
        category: NovaOs,
        order: 55,
        title: "The command shell",
        media: Image(
            image: "self://training/novaos_shell.webp",
            alt: "the same monitor on its cmd> prompt over the main menu, with a run of `status` answered under it",
        ),
        body: "A second language runs on the same monitor. It opens with no ship, over the menu or the editor, and reads the run: status, ships, bindings, settings. Cheat commands are refused until you arm them, and arming marks the run for good.",
        wiki_path: "wiki/commands#the-commands",
        field_notes: [
            "Arming cheats marks the run for good, and nothing unmarks it.",
        ],
    )),
    Lesson((
        id: "advanced_scenarios",
        category: Advanced,
        order: 10,
        title: "Scenarios and campaigns",
        media: Image(
            image: "self://training/advanced_scenarios.webp",
            alt: "the scenario picker with a scenario chosen and its briefing beside it",
        ),
        body: "A scenario places a world and wires its objectives: rocks, planets, ships, nav beacons, salvage crates and lights. One scenario is one flight; a campaign is a set played in order. Both load from content files, so a mod can add or replace them.",
        wiki_path: "wiki/scenarios#what-a-scenario-places",
    )),
    Lesson((
        id: "advanced_mods",
        category: Advanced,
        order: 20,
        title: "Mods",
        media: Image(
            image: "self://training/advanced_mods.webp",
            alt: "the mods screen with one enabled mod selected",
        ),
        body: "Ships, weapons and scenarios all come from content files. A mod adds or replaces those files. The base game is itself a mod, so you can open and read every file in it.",
        wiki_path: "create/mod-files",
        field_notes: [
            "The base game is itself a mod, and you can read every file in it.",
        ],
