[
    Lesson((
        id: "start_welcome",
        category: StartHere,
        order: 10,
        title: "How training works",
        media: Image(
            image: "self://training/start_welcome.webp",
            alt: "the training screen with a lesson open",
        ),
        body: "Each lesson is one screen: a picture or a short loop, a few lines of text, and the controls it uses. Some lessons open a practice flight. Every lesson links to a longer page on the wiki.",
        wiki_path: "wiki/getting-started",
    )),
    Lesson((
        id: "start_units",
        category: StartHere,
        order: 15,
        title: "Distances and speeds",
        media: Image(
            image: "self://training/start_units.webp",
            alt: "the HUD in a quiet cruise with a target range reading in kilometers beside a speed chip reading in meters a second",
        ),
        body: "Ranges read in meters below a kilometer and in kilometers above it; speeds read in m/s. Health reads in hp, and every section and torpedo carries its own. Every readout on the HUD and in NOVA OS uses those units.",
        wiki_path: "wiki/glossary#units",
    )),
    Lesson((
        id: "start_hud",
        category: StartHere,
        order: 20,
        title: "Reading the HUD",
        media: Image(
            image: "self://training/start_hud.webp",
            alt: "the velocity sphere and speed readout drawn around a ship",
        ),
        body: "The HUD only shows what you need right now. Your speed and a velocity sphere sit around your ship. The sphere points the way you are actually moving, which is not always where the nose points.",
        wiki_path: "wiki/hud",
        field_notes: [
            "The velocity sphere points the way you are moving. That is not always where the nose points.",
        ],
    )),
    Lesson((
        id: "start_verbs",
        category: StartHere,
        order: 25,
        title: "The keybind dock",
        media: Loop(
            sheet: "self://training/start_verbs.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the verb chips along the bottom of a cruising ship, then STOP engaged: its chip inverts and a CANCEL chip joins the row",
        ),
        body: "The chip row along the bottom shows the verbs this ship can use right now: STOP, GOTO, ORBIT, CANCEL, RADAR, COMPONENT, RCS and DOCK. Each draws your own keycap; a verb the ship cannot use is off the row, and an engaged one inverts.",
        wiki_path: "wiki/hud#flight-readouts",
        practice: Some("drill_autopilot"),
        field_notes: [
            "The chip row draws only the verbs this ship can use now, each with your own keycap.",
        ],
    )),
    Lesson((
        id: "start_camera",
        category: StartHere,
        order: 30,
        title: "Looking around",
        media: Loop(
            sheet: "self://training/start_camera.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the camera orbiting a stationary ship",
        ),
        body: "The mouse is the helm: in normal flight the camera and the ship turn together. Hold free look and the camera turns on its own while the hull holds its heading - that is how you find a contact before you commit to it.",
        actions: [
            "camera_rotate",
            "free_look",
        ],
        wiki_path: "wiki/keybinds#targeting-and-camera",
        field_notes: [
            "The mouse is the helm. Hold free look to turn the camera without turning the ship.",
        ],
    )),
    Lesson((
        id: "start_markers",
        category: StartHere,
        order: 35,
        title: "Who is who",
        media: Image(
            image: "self://training/start_markers.webp",
            alt: "three ships across one view with their markers up: a green triangle over a wingman, a red one over a raider and a grey one over an unaligned hauler",
        ),
        body: "A small triangle floats over every ship in view, pointing down at it: green ally, red hostile, grey neutral. Your own ship shows none. It hides when a ship leaves the screen, and a neutral provoked into a threat flips red on the spot.",
        wiki_path: "wiki/hud#allegiance-markers",
        field_notes: [
            "A triangle rides over every ship in view: green ally, red hostile, grey neutral.",
        ],
    )),
    Lesson((
        id: "start_cinematic",
        category: StartHere,
        order: 40,
        title: "Two HUD levels",
        media: Loop(
            sheet: "self://training/start_cinematic.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a cruising ship with its velocity sphere, speed readout and verb chips drawn, then the HUD toggle clearing them to a bare view",
        ),
        body: "The HUD is contextual: a quiet cruise draws the velocity sphere, your speed and the dock\'s live verbs, and everything else arrives with its moment. The HUD toggle cycles two levels: On, and Cinematic, a clean screen that clears every instrument and chip.",
        actions: [
            "hud_cinematic",
        ],
        wiki_path: "wiki/hud#what-is-on-screen-and-when",
        field_notes: [
            "Cinematic is the HUD\'s second level: a clean screen with every instrument and chip gone.",
        ],
    )),
    Lesson((
        id: "start_pause",
        category: StartHere,
        order: 45,
        title: "Pausing and retrying",
        media: Image(
            image: "self://training/start_pause.webp",
            alt: "the pause overlay over a live flight, its Resume, Retry, Settings, Back to Main Menu and Exit rows stacked on the frozen world",
        ),
        body: "Pause holds any scenario and offers Resume, Retry, Settings, Back to Main Menu and Exit. Retry restarts the scenario you are on from the beginning. Settings is the same panel the main menu opens, so you can rebind without leaving the flight.",
        wiki_path: "wiki/getting-started#launch-and-start",
    )),
    Lesson((
        id: "flight_aim",
        category: Flight,
        order: 10,
        title: "Turn, then thrust",
        media: Loop(
            sheet: "self://training/flight_aim.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a ship holding a heading with its main drive lit behind it",
        ),
        body: "The main drive only pushes in the direction the nose points. Turn to face where you want to go, then thrust. Thrust while you are still turning and you push yourself onto a heading you are leaving.",
        actions: [
            "main_drive",
        ],
        wiki_path: "wiki/flight-autopilot#manual-flight",
        practice: Some("drill_momentum"),
        proven_by: [
            "tutorial",
            "drill_momentum",
        ],
        field_notes: [
            "The drive only pushes where the nose points. Turn first, then thrust.",
        ],
    )),
    Lesson((
        id: "flight_momentum",
        category: Flight,
        order: 20,
        title: "You keep your speed",
        media: Loop(
            sheet: "self://training/flight_momentum.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "thrust released; the ship keeps its speed and heading",
        ),
        body: "Releasing the drive does not slow you down. Nothing in space does. You keep your current speed and heading until something pushes you the other way.",
        actions: [
            "main_drive",
        ],
        wiki_path: "wiki/flight-autopilot#manual-flight",
        practice: Some("drill_momentum"),
        proven_by: [
            "drill_momentum",
        ],
        field_notes: [
            "Nothing slows you down in space. Release the drive and your speed stays the same.",
        ],
    )),
    Lesson((
        id: "flight_speedcap",
        category: Flight,
        order: 25,
        title: "The speed cap",
        media: Loop(
            sheet: "self://training/flight_speedcap.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a held burn climbing against the range\'s soft cap: the speed chip reads 138.7 / 150.0 m/s and settles on 150.0 with the drive still lit",
        ),
        body: "A scenario can put a soft cap on your manual burn: Basic Training flies under 150 m/s. It caps your TOTAL speed, not the heading you point, so a held throttle tapers off there instead of accelerating forever. A braking burn is never capped.",
        actions: [
            "main_drive",
        ],
        wiki_path: "wiki/flight-autopilot#manual-flight",
        practice: Some("drill_momentum"),
        field_notes: [
            "A range can cap your manual speed. It caps your total speed, not the heading you point.",
        ],
    )),
    Lesson((
        id: "flight_stop",
        category: Flight,
        order: 30,
        title: "The STOP order",
        media: Loop(
            sheet: "self://training/flight_stop.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the flight computer turning the ship around and slowing it to zero",
        ),
        body: "STOP flips the ship to retrograde and burns the speed off. At rest is a deadband, not a dead stop: a residual the drive already faces is braked to 2 m/s, and a sideways drift is handed back at up to 7.5 m/s.",
        actions: [
            "autopilot_stop",
        ],
        wiki_path: "wiki/flight-autopilot#the-autopilot-flies-the-hull",
        practice: Some("drill_stop"),
        proven_by: [
            "tutorial",
            "drill_stop",
        ],
        field_notes: [
            "STOP settles into a deadband, not a dead stop: a sideways drift is handed back at up to 7.5 m/s.",
        ],
    )),
    Lesson((
        id: "flight_cancel",
        category: Flight,
        order: 35,
        title: "Taking the ship back",
        media: Loop(
            sheet: "self://training/flight_cancel.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a braking order running, then the main drive lighting: the AP STOP chip goes out, the CANCEL chip leaves the dock and the shell turns from nav cyan to blue",
        ),
        body: "CANCEL drops any engaged maneuver and hands the ship back already moving. So does a main-drive burn, a bound thruster key, entering RCS, or pressing the engaged verb again. Moving the mouse does not: while the computer flies, the mouse is camera only.",
        actions: [
            "autopilot_off",
            "main_drive",
            "rcs_modifier",
        ],
        wiki_path: "wiki/flight-autopilot#the-autopilot-flies-the-hull",
        practice: Some("drill_stop"),
        field_notes: [
            "Moving the mouse does not cancel a maneuver. CANCEL, a burn or a thruster key does.",
        ],
    )),
    Lesson((
        id: "flight_rcs",
        category: Flight,
        order: 40,
        title: "Using the RCS thrusters",
        media: Loop(
            sheet: "self://training/flight_rcs.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "small thruster bursts moving a ship onto a mark",
        ),
        body: "Hold the RCS modifier and the mouse drives the small thrusters. They move the ship sideways without turning it. Use them for small corrections the main drive would overshoot.",
        actions: [
            "rcs_modifier",
            "rcs_aim",
        ],
        wiki_path: "wiki/flight-autopilot#rcs-fine-docking-thrusters",
        practice: Some("drill_stop"),
        proven_by: [
            "tutorial",
            "drill_stop",
        ],
    )),
    Lesson((
        id: "flight_gravity",
        category: Flight,
        order: 45,
        title: "Gravity wells",
        media: Loop(
            sheet: "self://training/flight_gravity.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a hull coasting inside a sphere of influence with its drive out: the yellow pull shell and the blue velocity shell stand off in different directions while the speed chip climbs from 122 to 139 m/s",
        ),
        body: "Gravity pulls you inward at a = mu / r^2. mu is the body\'s number, never your mass, so a laden hauler falls as fast as a stripped fighter. The pull ends at the sphere of influence, where it has decayed to 2.5 m/s2.",
        wiki_path: "wiki/gravity-wells#sphere-of-influence",
        practice: Some("drill_autopilot"),
        field_notes: [
            "Gravity is an acceleration, so a laden hauler falls as fast as a stripped fighter.",
        ],
    )),
    Lesson((
        id: "flight_goto",
        category: Flight,
        order: 50,
        title: "GOTO a mark",
        media: Loop(
            sheet: "self://training/flight_goto.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a ship turning towards a marked contact and flying to it",
        ),
        body: "GOTO flies the ship to your travel lock and parks a standoff short of it: 500 m of clear space, measured from your own hull face to the target\'s surface, rather than centre to centre. Mark a contact first, then give the order.",
        actions: [
            "autopilot_goto",
        ],
        wiki_path: "wiki/flight-autopilot#the-autopilot-flies-the-hull",
        practice: Some("drill_autopilot"),
        proven_by: [
            "tutorial",
            "drill_autopilot",
        ],
        field_notes: [
            "GOTO parks 500 m off the target\'s surface, measured from your own hull face.",
        ],
    )),
    Lesson((
        id: "flight_arrival",
        category: Flight,
        order: 55,
        title: "The arrival envelope",
        media: Loop(
            sheet: "self://training/flight_arrival.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a GOTO leg flipped retrograde on its braking ramp, drives firing up the track under an amber AP GOTO - BURN chip, swinging once through ALIGN and back as the speed falls",
        ),
        body: "GOTO obeys one rule: at any distance it caps closing speed at what a flip-and-brake from there can still cancel. It flips one swing early, brakes at 85% of the drive\'s authority down to a 15 m/s floor, then settles on RCS.",
        actions: [
            "autopilot_goto",
        ],
        wiki_path: "wiki/flight-autopilot#the-autopilot-flies-the-hull",
        practice: Some("drill_autopilot"),
        field_notes: [
            "GOTO never closes faster than a flip-and-brake from where it is can still cancel.",
        ],
    )),
    Lesson((
        id: "flight_orbit",
        category: Flight,
        order: 60,
        title: "ORBIT a mark",
        media: Loop(
            sheet: "self://training/flight_orbit.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a ship settling into a circle around a planetoid",
        ),
        body: "ORBIT parks the ship in a circle around the gravity well it is inside, never around your mark. The computer picks a stable ring, holds orbital speed with micro-burns, and never finishes on its own. Outside every sphere of influence the key does nothing.",
        actions: [
            "autopilot_orbit",
        ],
        wiki_path: "wiki/gravity-wells#the-dominant-well",
        practice: Some("drill_autopilot"),
        proven_by: [
            "tutorial",
            "drill_autopilot",
        ],
        field_notes: [
            "ORBIT circles the gravity well you are inside, not the contact you marked.",
        ],
    )),
    Lesson((
        id: "flight_dock",
        category: Flight,
        order: 65,
        title: "DOCK",
        media: Loop(
            sheet: "self://training/flight_dock.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a tender on the last stretch of an approach: the two port crosses square up and the ticked line between them shortens tick by tick until the DOCK chip lights",
        ),
        body: "DOCK clamps your hull to the ship you hold a travel lock on, port face to port face, and both hulls need a docking port. Inside 80 m the docking sight draws a cross on each port face and a ticked line between them.",
        actions: [
            "dock",
        ],
        wiki_path: "wiki/hud#docking-sight",
        field_notes: [
            "DOCK clamps port face to port face, and both hulls need a docking port.",
        ],
    )),
    Lesson((
        id: "combat_radar",
        category: Combat,
        order: 10,
        title: "Using the radar",
        media: Loop(
            sheet: "self://training/combat_radar.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the radar marking a contact ahead of the ship: the lock charges, then the bracket lands on it",
        ),
        body: "Hold radar to sweep and mark what it settles on. There are two slots: lowered writes the white travel lock the autopilot flies, raised writes the red combat lock the guns use. A tap clears in stages; raised, it only drops the combat lock.",
        actions: [
            "radar_hold",
            "radar_clear",
        ],
        wiki_path: "wiki/targeting-radar#holding-to-sweep",
        practice: Some("drill_gunnery"),
        proven_by: [
            "tutorial",
            "drill_gunnery",
        ],
        field_notes: [
            "There are two lock slots. Lowered writes the white travel lock, raised the red combat lock.",
        ],
    )),
    Lesson((
        id: "combat_lock_ranges",
        category: Combat,
        order: 12,
        title: "How far you can lock",
        media: Image(
            image: "self://training/combat_lock_ranges.webp",
            alt: "the radar reticle on a distant gunship with its range printed under the bracket, and a second hull further out still unlocked",
        ),
        body: "How far you can lock is what the target IS: thirty times its radar signature, under a 200 km scanner ceiling. A bare one-cell hull is a contact at about 9 km, a light skiff at 22 km, the largest carrier at 60 km.",
        actions: [
            "radar_hold",
        ],
        wiki_path: "wiki/targeting-radar#lock-ranges",
        field_notes: [
            "You can lock a target at thirty times its radar signature, under a 200 km ceiling.",
        ],
    )),
    Lesson((
        id: "combat_allegiance",
        category: Combat,
        order: 15,
        title: "Who shoots whom",
        media: Image(
            image: "self://training/combat_allegiance.webp",
            alt: "a gunship holding station in a rock pocket with a green triangle over a friendly gunship, a red one over a raider and a grey one over an unaligned salvage hull",
        ),
        body: "Every ship is Player, Enemy or Neutral, and any pair resolves to Own, Hostile or Neutral. A round copies its shooter\'s side at launch and keeps it, so your own ordnance never hits you. A triangle over each ship reads green, red or grey.",
        wiki_path: "wiki/factions#the-relation-model",
        field_notes: [
            "A round takes its shooter\'s side at launch, so your own ordnance never hits you.",
        ],
    )),
    Lesson((
        id: "combat_stance",
        category: Combat,
        order: 20,
        title: "Raising weapons",
        media: Loop(
            sheet: "self://training/combat_stance.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a ship\'s gun mounts rising out of the deck as the weapons come up",
        ),
        body: "Raising weapons is a held stance. It makes your radar write the red combat lock instead of the white travel lock, makes the guns hot, and moves the mouse off the helm onto turret aim - the hull holds its heading while you aim.",
        actions: [
            "combat_stance",
        ],
        wiki_path: "wiki/targeting-radar#stances-and-slots",
        practice: Some("drill_gunnery"),
        proven_by: [
            "tutorial",
            "drill_gunnery",
        ],
        field_notes: [
            "Raising weapons writes the red combat lock and moves the mouse from the helm to turret aim.",
        ],
    )),
    Lesson((
        id: "combat_cover",
        category: Combat,
        order: 25,
        title: "Cover and the firing line",
        media: Loop(
            sheet: "self://training/combat_cover.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a gunship\'s tracers crossing to a boulder and dying on it while the red-marked hostile beyond the stone sits untouched",
        ),
        body: "Put a rock between you and a hostile and the rounds stop at it - and so does the radar, which needs the same clear line the guns do. A hostile that loses the line loses its pick and goes passive.",
        wiki_path: "wiki/combat-weapons#cover-line-of-fire",
        field_notes: [
            "A rock on the line eats the round and the radar lock. Cover is a full disengage.",
        ],
    )),
    Lesson((
        id: "combat_components",
        category: Combat,
        order: 30,
        title: "Lock a component",
        media: Loop(
            sheet: "self://training/combat_components.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the fine lock stepping from one section of a marked ship to the next",
        ),
        body: "Hold a combat lock steady and you can drill it into one section. Turrets and the viewfinder follow the one you pick. Killing a drive costs thrust, never speed; it is the last flight computer that leaves a hull drifting and tumbling.",
        actions: [
            "component_next",
            "component_prev",
        ],
        wiki_path: "wiki/targeting-radar#per-section-fine-lock",
        practice: Some("drill_gunnery"),
        proven_by: [
            "drill_gunnery",
        ],
        field_notes: [
            "Killing a ship\'s drives costs it thrust, not speed. Its last flight computer leaves it drifting.",
        ],
    )),
    Lesson((
        id: "combat_damage_types",
        category: Combat,
        order: 35,
        title: "Kinetic and Pierce",
        media: Loop(
            sheet: "self://training/combat_damage_types.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "two identical gun rigs firing down two spaced stacks of hull plates, the Kinetic lane chipping only the plate it cannot destroy and the Pierce lane chipping every plate in its stack",
        ),
        body: "A damage type is not a multiplier: both hit a hull and a drive for the same number. What changes is travel. Kinetic carries on only through what it destroys; Pierce rakes every section it crosses, spending a power budget per layer.",
        wiki_path: "wiki/combat-weapons#damage-types",
        field_notes: [
            "A damage type is not a multiplier. Kinetic stops at what it fails to kill; Pierce rakes.",
        ],
    )),
    Lesson((
        id: "combat_turrets",
        category: Combat,
        order: 40,
        title: "Turret arcs",
        media: Image(
            image: "self://training/combat_turrets.webp",
            alt: "a ship from above, its turrets swung onto one target and firing",
        ),
        body: "A turret turns all the way round; its barrel stops 10 degrees below level, so each mount is blind in a cone under its own keel. Nothing else bounds it - your own hull is transparent to your rounds, which pass straight through it.",
        wiki_path: "wiki/sections/turret#what-it-can-bear-on",
        proven_by: [
            "tutorial",
            "drill_gunnery",
        ],
        field_notes: [
            "A turret\'s barrel stops 10 degrees below level, so each mount is blind under its own keel.",
        ],
    )),
    Lesson((
        id: "combat_magazines",
        category: Combat,
        order: 45,
        title: "A magazine is a rate limit",
        media: Loop(
            sheet: "self://training/combat_magazines.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a gunship\'s dorsal mounts firing, the ammo ring beside each one losing pips through the burst and coming back full on one batch a few frames after the trigger comes up",
        ),
        body: "No weapon runs out for good. A PDC holds 500 rounds at 100 a second and gets 200 back for every three quiet seconds, all at once. Every shot restarts that interval, so firing in batches sustains 40 rounds a second.",
        wiki_path: "wiki/combat-weapons#magazines",
        practice: Some("drill_gunnery"),
        field_notes: [
            "A magazine is a rate limit, not a budget. Nothing in the game runs out for good.",
        ],
    )),
    Lesson((
        id: "combat_torpedoes",
        category: Combat,
        order: 50,
        title: "Torpedoes",
        media: Loop(
            sheet: "self://training/combat_torpedoes.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a torpedo dropping clear of a ship, then homing on a locked target",
        ),
        body: "A torpedo needs a combat lock. The bay drops it cold and the drive lights 0.6 seconds later. It arms only well clear of you: 324 m off a small boat, 494 m off a carrier. Inside that it bounces off as a dud.",
        wiki_path: "wiki/sections/torpedo-bay",
        field_notes: [
            "A torpedo arms 324 m off a small boat and 494 m off a carrier. Inside that it is a dud.",
        ],
    )),
    Lesson((
        id: "combat_torpedo_types",
        category: Combat,
        order: 55,
        title: "Serpent and Lance",
        media: Loop(
            sheet: "self://training/combat_torpedo_types.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "two torpedoes running in side by side on the same gunship: the Serpent corkscrewing around its guidance line while the Lance holds a dead straight track and pulls ahead",
        ),
        body: "Two normal bays ship, and only the run-in differs. A Serpent weaves, so one defending mount spends 390 rounds and only kills it 400 m out. A Lance flies straight and faster, and the same mount kills it 1.14 km short of you.",
        wiki_path: "wiki/sections/torpedo-bay#the-two-run-ins",
        field_notes: [
            "A Serpent weaves and costs a defending mount 390 rounds; a Lance flies straight and faster.",
        ],
    )),
    Lesson((
        id: "combat_point_defense",
        category: Combat,
        order: 60,
        title: "Your battery defends itself",
        media: Image(
            image: "self://training/combat_point_defense.webp",
            alt: "a gunship with its weapons lowered working its own mounts against an inbound salvo, a thin line running from each engaged mount out to the torpedo it picked and its rounds streaming along that line",
        ),
        body: "With no combat lock and your weapons lowered, the flight computer works your idle mounts against inbound torpedoes - no toggle and no key. A thin line runs from each mount to its pick. Lock or raise, and every mount is yours that instant.",
        actions: [
            "combat_stance",
        ],
        wiki_path: "wiki/combat-weapons#your-own-battery",
        field_notes: [
            "Your idle mounts shoot torpedoes down on their own. Lock or raise and they are yours.",
        ],
    )),
    Lesson((
        id: "combat_railgun",
        category: Combat,
        order: 70,
        title: "The hull is the aim",
        media: Loop(
            sheet: "self://training/combat_railgun.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a gunboat committing its spinal railgun on a patrol gunship a hundred and fifty meters off, the bore sight thread thickening across the gap as the charge runs, and then the shell opening the target hull into tumbling plates",
        ),
        body: "A railgun has no traverse: it fires down its own axis, so the face you bolt it to is the line. A tap starts a 1.5 second charge that only lowering your weapons aborts; it never re-checks the nose. One shell every 13.5 seconds.",
        wiki_path: "wiki/sections/railgun#committing-the-shot",
        field_notes: [
            "A railgun fires down its own axis. The face you bolted it to is the line it shoots.",
        ],
    )),
    Lesson((
        id: "combat_bore_sight",
        category: Combat,
        order: 80,
        title: "The bore sight",
        media: Loop(
            sheet: "self://training/combat_bore_sight.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the sight line out of a spinal railgun and across the gap onto a gunship\'s long axis, a ring on each section the shot would destroy, and the line fattening as the charge runs",
        ),
        body: "A blue line runs from the muzzle to where the slug would stop, with a ring on every section that shot would destroy. Aiming down a ship\'s long axis reads differently from catching its shoulder. The line thickens as the charge runs.",
        wiki_path: "wiki/sections/railgun#the-bore-sight",
        field_notes: [
            "The bore sight rings every section your shot would destroy, and thickens as the charge runs.",
        ],
    )),
    Lesson((
        id: "combat_collapse",
        category: Combat,
        order: 90,
        title: "When a ship comes apart",
        media: Loop(
            sheet: "self://training/combat_collapse.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "one siege railgun shell boring a corridor through a block of reinforced hull, and the block then letting go of every section it has left and opening into a drifting cloud of plates",
        ),
        body: "You do not have to shoot every section off. A hull carrying less than a twentieth of the structure it was built with collapses. A ship that loses every weapon, or its last flight computer, is NEUTRALIZED: it keeps its hull and stops answering.",
        wiki_path: "wiki/ships#taking-a-ship-apart",
        practice: Some("drill_gunnery"),
        field_notes: [
            "A hull left under a twentieth of the structure it was built with collapses on its own.",
        ],
    )),
    Lesson((
        id: "build_sections",
        category: Shipbuilding,
        order: 10,
        title: "Ships are built from sections",
        media: Image(
            image: "self://training/build_sections.webp",
            alt: "the editor with one section selected on the hull it mates to",
        ),
        body: "A ship is sections mated socket to socket, and a socket is the only structural link a hull has. Each section does one job and weighs the volume of the box it is hit on. The build grid counts in 10 m cells.",
        wiki_path: "wiki/sections#what-every-section-shares",
        field_notes: [
            "Sections mate socket to socket, and a socket is the only structural link a hull has.",
        ],
    )),
    Lesson((
        id: "build_mass",
        category: Shipbuilding,
        order: 20,
        title: "Mass and thrust",
        media: Image(
            image: "self://training/build_mass.webp",
            alt: "the same hull with a heavier loadout, its numbers beside it",
        ),
        body: "Every section you add is mass the drive has to move and stop. On the same two basic drives the 21.00-mass skiff pulls 61 m/s2 and the 41.00-mass tug pulls 31. More drives close the gap, but no stack passes 640 m/s2.",
        wiki_path: "wiki/sections/thruster",
        field_notes: [
            "The 21.00-mass skiff pulls 61 m/s2 on two basic drives; the 41.00-mass tug pulls 31.",
        ],
    )),
    Lesson((
        id: "build_readout",
        category: Shipbuilding,
        order: 25,
        title: "The build readout",
        media: Image(
            image: "self://training/build_readout.webp",
            alt: "the editor rail\'s stat block on a half-built hull: Turn, Mass, Thrust, HP and Parts down one column with the limit note under them",
        ),
        body: "The rail prints the turn rate and four sums: mass, thrust, health and part count. Mass is the volume of the parts, so a part that lands moves them. Under the block, one line names the limit holding the turn rate down.",
        wiki_path: "wiki/keybinds#the-build-readout",
    )),
    Lesson((
        id: "build_balance",
        category: Shipbuilding,
        order: 30,
        title: "Thruster placement",
        media: Image(
            image: "self://training/build_balance.webp",
            alt: "two thrusters on a lopsided hull in the editor, with the ship\'s turn and thrust figures beside it",
        ),
        body: "Thrusters sit wherever you bolt them, so an off-centre burn would spin the ship. The flight computer sets each throttle to cancel that spin. A lopsided or damaged ship still flies straight, with less thrust.",
        wiki_path: "wiki/sections/thruster",
        field_notes: [
            "The flight computer balances your thrusters, so a lopsided ship still flies straight.",
        ],
    )),
    Lesson((
        id: "build_turning",
        category: Shipbuilding,
        order: 35,
        title: "What decides your turn rate",
        media: Image(
            image: "self://training/build_turning.webp",
            alt: "a long spine in the editor, the rail printing its turn ceiling with the structure-limited note under it",
        ),
        body: "A hull turns at the lower of two ceilings: what its computers can twist against its mass, and what 8 G allows at the furthest section\'s face. The base gunship\'s 55.2 m arm caps it at 1.42 rad/s2, where its computers could push 8.74.",
        wiki_path: "wiki/sections/controller#what-sets-how-hard-a-ship-turns",
        field_notes: [
            "A hull turns at the lower of two ceilings: computer torque, and 8 G at its furthest face.",
        ],
    )),
    Lesson((
        id: "build_flight_test",
        category: Shipbuilding,
        order: 40,
        title: "Fly what you built",
        media: Loop(
            sheet: "self://training/build_flight_test.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a newly built four-block ship running past a rock under its own drive",
        ),
        body: "Test a new ship before you use it. Take it out, run the drive up to speed, then STOP. That shows you how quickly it accelerates and how long it needs to stop.",
        wiki_path: "wiki/flight-autopilot#the-hull-decides-the-handling",
    )),
    Lesson((
        id: "build_stacking",
        category: Shipbuilding,
        order: 50,
        title: "A second flight computer",
        media: Image(
            image: "self://training/build_stacking.webp",
            alt: "two flight computers on one spine in the editor, both of them listed in the scene tree, and the rail naming the structure as what holds the turn rate down",
        ),
        body: "A second flight computer adds no turn rate to a hull already held by its structure, which is every base hull but the carrier. It buys precision - the turn stops on the heading - and redundancy, since only the last computer is the brain.",
        wiki_path: "wiki/sections/controller#stacking-controllers",
        field_notes: [
            "A second flight computer buys precision and redundancy, not turn rate, on most hulls.",
        ],
    )),
    Lesson((
        id: "build_weapon_mounts",
        category: Shipbuilding,
        order: 60,
        title: "Where a weapon can point",
        media: Image(
            image: "self://training/build_weapon_mounts.webp",
            alt: "a turret bolted on a hull\'s top face and a railgun on its nose, the turret\'s card open in the inspector",
        ),
        body: "Where you bolt a weapon decides what it points at. A turret traverses freely and owns 58.7 percent of the sky from wherever it sits, blind under its keel. A railgun does not traverse: the face it sits on is its line of fire.",
        wiki_path: "wiki/sections/turret#what-it-can-bear-on",
        field_notes: [
            "A turret owns 58.7 percent of the sky. A railgun only owns the face you bolted it to.",
        ],
    )),
    Lesson((
        id: "build_docking_port",
        category: Shipbuilding,
        order: 70,
        title: "Bolting on a docking port",
        media: Image(
            image: "self://training/build_docking_port.webp",
            alt: "a docking port seated on a hull face in the editor, its capture envelope open in the inspector",
        ),
        body: "No base hull carries a docking port, so a ship that can dock is one you built. The port carries 90 health, the lightest part on a hull, and takes neighbours on every face but the hatch it docks through.",
        wiki_path: "wiki/sections/docking#variants",
        field_notes: [
            "No base hull carries a docking port. A ship that can dock is one you built.",
        ],
    )),
    Lesson((
        id: "build_dock_envelope",
        category: Shipbuilding,
        order: 75,
        title: "Making a dock",
        media: Loop(
            sheet: "self://training/build_dock_envelope.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a tender lining up on a moored spar: the docking sight\'s face plates square up and go green, then the gap line as the hull brakes inside the capture distance, and a DOCK chip joins the verb row",
        ),
        body: "Four things at once: the port faces within 10 m, the ports within 15 degrees of opposed, under 5 m/s of closing rate, under 5 degrees a second of relative spin. Roll is ignored. Docked, your drive and helm are inert.",
        actions: [
            "dock",
        ],
        wiki_path: "wiki/sections/docking#flying-the-approach",
        field_notes: [
            "A dock needs 10 m of gap, 15 degrees of facing, and both hulls almost still.",
        ],
    )),
    Lesson((
        id: "build_skin",
        category: Shipbuilding,
        order: 80,
        title: "Ship skin",
        media: Loop(
            sheet: "self://training/build_skin.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a bare section hull in the editor with Ship Skin switched on: the plating closes over the structure, and closes again around the next part as it is dragged into place",
        ),
        body: "Ship Skin dresses the build in the cladding it would fly with. Nothing places a plate: the skin is derived from the structure, and re-derived as you build, including around the part in hand. A refused placement stays bare. The toggle carries into Play.",
        wiki_path: "wiki/keybinds#the-inspector",
    )),
    Lesson((
        id: "build_generate",
        category: Shipbuilding,
        order: 90,
        title: "Generate a hull",
        media: Loop(
            sheet: "self://training/build_generate.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "a three-part stub in the editor with seed 2026 typed in the Generate block, then the hull Generate rolls in its place",
        ),
        body: "Generate rolls a whole hull into the ship you are inside, from a seed you can type or reroll, drawing only the sections you ticked. It replaces what that ship holds. The result is ordinary section nodes, already bound to their kind\'s key.",
        wiki_path: "wiki/keybinds#generate-a-hull",
        field_notes: [
            "Generate rolls a hull from a seed and REPLACES what the ship you are inside holds.",
        ],
    )),
    Lesson((
        id: "novaos_open",
        category: NovaOs,
        order: 10,
        title: "Opening NOVA OS",
        media: Loop(
            sheet: "self://training/novaos_open.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the NOVA OS screen coming up over the cockpit",
        ),
        body: "Opening NOVA OS freezes the game: the clocks stop, so combat, physics and every projectile hold mid-frame while you read contacts, check your ship and give orders. Nothing moves until you close it.",
        actions: [
            "novaos_toggle",
        ],
        wiki_path: "wiki/nova-os#opening-and-closing",
        field_notes: [
            "Opening NOVA OS freezes the game. The clocks stop until you close the screen.",
        ],
    )),
    Lesson((
        id: "novaos_terminal",
        category: NovaOs,
        order: 15,
        title: "The prompt",
        media: Loop(
            sheet: "self://training/novaos_terminal.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the prompt completing a subcommand: `ship re` carries a dim `load` suffix, Tab prints the `ship reload` / `ship repair` row and takes the first, Tab again steps onto `ship repair`, and a space then Tab lists the hull\'s live section codes",
        ),
        body: "NOVA OS has a prompt you type at, and it reads nova>. Completion fills in command names, subcommands and the live section or contact codes an argument wants. It keeps 200 lines of history and 500 rows of scrollback, and reddens an unknown word.",
        wiki_path: "wiki/nova-os#the-terminal",
        field_notes: [
            "NOVA OS has a prompt you type at. Completion fills in commands and live section codes.",
        ],
    )),
    Lesson((
        id: "novaos_view",
        category: NovaOs,
        order: 20,
        title: "Turning the model",
        media: Loop(
            sheet: "self://training/novaos_view.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the ship schematic turning on the NOVA OS screen, then snapping back to its framing",
        ),
        body: "Drag to turn and pan the ship model, and use reframe to put it back where it started. Moving the model does not move the ship. The game is frozen while the computer is open, so you can look as long as you like.",
        actions: [
            "novaos_reframe",
        ],
        wiki_path: "wiki/nova-os#the-ship",
    )),
    Lesson((
        id: "novaos_commands",
        category: NovaOs,
        order: 25,
        title: "What you can type",
        media: Loop(
            sheet: "self://training/novaos_commands.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "`help` typed at a wiped prompt and run: the registered command list prints under it, `help` through `exit` and then `map`, `ship` and their subcommands, each with the line that says what it does",
        ),
        body: "help lists everything. log prints the flight log, objectives the open objectives, clear wipes back to the boot report. map and ship hand the screen to an app; map view and ship view print the same data as a table. exit returns to flight.",
        wiki_path: "wiki/nova-os#command-reference",
        field_notes: [
            "help lists every command. map and ship open an app; map view and ship view print a table.",
        ],
    )),
    Lesson((
        id: "novaos_contacts",
        category: NovaOs,
        order: 30,
        title: "Reading contacts",
        media: Image(
            image: "self://training/novaos_contacts.webp",
            alt: "the local-space plot with one hostile picked and its range and bearing under it",
        ),
        body: "The MAP app plots every contact around you as a labelled blip: SELF, ALLY-1, HOST-1, OBJ-1, AST-1. Pick one and the readout gives its kind, name, range and bearing. Setting GOTO from here engages the autopilot directly, without taking a radar lock.",
        actions: [
            "novaos_next",
            "novaos_prev",
            "map_goto",
        ],
        wiki_path: "wiki/nova-os#the-map",
    )),
    Lesson((
        id: "novaos_service",
        category: NovaOs,
        order: 35,
        title: "Repair and reload a section",
        media: Loop(
            sheet: "self://training/novaos_service.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the SHIP app\'s inspector on a damaged PDC-1: repair fills the integrity meter to `100% [##########]` and prints `repaired PDC-1`, then reload takes the magazine from `1/500` back to `500/500`",
        ),
        body: "Sections carry short codes - HULL-1, THR-1, CTL-1, PDC-1, TRB-1 - stable for the session and shared by the app and the prompt. Select one and repair restores its integrity; reload refills a weapon\'s magazine. Both are instant, and a hull section refuses reload.",
        actions: [
            "novaos_next",
            "novaos_prev",
            "ship_repair",
            "ship_reload",
        ],
        wiki_path: "wiki/nova-os#the-ship",
        field_notes: [
            "Sections carry short codes like THR-1. Select one and repair or reload acts on it.",
        ],
    )),
    Lesson((
        id: "novaos_rebind_section",
        category: NovaOs,
        order: 45,
        title: "Rebinding a section",
        media: Loop(
            sheet: "self://training/novaos_rebind_section.webp",
            columns: 4,
            rows: 5,
            frames: 20,
            frames_per_second: 10.0,
            alt: "the SHIP app\'s inspector on PDC-1: arming the rebind puts `PRESS A KEY OR MOUSE BUTTON - ESC CANCELS` across the panel in amber, and the next key takes the trigger - the binding line turns from `LMB / Right Trigger 2` to `K / Right Trigger 2`",
        ),
        body: "Your thrusters, turrets and tubes fire on per-ship triggers that Settings does not list. Select the section in the SHIP app and arm rebind; the next key or mouse button takes over its keyboard trigger. A reserved flight control is refused by name.",
        actions: [
            "ship_rebind",
            "novaos_next",
            "novaos_prev",
        ],
        wiki_path: "wiki/nova-os#rebinding-a-section",
        field_notes: [
            "A section\'s trigger is per ship, not in Settings. Rebind it in the SHIP app.",
        ],
