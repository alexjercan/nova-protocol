// The Nova Protocol story: the base game's campaign, shipped as a mod of its
// own. Enabled on a fresh install and reachable only from the Scenarios
// picker, under the "Nova Protocol" campaign header - New Game starts the
// base game's training range instead.
//
// The content files are GENERATED from the builders under
// `crates/nova_authoring/src/mod_content/nova_protocol/` (`cargo run content
// gen`); the parity test refuses a hand edit. The story borrows the base
// game's sky, rocks, sounds and the player's own portrait through
// `dep://base/<path>`, and ships the rest of its faces and its picker plate
// itself, referenced with `self://`.
(
    content: [
        // The campaign names its chapter by id, so the chapter merges first.
        "scenarios/first_shift.content.ron",
        "campaigns/nova_protocol.content.ron",
    ],
    resources: [
        // The picker plate, generated by `scripts/gen-scenario-thumbnails.py`
        // until real art lands at the same path.
        "thumbnails/first_shift.png",
        // Green CRT portraits for the story's named comms voices, generated
        // by `scripts/generate-campaign-portraits.py`. The player's own face
        // is base art (`dep://base/portraits/player.png`).
        "portraits/automated-beacon.png",
        "portraits/copilot.png",
        "portraits/deck-chief.png",
        "portraits/engineer.png",
        "portraits/meridian-control.png",
        "portraits/unknown-channel.png",
    ],
    meta: (
        name: "Nova Protocol",
        description: "The story campaign: An Ordinary Shift, a salvage crew's working day out of the carrier Meridian, and what ends it.",
        author: "Nova Protocol",
        version: "1.0.0",
        // base is an implicit dependency and is never declared.
        dependencies: [],
    ),
)
