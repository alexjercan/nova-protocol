// The example mod's content - a guided tour of what a mod can do, in one file.
// A `*.content.ron` is a `[Content]` list; each item is externally tagged by
// kind (`Section((..))` / `Scenario((..))`). One file may freely mix them.
//
// This bundle loads AFTER base (base first, mods in catalog order), so overlay
// is last-wins by id: an item whose id already exists REPLACES it; a fresh id
// ADDS alongside. This file does ten things, in order:
//
//   1. OVERRIDE a base section  - `reinforced_hull_section` (same id -> replace)
//   2. ADD a new section        - `example_plated_hull_section` (new id -> add)
//   3. ADD a playable scenario  - `example_arena` (mod-shipped skybox + rocks,
//                                  a NarrativeCue comms beat, an objective, a
//                                  win check, and Victory/Defeat Outcomes)
//   4. ADD a menu backdrop      - `example_menu` (a `role: Backdrop` scene:
//                                  mods can ship main-menu ambience)
//   5. ADD an item              - `example_survey_core` (cargo the arena's
//                                  player ship starts with)
//   6. ADD a bounded world      - `example_bounds` (the base generator on a
//                                  fixed seed, with a `bounds` sphere whose
//                                  `OnExit` ends the run)
//   7. ADD a hold tour          - `example_prospect` (a berthed trader and an
//                                  ore rock; one objective per hold event:
//                                  `OnTraded`, `OnCreditsChanged`,
//                                  `OnRepaired`, `OnJettisoned`, `OnPickedUp`
//                                  and `OnMined`)
//   8. ADD a survey contact     - `example_survey` (the fixed-seed world
//                                  again; an `OnEnter` marks a GENERATED body
//                                  through `$other_id`, and the mark outlives
//                                  the body's sector)
//   9. ADD a station            - `example_outpost` (a parked hull with a
//                                  collar and a bridge, no drive; what it
//                                  offers, stores and trades)
//  10. ADD a start role         - `example_surveyor` (a New Game start on
//                                  a base hull, its kit carrying this mod's
//                                  survey cores)
//
// Everything here is pure data - no engine changes. For the field-by-field
// syntax behind it see the wiki: "Author a section", "Author a scenario",
// "Make and publish a mod", and "Modding data format (RON)".
[
    // -- 1. SECTION OVERLAY -------------------------------------------------
    // Same id as the base `reinforced_hull_section`, so this REPLACES the base
    // one everywhere it is used (the editor palette, every ship that references
    // the id) - last-wins overlay. Here we up-armor it and rename the label so
    // the override is visible. This is how a mod rebalances or re-skins base
    // content without touching base files.
    Section((
        base: (
            id: "reinforced_hull_section",
            name: "Reinforced Hull Section (Example Mod)",
            description: "Base hull, up-armored by the example mod to show section overlay by id.",
            health: 400.0,
            build: (
                credits: 160,
                parts: {
                    "FrameSpar": 2,
                    "SectionPanel": 6,
                },
                strip_yield: 0.5,
            ),
            link_points: [
                (
                    id: "positive_x",
                    position: (
                        0.5,
                        0.0,
                        0.0,
                    ),
                    normal: (
                        1.0,
                        0.0,
                        0.0,
                    ),
                ),
                (
                    id: "negative_x",
                    position: (
                        -0.5,
                        0.0,
                        0.0,
                    ),
                    normal: (
                        -1.0,
                        0.0,
                        0.0,
                    ),
                ),
                (
                    id: "positive_y",
                    position: (
                        0.0,
                        0.5,
                        0.0,
                    ),
                    normal: (
                        0.0,
                        1.0,
                        0.0,
                    ),
                ),
                (
                    id: "negative_y",
                    position: (
                        0.0,
                        -0.5,
                        0.0,
                    ),
                    normal: (
                        0.0,
                        -1.0,
                        0.0,
                    ),
                ),
                (
                    id: "positive_z",
                    position: (
                        0.0,
                        0.0,
                        0.5,
                    ),
                    normal: (
                        0.0,
                        0.0,
                        1.0,
                    ),
                ),
                (
                    id: "negative_z",
                    position: (
                        0.0,
                        0.0,
                        -0.5,
                    ),
                    normal: (
                        0.0,
                        0.0,
                        -1.0,
                    ),
                ),
            ],
        ),
        kind: Hull((
            render_mesh: Some("dep://base/gltf/hull-01.glb#Scene0"),
        )),
    )),
    // -- 2. NEW SECTION -----------------------------------------------------
    // A fresh id, so this is ADDED alongside the base sections - it shows up in
    // the editor palette and can be bolted onto any ship. The arena ship below
    // uses it, so you can see it in play. `kind: Hull` reuses the base hull mesh
    // via `dep://base/...`; a real mod could point `render_mesh` at its own
    // `self://` model instead.
    //
    // HEALTH is the axis a structural part is tuned on: 500 here, against the
    // 400 of the override above and the base game's 200. A section's mass is
    // its collider volume, so a part built on the unit cell weighs exactly what
    // every other unit cell weighs - toughness is what tells hull apart.
    Section((
        base: (
            id: "example_plated_hull_section",
            name: "Plated Hull Section (Example Mod)",
            description: "A brand-new section the example mod adds: the toughest hull on the board at 500 hp.",
            health: 500.0,
            build: (
                credits: 160,
                parts: {
                    "FrameSpar": 2,
                    "SectionPanel": 6,
                },
                strip_yield: 0.5,
            ),
            link_points: [
                (
                    id: "positive_x",
                    position: (
                        0.5,
                        0.0,
                        0.0,
                    ),
                    normal: (
                        1.0,
                        0.0,
                        0.0,
                    ),
                ),
                (
                    id: "negative_x",
                    position: (
                        -0.5,
                        0.0,
                        0.0,
                    ),
                    normal: (
                        -1.0,
                        0.0,
                        0.0,
                    ),
                ),
                (
                    id: "positive_y",
                    position: (
                        0.0,
                        0.5,
                        0.0,
                    ),
                    normal: (
                        0.0,
                        1.0,
                        0.0,
                    ),
                ),
                (
                    id: "negative_y",
                    position: (
                        0.0,
                        -0.5,
                        0.0,
                    ),
                    normal: (
                        0.0,
                        -1.0,
                        0.0,
                    ),
                ),
                (
                    id: "positive_z",
                    position: (
                        0.0,
                        0.0,
                        0.5,
                    ),
                    normal: (
                        0.0,
                        0.0,
                        1.0,
                    ),
                ),
                (
                    id: "negative_z",
                    position: (
                        0.0,
                        0.0,
                        -0.5,
                    ),
                    normal: (
                        0.0,
                        0.0,
                        -1.0,
                    ),
                ),
            ],
        ),
        kind: Hull((
            render_mesh: Some("dep://base/gltf/hull-01.glb#Scene0"),
        )),
    )),
    // -- 3. PLAYABLE SCENARIO ----------------------------------------------
    // A small, self-contained shooting gallery. Its LOOK is owned by this mod:
    // the skybox is `self://textures/nebula.png`, shipped in this folder and
    // declared in `resources`. `self://` resolves to this mod's own folder
    // whether shipped (`mods/example/...`) or downloaded (`mods://example/...`),
    // so you never hard-code your id. To reuse a BASE-game asset instead, use
    // `dep://base/<path>` (e.g. `dep://base/textures/cubemap.png`); a bare,
    // scheme-less asset path is no longer valid in content.
    Scenario((
        id: "example_arena",
        name: "Example Arena",
        description: "The example mod's playable scenario: destroy two drifting rocks under a mod-shipped skybox.",
        cubemap: "self://textures/nebula.png",
        watches: [
            (
                variable: "scenario_elapsed",
                query: Scenario((property: Elapsed)),
            ),
        ],
        events: [
            (
                name: OnStart,
                filters: [],
                actions: [
                    // The scene's own lighting: the engine spawns no light, so a
                    // scenario that authors none renders black. Standard three-point
                    // key/rim/fill, each aimed at the origin.
                    SpawnScenarioObject((
                        base: (
                            id: "example_key",
                            name: "Key Light",
                            position: (-600.0, 500.0, 600.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Light(Directional(
                            illuminance: 11000.0,
                            color: Srgba((
                                red: 1.0,
                                green: 0.96,
                                blue: 0.9,
                                alpha: 1.0,
                            )),
                            shadows: true,
                            aim: Some((0.0, 0.0, 0.0)),
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "example_rim",
                            name: "Rim Light",
                            position: (300.0, 400.0, -800.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Light(Directional(
                            illuminance: 16000.0,
                            color: Srgba((
                                red: 0.72,
                                green: 0.86,
                                blue: 1.0,
                                alpha: 1.0,
                            )),
                            shadows: false,
                            aim: Some((0.0, 0.0, 0.0)),
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "example_fill",
                            name: "Fill Light",
                            position: (700.0, -200.0, 400.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Light(Directional(
                            illuminance: 2600.0,
                            color: Srgba((
                                red: 0.62,
                                green: 0.72,
                                blue: 0.95,
                                alpha: 1.0,
                            )),
                            shadows: false,
                            aim: Some((0.0, 0.0, 0.0)),
                        )),
                    )),
                    // DebugMessage prints to the log/console - handy while
                    // authoring to confirm your scenario actually loaded.
                    DebugMessage((
                        message: "Example arena loaded from the example mod's overlaid bundle.",
                    )),
                    // NarrativeCue appends a line to the comms panel (speaker +
                    // text). The story log is scenario-scoped: it clears at
                    // teardown, so a line never leaks into the next scenario.
                    NarrativeCue((
                        speaker: "Range Control",
                        text: "Welcome to the range. Two derelicts on the board - clear them at your leisure.",
                    )),
                    // The player ship, assembled from base prototypes PLUS this
                    // mod's own sections: `reinforced_hull_section` is the one we
                    // OVERRODE above, and `example_plated_hull_section` is the
                    // NEW section we added - both ride on this hull.
                    SpawnScenarioObject((
                        base: (
                            id: "player_spaceship",
                            name: "Player Spaceship",
                            position: (0.0, 0.0, 0.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Spaceship((
                            controller: Player((
                                input_mapping: {
                                    "turret": [
                                        Mouse(Left),
                                        Gamepad(RightTrigger2),
                                    ],
                                },
                            )),
                            design: Inline((
                                sections: [
                                    (
                                        id: "controller",
                                        position: (0.0, 0.0, 0.0),
                                        rotation: (0.0, 0.0, 0.0, 1.0),
                                        source: Prototype(id: "basic_controller_section"),
                                    ),
                                    (
                                        id: "hull_front",
                                        position: (0.0, 0.0, 1.0),
                                        rotation: (0.0, 0.0, 0.0, 1.0),
                                        // the OVERRIDDEN base section (id 1 above)
                                        source: Prototype(id: "reinforced_hull_section"),
                                    ),
                                    (
                                        id: "hull_rear",
                                        position: (0.0, 0.0, 2.0),
                                        rotation: (0.0, 0.0, 0.0, 1.0),
                                        // the NEW section this mod adds (id 2 above)
                                        source: Prototype(id: "example_plated_hull_section"),
                                    ),
                                    (
                                        id: "thruster",
                                        position: (0.0, 0.0, 3.0),
                                        rotation: (0.0, 0.0, 0.0, 1.0),
                                        source: Prototype(id: "basic_thruster_section"),
                                    ),
                                    (
                                        id: "turret",
                                        position: (0.0, 0.0, -0.75),
                                        rotation: (-0.70710677, 0.0, 0.0, 0.70710677),
                                        source: Prototype(id: "pdc_kinetic_turret_section"),
                                    ),
                                ],
                            )),
                            initial_velocity: (0.0, 0.0, 0.0),
                            // Two of the item this mod adds (5 below): it
                            // weighs, trades and jettisons like a base item.
                            // Item ids are quoted map keys.
                            inventory: {"example_survey_core": 2},
                            lootable: false,
                            credits: 2_000,
                        )),
                    )),
                    // A lit beacon centrepiece the rocks sit in front of. Purely
                    // visual here - nothing consumes an OnEnter on it, so it
                    // carries no area.
                    SpawnScenarioObject((
                        base: (
                            id: "example_beacon",
                            name: "Range Beacon",
                            position: (0.0, 0.0, -600.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Beacon((
                            label: "RANGE",
                            radius: 20.0,
                            color: Srgba((
                                red: 0.4,
                                green: 0.8,
                                blue: 1.0,
                                alpha: 1.0,
                            )),
                            area_radius: None,
                            lock_signature: None,
                        )),
                    )),
                    // Two destructible targets, textured from THIS mod's own PNG
                    // (`self://textures/rock.png`), not a base texture.
                    //
                    // `kind` is REQUIRED on every asteroid: what the body is
                    // made of, which decides how it is shaded and what a mining
                    // system would get out of it. The base game ships `rock`,
                    // `metal`, `ice`, `carbon`, and `plain` (the control - the
                    // texture with nothing done to it). It does NOT decide what
                    // the rock sounds like when something hits it: every
                    // asteroid is stone to the impact bank, whatever its kind.
                    //
                    // There is no default. Leave `kind` out and the file
                    // does not load; name a kind nobody ships and `content
                    // lint` fails you before it ever runs. That is deliberate:
                    // a typo that quietly turned into grey stone is a typo you
                    // would never find.
                    //
                    // `texture` stays yours. The kind supplies the palette, the
                    // large-scale character and the specular; the texture
                    // supplies the fine crevice grain the kind modulates. They
                    // answer different questions, so a mod keeps its own rock
                    // art and still picks a kind for it.
                    SpawnScenarioObject((
                        base: (
                            id: "example_target_1",
                            name: "Derelict 1",
                            position: (-140.0, 40.0, -450.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Asteroid((
                            // Small size, not hidden health, keeps this tutorial target brief.
                            radius: 2.5,
                            initial_velocity: (0.0, 0.0, 0.0),
                            texture: "self://textures/rock.png",
                            kind: "rock",
                            lock_signature: None,
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "example_target_2",
                            name: "Derelict 2",
                            position: (150.0, -50.0, -600.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Asteroid((
                            radius: 3.0,
                            initial_velocity: (0.0, 0.0, 0.0),
                            texture: "self://textures/rock.png",
                            // The same texture, a different kind. Put this one
                            // beside `example_target_1` in the range and the
                            // pair is the whole feature in one look.
                            kind: "ice",
                            lock_signature: None,
                        )),
                    )),
                    // Win state: `destroyed` counts kills (0..2); `arena_done`
                    // tells the timed beats below that the range is not clear
                    // yet. The win check itself needs no flag - it carries
                    // `once`.
                    VariableSet((
                        key: "destroyed",
                        expression: Term(Factor(Literal(Number(0.0)))),
                    )),
                    VariableSet((
                        key: "arena_done",
                        expression: Term(Factor(Literal(Number(0.0)))),
                    )),
                    // Seeding matters for every variable a filter reads: an
                    // undefined variable fails closed, so an unseeded
                    // `arena_done == 0` gate would never pass and the beat it
                    // guards would never fire.
                    Objective((
                        id: "clear_range",
                        message: "Destroy the two derelict rocks. Aim with the mouse, [Left Mouse] fires.",
                    )),
                    ObjectiveMarkerAttach((
                        target_id: "example_target_1",
                        label: "DERELICT",
                    )),
                    ObjectiveMarkerAttach((
                        target_id: "example_target_2",
                        label: "DERELICT",
                    )),
                ],
            ),
            // One OnDestroyed per target: each kill bumps `destroyed` and drops
            // that target's marker. The filter matches the target's id - the id
            // the integrity bridge fires OnDestroyed under.
            (
                name: OnDestroyed,
                once: true,
                filters: [
                    Entity((
                        id: Some("example_target_1"),
                    )),
                ],
                actions: [
                    VariableSet((
                        key: "destroyed",
                        expression: Add(
                            Factor(Name("destroyed")),
                            Term(Factor(Literal(Number(1.0)))),
                        ),
                    )),
                    ObjectiveMarkerDetach((
                        target_id: "example_target_1",
                    )),
                ],
            ),
            (
                name: OnDestroyed,
                once: true,
                filters: [
                    Entity((
                        id: Some("example_target_2"),
                    )),
                ],
                actions: [
                    VariableSet((
                        key: "destroyed",
                        expression: Add(
                            Factor(Name("destroyed")),
                            Term(Factor(Literal(Number(1.0)))),
                        ),
                    )),
                    ObjectiveMarkerDetach((
                        target_id: "example_target_2",
                    )),
                ],
            ),
            // The win, checked every frame until it fires. `once: true` is
            // what makes it fire exactly once: the handler retires the moment
            // its filters pass, so the beat needs no flag of its own. `> 1`
            // (not `== 2`): if a target ever fired OnDestroyed twice the
            // counter would overshoot and an `== 2` gate would be skipped
            // forever (an uncompletable arena). OnUpdate, not the last
            // OnDestroyed, so it never depends on handler order within one
            // destroy event.
            (
                name: OnUpdate,
                once: true,
                filters: [
                    Expression((GreaterThan(
                        Term(Factor(Name("destroyed"))),
                        Term(Factor(Literal(Number(1.0)))),
                    ))),
                ],
                actions: [
                    VariableSet((
                        key: "arena_done",
                        expression: Term(Factor(Literal(Number(1.0)))),
                    )),
                    ObjectiveComplete((
                        id: "clear_range",
                    )),
                    // Outcome ends the run with a result banner. Victory here;
                    // the player-destroyed handler below ends in Defeat.
                    Outcome((
                        outcome: Victory,
                        message: Some("Range cleared - both derelicts are scrap. Nice shooting: the range is yours."),
                    )),
                ],
            ),
            // TIMED beats, gated on the engine's scenario clock: the
            // reserved `scenario_elapsed` variable counts live, unpaused
            // seconds (the engine ticks it - never write it yourself; the
            // content gate errors on a VariableSet to it). A clock threshold
            // plus `once: true` IS the one-shot; the only filter left is the
            // one about the game (`arena_done == 0` - do not nag a player who
            // already finished). A repeating wave is the same shape WITHOUT
            // `once`, gating on `elapsed > next_at` and rearming `next_at` in
            // the action.
            //
            // Beat one: a friendly nudge if the range is not clear by 25s.
            (
                name: OnUpdate,
                once: true,
                filters: [
                    Expression((GreaterThan(
                        Term(Factor(Name("scenario_elapsed"))),
                        Term(Factor(Literal(Number(25.0)))),
                    ))),
                    Expression((Equal(
                        Term(Factor(Name("arena_done"))),
                        Term(Factor(Literal(Number(0.0)))),
                    ))),
                ],
                actions: [
                    NarrativeCue((
                        speaker: "Range Control",
                        text: "Clock's running. Put your reticle on a derelict and hold the trigger.",
                    )),
                ],
            ),
            // Beat two: at 45s a third derelict drifts onto the range -
            // a timed spawn (bonus target; the win still needs only the
            // first two).
            (
                name: OnUpdate,
                once: true,
                filters: [
                    Expression((GreaterThan(
                        Term(Factor(Name("scenario_elapsed"))),
                        Term(Factor(Literal(Number(45.0)))),
                    ))),
                    Expression((Equal(
                        Term(Factor(Name("arena_done"))),
                        Term(Factor(Literal(Number(0.0)))),
                    ))),
                ],
                actions: [
                    // `accent` is the colour the whole comms card is drawn in:
                    // its frame, its speaker line, its icon tile, and - lifted
                    // toward white - the words. Omit it and the line is drawn
                    // in the ordinary comms blue, which is what the two cues
                    // above do. Named here so the late contact reads as a
                    // different voice from range control's own traffic.
                    NarrativeCue((
                        speaker: "Range Control",
                        text: "Late contact drifting onto the range - bonus target if you want it.",
                        accent: LinearRgba((
                            red: 1.0,
                            green: 0.55,
                            blue: 0.2,
                            alpha: 1.0,
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "example_target_3",
                            name: "Late Drifter",
                            position: (600.0, 150.0, -1400.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Asteroid((
                            radius: 20.0,
                            initial_velocity: (0.0, 0.0, 0.0),
                            texture: "self://textures/rock.png",
                            // Nickel-iron: the rare one, so the bonus target is
                            // worth flying out to.
                            kind: "metal",
                            lock_signature: None,
                        )),
                    )),
                ],
            ),
            // Lose condition: if the player's ship is destroyed, end in Defeat.
            (
                name: OnDestroyed,
                once: true,
                filters: [
                    Entity((
                        id: Some("player_spaceship"),
                    )),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("Your ship broke apart on the range."),
                    )),
                ],
            ),
        ],
    )),
    // -- 4. MENU BACKDROP ---------------------------------------------------
    // A scenario declaring `role: Backdrop` can drive the main-menu ambience:
    // mods can ship their own menu scene, not just playable levels. The role is
    // also what keeps it out of the player-facing Scenarios picker (it is menu
    // dressing, not a level you launch) - a scenario with no `role` is a
    // `Chapter`, which is a picker row. It renders under this mod's own skybox
    // and uses this mod's own rock texture, all via `self://`.
    Scenario((
        id: "example_menu",
        name: "Example Menu Backdrop",
        description: "A menu-ambience scene shipped by the example mod, under its own skybox.",
        cubemap: "self://textures/nebula.png",
        role: Backdrop,
        events: [
            (
                name: OnStart,
                filters: [],
                actions: [
                    // The backdrop camera contract: every menu backdrop poses
                    // its OWN camera with a SetCamera (a backdrop without one
                    // is a content Error and never enters the menu rotation).
                    // The authored position IS the framing.
                    SetCamera((
                        position: (0.0, 1000.0, 3350.0),
                        look_at: (0.0, 0.0, 0.0),
                    )),
                    // The backdrop lights itself, like every shipped menu scene.
                    SpawnScenarioObject((
                        base: (
                            id: "example_menu_key",
                            name: "Key Light",
                            position: (-1200.0, 1000.0, 1200.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Light(Directional(
                            illuminance: 11000.0,
                            color: Srgba((
                                red: 1.0,
                                green: 0.96,
                                blue: 0.9,
                                alpha: 1.0,
                            )),
                            shadows: true,
                            aim: Some((0.0, 0.0, 0.0)),
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "example_menu_rim",
                            name: "Rim Light",
                            position: (600.0, 800.0, -1600.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Light(Directional(
                            illuminance: 16000.0,
                            color: Srgba((
                                red: 0.72,
                                green: 0.86,
                                blue: 1.0,
                                alpha: 1.0,
                            )),
                            shadows: false,
                            aim: Some((0.0, 0.0, 0.0)),
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "example_menu_fill",
                            name: "Fill Light",
                            position: (1400.0, -400.0, 800.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Light(Directional(
                            illuminance: 2600.0,
                            color: Srgba((
                                red: 0.62,
                                green: 0.72,
                                blue: 0.95,
                                alpha: 1.0,
                            )),
                            shadows: false,
                            aim: Some((0.0, 0.0, 0.0)),
                        )),
                    )),
                    // A temperate planetoid to anchor the view, plus
                    // an AI ship set to orbit it - calm motion, nothing to
                    // fight. The orbit directive names the well by its id.
                    SpawnScenarioObject((
                        base: (
                            id: "menu_planetoid",
                            name: "Planetoid",
                            position: (0.0, 0.0, 0.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Planet((
                            radius: 450.0,
                            planet_type: Temperate,
                            seed: 1729727263,
                            mass: 36_000.0,
                            lock_signature: None,
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "example_menu_orbiter",
                            name: "Orbiter",
                            position: (1300.0, 0.0, 0.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Spaceship((
                            controller: AI((
                                orbit: Some(Authored("menu_planetoid")),
                            )),
                            design: Inline((
                                sections: [
                                    (
                                        id: "controller",
                                        position: (0.0, 0.0, 0.0),
                                        rotation: (0.0, 0.0, 0.0, 1.0),
                                        source: Prototype(id: "basic_controller_section"),
                                    ),
                                    (
                                        id: "hull_front",
                                        position: (0.0, 0.0, 1.0),
                                        rotation: (0.0, 0.0, 0.0, 1.0),
                                        source: Prototype(id: "reinforced_hull_section"),
                                    ),
                                    (
                                        id: "thruster",
                                        position: (0.0, 0.0, 2.0),
                                        rotation: (0.0, 0.0, 0.0, 1.0),
                                        source: Prototype(id: "basic_thruster_section"),
                                    ),
                                ],
                            )),
                            initial_velocity: (0.0, 0.0, 0.0),
                            inventory: {},
                            lootable: false,
                            credits: 2_000,
                        )),
                    )),
                    // The act length: an orbit never ends on its own, so the
                    // scene times itself out like the base endless backdrops.
                    TimerStart((
                        key: "example_menu_rotate",
                        seconds: Term(Factor(Literal(Number(150.0)))),
                    )),
                ],
            ),
            // The rotation contract: a backdrop reports its act finished with
            // BackdropDone and the MENU picks what plays next. A backdrop
            // that never reports is a content Error, and one that names its
            // own successor with NextScenario is too.
            (
                name: OnTimerEnd,
                filters: [
                    Timer((
                        key: "example_menu_rotate",
                    )),
                ],
                actions: [
                    BackdropDone(()),
                ],
            ),
        ],
    )),
    // -- 5. ITEM ---------------------------------------------------------------
    // A NEW item id, so it ADDS to the catalog. Any ship stock, canister or
    // trade may carry it. Every field is required: `mass_g` above 0 grams, and
    // `bid_cr` (what a Sell earns) at most `ask_cr` (what a Buy pays). The ten
    // ids the game itself uses - "HullPlate", the ammunition, the ores,
    // "Rations" and "SalvagedParts" - belong to base. A mod may replace one
    // whole, with its own mass and prices but the same category, because base
    // is a dependency of every mod.
    Item((
        id: "example_survey_core",
        name: "Survey core",
        about: "A sealed sensor core from the example mod. Traders buy and sell it.",
        category: Parts,
        mass_g: 5000,
        ask_cr: 60,
        bid_cr: 45,
    )),
    // -- 6. BOUNDED GENERATED WORLD -----------------------------------------
    // `world: Generated((seed: Some(n), bounds: Some(..)))` runs the base
    // world generator on a FIXED seed, so the same sectors stream in every
    // time around the ONE player ship OnStart spawns (lint refuses zero or
    // two). The Scenarios list offers it like any chapter; it saves no world.
    //
    // `bounds` is a sphere in meters the player is meant to stay in. The
    // loader spawns it as the scenario area `bounds` before OnStart runs, so
    // leaving it is an ordinary `OnExit` with `id: "bounds"` and the outcome
    // is YOURS to author: the engine ends nothing on its own, and the world
    // keeps streaming past the edge. A `bounds` no OnExit reads is a lint
    // warning; a handler spawning its own `bounds` object is a lint error.
    // The radius may not exceed 80,000 m, the half edge of the streamed
    // window.
    Scenario((
        id: "example_bounds",
        name: "Example Bounded Range",
        description: "A fixed-seed slice of the generated world: stay within 2 km of your start or the range closes.",
        cubemap: "self://textures/nebula.png",
        world: Generated((
            seed: Some(1701),
            bounds: Some((
                position: (0.0, 0.0, 0.0),
                radius: 2000.0,
            )),
        )),
        events: [
            (
                name: OnStart,
                filters: [],
                actions: [
                    SpawnScenarioObject((
                        base: (
                            id: "example_bounds_key",
                            name: "Key Light",
                            position: (-600.0, 500.0, 600.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Light(Directional(
                            illuminance: 11000.0,
                            color: Srgba((
                                red: 1.0,
                                green: 0.96,
                                blue: 0.9,
                                alpha: 1.0,
                            )),
                            shadows: true,
                            aim: Some((0.0, 0.0, 0.0)),
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "example_bounds_fill",
                            name: "Fill Light",
                            position: (700.0, -200.0, 400.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Light(Directional(
                            illuminance: 2600.0,
                            color: Srgba((
                                red: 0.62,
                                green: 0.72,
                                blue: 0.95,
                                alpha: 1.0,
                            )),
                            shadows: false,
                            aim: Some((0.0, 0.0, 0.0)),
                        )),
                    )),
                    DebugMessage((
                        message: "Example bounded range loaded: fixed seed 1701, bounds 2 km.",
                    )),
                    NarrativeCue((
                        speaker: "Range Control",
                        text: "Fixed-seed slice. Stay within two kilometres of your start - the sensor is live.",
                    )),
                    // Seeded so the OnExit handler's counter has a number to
                    // add to; an undefined variable fails closed.
                    VariableSet((
                        key: "bounds_exits",
                        expression: Term(Factor(Literal(Number(0.0)))),
                    )),
                    Objective((
                        id: "hold_the_bounds",
                        message: "Stay within 2 km of your start.",
                    )),
                    // The one player ship a generated world streams around:
                    // the arena's hull, with no cargo this time.
                    SpawnScenarioObject((
                        base: (
                            id: "player_spaceship",
                            name: "Player Spaceship",
                            position: (0.0, 0.0, 0.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Spaceship((
                            controller: Player((
                                input_mapping: {
                                    "turret": [
                                        Mouse(Left),
                                        Gamepad(RightTrigger2),
                                    ],
                                },
                            )),
                            design: Inline((
                                sections: [
                                    (
                                        id: "controller",
                                        position: (0.0, 0.0, 0.0),
                                        rotation: (0.0, 0.0, 0.0, 1.0),
                                        source: Prototype(id: "basic_controller_section"),
                                    ),
                                    (
                                        id: "hull_front",
                                        position: (0.0, 0.0, 1.0),
                                        rotation: (0.0, 0.0, 0.0, 1.0),
                                        source: Prototype(id: "reinforced_hull_section"),
                                    ),
                                    (
                                        id: "hull_rear",
                                        position: (0.0, 0.0, 2.0),
                                        rotation: (0.0, 0.0, 0.0, 1.0),
                                        source: Prototype(id: "example_plated_hull_section"),
                                    ),
                                    (
                                        id: "thruster",
                                        position: (0.0, 0.0, 3.0),
                                        rotation: (0.0, 0.0, 0.0, 1.0),
                                        source: Prototype(id: "basic_thruster_section"),
                                    ),
                                    (
                                        id: "turret",
                                        position: (0.0, 0.0, -0.75),
                                        rotation: (-0.70710677, 0.0, 0.0, 0.70710677),
                                        source: Prototype(id: "pdc_kinetic_turret_section"),
                                    ),
                                ],
                            )),
                            initial_velocity: (0.0, 0.0, 0.0),
                            inventory: {},
                            lootable: false,
                            credits: 2_000,
                        )),
                    )),
                ],
            ),
            // Leaving the bounds. `id` is the area the `bounds` block spawned;
            // `other_id` pins it to the player, because a generated derelict
            // drifting out raises the same event under its own id. No `once`:
            // the counter is the proof the sensor fires exactly one exit.
            (
                name: OnExit,
                filters: [
                    Entity((
                        id: Some("bounds"),
                        other_id: Some("player_spaceship"),
                    )),
                ],
                actions: [
                    VariableSet((
                        key: "bounds_exits",
                        expression: Add(
                            Factor(Name("bounds_exits")),
                            Term(Factor(Literal(Number(1.0)))),
                        ),
                    )),
                    // The overlay's message is the whole beat: a cue beside
                    // an Outcome is never read (lint warns).
                    Outcome((
                        outcome: Defeat,
                        message: Some("You crossed the line. Range closed."),
                    )),
                ],
            ),
            (
                name: OnDestroyed,
                once: true,
                filters: [
                    Entity((
                        id: Some("player_spaceship"),
                    )),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("Your ship broke apart on the range."),
                    )),
                ],
            ),
        ],
    )),
    // -- 7. HOLD TOUR -------------------------------------------------------
    // Six events report what a ship's hold and balance do, each from the
    // system that owns the change and each exactly once per occurrence:
    //   OnTraded         - a Buy or Sell went through (`id` = the trader,
    //                      `other_id` = the ship that traded; `trade`, `item`,
    //                      `count`, `price_cr`)
    //   OnCreditsChanged - one ship's balance moved (`id` = that ship;
    //                      `previous_cr`, `current_cr`, `delta_cr`, `cause`).
    //                      A trade raises one per party, so filter on `id`.
    //   OnRepaired       - a Ship pane repair spent plates (`id` = the ship;
    //                      `section` = the pane code, `item`, `count`)
    //   OnJettisoned     - the intake dropped a canister (`id` = the ship;
    //                      `canister`, `item`, `count`), one per stack
    //   OnPickedUp       - the intake took a canister (same payload)
    //   OnMined          - a beam pulse carved ore (`id` = the rock,
    //                      `other_id` = the miner; `item`, `count`)
    // The player starts berthed beside a trader with its starboard collar 5 m
    // off the trader's port collar, so DOCK takes at once, and an ore rock
    // stands dead ahead of the bow emitter. Each handler completes one
    // objective and counts toward the Victory.
    Scenario((
        id: "example_prospect",
        name: "Example Prospect Berth",
        description: "Trade, repair, jettison, pick up and mine from a berth: one objective per hold event.",
        cubemap: "self://textures/nebula.png",
        events: [
            (
                name: OnStart,
                filters: [],
                actions: [
                    SpawnScenarioObject((
                        base: (
                            id: "example_prospect_key",
                            name: "Key Light",
                            position: (-600.0, 500.0, 600.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Light(Directional(
                            illuminance: 11000.0,
                            color: Srgba((
                                red: 1.0,
                                green: 0.96,
                                blue: 0.9,
                                alpha: 1.0,
                            )),
                            shadows: true,
                            aim: Some((0.0, 0.0, 0.0)),
                        )),
                    )),
                    DebugMessage((
                        message: "Example prospect berth loaded: a trader alongside, an ore rock ahead.",
                    )),
                    NarrativeCue((
                        speaker: "Berth Control",
                        text: "Dock with the tender, trade and patch up. Then jettison, take the canister back and cut some ore.",
                    )),
                    // Seeded so the handlers' counter has a number to add to.
                    VariableSet((
                        key: "prospect_done",
                        expression: Term(Factor(Literal(Number(0.0)))),
                    )),
                    Objective((
                        id: "prospect_trade",
                        message: "Buy rations from the tender.",
                    )),
                    Objective((
                        id: "prospect_credits",
                        message: "Spend or earn credits.",
                    )),
                    Objective((
                        id: "prospect_repair",
                        message: "Repair a section with hull plates.",
                    )),
                    Objective((
                        id: "prospect_jettison",
                        message: "Jettison cargo through the intake.",
                    )),
                    Objective((
                        id: "prospect_pickup",
                        message: "Take a canister aboard.",
                    )),
                    Objective((
                        id: "prospect_mine",
                        message: "Cut ore from the rock ahead. [V] fires the beam.",
                    )),
                    // The shipped mining tug: a mining emitter on a bow boom,
                    // a cargo intake on the aft deck and a port collar. Two
                    // hull plates to repair with, and credits to buy with.
                    SpawnScenarioObject((
                        base: (
                            id: "player_spaceship",
                            name: "Player Spaceship",
                            position: (0.0, 0.0, 0.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Spaceship((
                            design: Prototype(
                                id: "mining_tug",
                            ),
                            controller: Player((
                                input_mapping: {
                                    "mining_beam": [
                                        Keyboard(KeyV),
                                    ],
                                },
                            )),
                            initial_velocity: (0.0, 0.0, 0.0),
                            inventory: {"HullPlate": 2},
                            lootable: false,
                            credits: 500,
                        )),
                    )),
                    // The tender alongside to port, turned end for end: its
                    // port collar faces the tug's port collar across a 5 m
                    // gap, inside the 10 m capture distance. Not lootable and
                    // holding credits, so the pane offers Buy and Sell, not
                    // Take.
                    SpawnScenarioObject((
                        base: (
                            id: "example_tender",
                            name: "Supply Tender",
                            position: (-55.0, 0.0, -30.0),
                            rotation: (0.0, 1.0, 0.0, 0.0),
                        ),
                        kind: Spaceship((
                            design: Prototype(
                                id: "light_freighter",
                            ),
                            controller: None,
                            initial_velocity: (0.0, 0.0, 0.0),
                            allegiance: Some(Neutral),
                            inventory: {"Rations": 4},
                            lootable: false,
                            credits: 1000,
                        )),
                    )),
                    // An ore rock dead ahead of the bow emitter, 165 m out,
                    // pinned to one silhouette so its near face stays in
                    // reach.
                    SpawnScenarioObject((
                        base: (
                            id: "example_ore_rock",
                            name: "Ore Rock",
                            position: (0.0, 0.0, -225.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Asteroid((
                            radius: 25.0,
                            initial_velocity: (0.0, 0.0, 0.0),
                            texture: "self://textures/rock.png",
                            kind: "rock",
                            lock_signature: None,
                            seed: Some(7),
                        )),
                    )),
                ],
            ),
            // One handler per hold event. Each is `once`, so each adds one to
            // the counter however many times its event fires after that.
            (
                name: OnTraded,
                once: true,
                filters: [
                    Entity((
                        id: Some("example_tender"),
                        other_id: Some("player_spaceship"),
                    )),
                ],
                actions: [
                    ObjectiveComplete((
                        id: "prospect_trade",
                    )),
                    VariableSet((
                        key: "prospect_done",
                        expression: Add(
                            Factor(Name("prospect_done")),
                            Term(Factor(Literal(Number(1.0)))),
                        ),
                    )),
                ],
            ),
            // The trade moves the tender's balance too; `id` keeps this to
            // the player's.
            (
                name: OnCreditsChanged,
                once: true,
                filters: [
                    Entity((
                        id: Some("player_spaceship"),
                    )),
                ],
                actions: [
                    ObjectiveComplete((
                        id: "prospect_credits",
                    )),
                    VariableSet((
                        key: "prospect_done",
                        expression: Add(
                            Factor(Name("prospect_done")),
                            Term(Factor(Literal(Number(1.0)))),
                        ),
                    )),
                ],
            ),
            (
                name: OnRepaired,
                once: true,
                filters: [
                    Entity((
                        id: Some("player_spaceship"),
                    )),
                ],
                actions: [
                    ObjectiveComplete((
                        id: "prospect_repair",
                    )),
                    VariableSet((
                        key: "prospect_done",
                        expression: Add(
                            Factor(Name("prospect_done")),
                            Term(Factor(Literal(Number(1.0)))),
                        ),
                    )),
                ],
            ),
            (
                name: OnJettisoned,
                once: true,
                filters: [
                    Entity((
                        id: Some("player_spaceship"),
                    )),
                ],
                actions: [
                    ObjectiveComplete((
                        id: "prospect_jettison",
                    )),
                    VariableSet((
                        key: "prospect_done",
                        expression: Add(
                            Factor(Name("prospect_done")),
                            Term(Factor(Literal(Number(1.0)))),
                        ),
                    )),
                ],
            ),
            (
                name: OnPickedUp,
                once: true,
                filters: [
                    Entity((
                        id: Some("player_spaceship"),
                    )),
                ],
                actions: [
                    ObjectiveComplete((
                        id: "prospect_pickup",
                    )),
                    VariableSet((
                        key: "prospect_done",
                        expression: Add(
                            Factor(Name("prospect_done")),
                            Term(Factor(Literal(Number(1.0)))),
                        ),
                    )),
                ],
            ),
            // The rock is the subject and the miner the other party, so a
            // second miner on the same rock would not complete this.
            (
                name: OnMined,
                once: true,
                filters: [
                    Entity((
                        id: Some("example_ore_rock"),
                        other_id: Some("player_spaceship"),
                    )),
                ],
                actions: [
                    ObjectiveComplete((
                        id: "prospect_mine",
                    )),
                    VariableSet((
                        key: "prospect_done",
                        expression: Add(
                            Factor(Name("prospect_done")),
                            Term(Factor(Literal(Number(1.0)))),
                        ),
                    )),
                ],
            ),
            // All six done: the tour is over.
            (
                name: OnUpdate,
                once: true,
                filters: [
                    Expression((GreaterThan(
                        Term(Factor(Name("prospect_done"))),
                        Term(Factor(Literal(Number(5.0)))),
                    ))),
                ],
                actions: [
                    Outcome((
                        outcome: Victory,
                        message: Some("Hold tour complete: traded, patched, dropped, taken and mined."),
                    )),
                ],
            ),
            (
                name: OnDestroyed,
                once: true,
                filters: [
                    Entity((
                        id: Some("player_spaceship"),
                    )),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("Your ship broke apart at the berth."),
                    )),
                ],
            ),
        ],
    )),
    // -- 8. SURVEY CONTACT: a marker on a GENERATED body ---------------------
    // The same fixed-seed world as `example_bounds`, unbounded, with a survey
    // sphere 64 km out in the -X face of the streamed window. Whatever drifts
    // into it is a body the world generator placed - a rock, a derelict - and
    // its id (`sector_n2_0_0_background_rock_3`) is minted at runtime, so no
    // handler can write it: lint refuses the literal. The `OnEnter` handler
    // marks it anyway, by binding `$other_id` from the event payload. The
    // scenario remembers the mark by that id, so when the body's sector
    // retires behind the player and thaws on the way back, the chip is on
    // the body again.
    Scenario((
        id: "example_survey",
        name: "Example Survey Contact",
        description: "A fixed-seed slice of the generated world: the first body to drift into the survey sphere wears a marker chip that outlives its sector.",
        cubemap: "self://textures/nebula.png",
        world: Generated((
            seed: Some(1701),
            bounds: None,
        )),
        events: [
            (
                name: OnStart,
                filters: [],
                actions: [
                    SpawnScenarioObject((
                        base: (
                            id: "example_survey_key",
                            name: "Key Light",
                            position: (-600.0, 500.0, 600.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Light(Directional(
                            illuminance: 11000.0,
                            color: Srgba((
                                red: 1.0,
                                green: 0.96,
                                blue: 0.9,
                                alpha: 1.0,
                            )),
                            shadows: true,
                            aim: Some((0.0, 0.0, 0.0)),
                        )),
                    )),
                    VariableSet((
                        key: "contacts",
                        expression: Term(Factor(Literal(Number(0.0)))),
                    )),
                    Objective((
                        id: "survey_contact",
                        message: "Mark the first contact in the survey sphere.",
                    )),
                    // Inside sector (-2, 0, 0): the face a one-cell burn along
                    // +X retires, and the return brings back.
                    CreateScenarioArea((
                        id: "survey",
                        name: "Survey Sphere",
                        position: (-64000.0, 0.0, 12000.0),
                        rotation: (0.0, 0.0, 0.0, 1.0),
                        radius: 1000.0,
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "player_spaceship",
                            name: "Player Spaceship",
                            position: (0.0, 0.0, 0.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Spaceship((
                            controller: Player((
                                input_mapping: {
                                    "turret": [
                                        Mouse(Left),
                                        Gamepad(RightTrigger2),
                                    ],
                                },
                            )),
                            design: Inline((
                                sections: [
                                    (
                                        id: "controller",
                                        position: (0.0, 0.0, 0.0),
                                        rotation: (0.0, 0.0, 0.0, 1.0),
                                        source: Prototype(id: "basic_controller_section"),
                                    ),
                                    (
                                        id: "hull_front",
                                        position: (0.0, 0.0, 1.0),
                                        rotation: (0.0, 0.0, 0.0, 1.0),
                                        source: Prototype(id: "reinforced_hull_section"),
                                    ),
                                    (
                                        id: "hull_rear",
                                        position: (0.0, 0.0, 2.0),
                                        rotation: (0.0, 0.0, 0.0, 1.0),
                                        source: Prototype(id: "example_plated_hull_section"),
                                    ),
                                    (
                                        id: "thruster",
                                        position: (0.0, 0.0, 3.0),
                                        rotation: (0.0, 0.0, 0.0, 1.0),
                                        source: Prototype(id: "basic_thruster_section"),
                                    ),
                                    (
                                        id: "turret",
                                        position: (0.0, 0.0, -0.75),
                                        rotation: (-0.70710677, 0.0, 0.0, 0.70710677),
                                        source: Prototype(id: "pdc_kinetic_turret_section"),
                                    ),
                                ],
                            )),
                            initial_velocity: (0.0, 0.0, 0.0),
                            inventory: {},
                            lootable: false,
                            credits: 2_000,
                        )),
                    )),
                ],
            ),
            // The first body into the sphere. `$other_id` is the entering
            // body's id, read from the payload; a literal generated id in
            // its place fails lint. `once`, so the thaw of a marked body
            // standing in the sphere re-fires nothing: the chip it comes
            // back with is the remembered mark.
            (
                name: OnEnter,
                once: true,
                filters: [
                    Entity((
                        id: Some("survey"),
                    )),
                ],
                actions: [
                    ObjectiveMarkerAttach((
                        target_id: "$other_id",
                        label: "CONTACT",
                    )),
                    VariableSet((
                        key: "contacts",
                        expression: Add(
                            Factor(Name("contacts")),
                            Term(Factor(Literal(Number(1.0)))),
                        ),
                    )),
                    ObjectiveComplete((id: "survey_contact")),
                ],
            ),
            (
                name: OnDestroyed,
                once: true,
                filters: [
                    Entity((
                        id: Some("player_spaceship"),
                    )),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("Survey ship lost."),
                    )),
                ],
            ),
        ],
    )),
    // -- 9. STATION ---------------------------------------------------------
    // A `Station` is a hull that never flies: a docking port, a flight
    // computer and plating, NO thruster (lint refuses one), authored once and
    // spawned by id with `kind: Station((design: Prototype("example_outpost"),
    // ..))`. `design` holds the station, and every field is required.
    // `services` is the closed set Rebuild, Refit, Trade, Storage, Jobs,
    // Roster; at least one, each once. `storage_cap_g`
    // is above zero exactly when Storage is listed. `stock` seeds the hull's
    // own hold (four plates here = 400 kg) and `credits` is what it trades
    // with. The hull takes the same fields a `Ship` design does, and on a
    // station `integrity: (collapse_threshold: ..)` is required: the share of
    // the hull pool below which it takes no more damage. This one is four of
    // this mod's plates, a bridge on top and a collar off the -X flank, built
    // from base prototypes.
    Station((
        id: "example_outpost",
        name: "Outpost (Example Mod)",
        about: "A four-plate block with a bridge and one collar. Dock to trade survey cores and leave cargo in its store.",
        design: (
            hull: (
                sections: [
                    (
                        id: "plate_0",
                        position: (0.0, 0.0, 0.0),
                        rotation: (0.0, 0.0, 0.0, 1.0),
                        source: Prototype(id: "reinforced_hull_section"),
                    ),
                    (
                        id: "plate_1",
                        position: (1.0, 0.0, 0.0),
                        rotation: (0.0, 0.0, 0.0, 1.0),
                        source: Prototype(id: "reinforced_hull_section"),
                    ),
                    (
                        id: "plate_2",
                        position: (0.0, 0.0, 1.0),
                        rotation: (0.0, 0.0, 0.0, 1.0),
                        source: Prototype(id: "reinforced_hull_section"),
                    ),
                    (
                        id: "plate_3",
                        position: (1.0, 0.0, 1.0),
                        rotation: (0.0, 0.0, 0.0, 1.0),
                        source: Prototype(id: "reinforced_hull_section"),
                    ),
                    (
                        id: "bridge",
                        position: (0.0, 1.0, 0.0),
                        rotation: (0.0, 0.0, 0.0, 1.0),
                        source: Prototype(id: "basic_controller_section"),
                    ),
                    (
                        id: "collar",
                        position: (-1.0, 0.0, 0.0),
                        rotation: (0.0, 0.70710677, 0.0, 0.70710677),
                        source: Prototype(id: "docking_port_section"),
                    ),
                ],
                integrity: (collapse_threshold: Some(0.5)),
            ),
            services: [Trade, Storage],
            storage_cap_g: 50000,
            stock: {"example_survey_core": 4},
            credits: 1000,
        ),
    )),
    // -- 10. START ROLE -----------------------------------------------------
    // A `StartRole` is one row in the New Game wizard's role list: the catalog
    // hull the player starts in, a kit of credits and items, the job mix its
    // boards lean to and its one end goal. Every field is required; `goal` is
    // `None` only for a role whose goal has not been authored, and then the
    // Map shows no CHARTER block. `hull` must name a ship design a loaded
    // bundle declares (here the base `light_freighter`), every kit item must
    // be in the item catalog, the kit must fit the hull's hold, and a goal
    // must ask for counts above zero and no more rings than stations or
    // hulls: lint refuses each failure. The wizard derives the weapon keys
    // from the hull's sections, so a role binds nothing itself.
    StartRole((
        id: "example_surveyor",
        name: "Surveyor (Example Mod)",
        about: "A light freighter with a hold of survey cores and no weapons. Sell the cores and buy what the stations need.",
        hull: "light_freighter",
        kit: (
            credits: 1500,
            stock: {"example_survey_core": 10, "Rations": 20},
        ),
        jobs: Trade,
        goal: Some((
            title: "A survey network",
            kind: StationNetwork(jobs: 4, stations: 2, rings: 1),
        )),
        lore: "Survey crews map the rock fields and sell the data cores to any station that pays.",
    )),
]
