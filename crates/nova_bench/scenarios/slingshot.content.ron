                        ),
                        kind: Planet((
                            radius: 700.0,
                            planet_type: BarrenRock,
                            seed: 20260912,
                            mass: Some(50000.0),
                            invulnerable: true,
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "needle",
                            name: "The Needle",
