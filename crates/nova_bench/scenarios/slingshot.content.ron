// A loose agent-bench sandbox for gravity-assist and pursuit experiments.
// It is not installed as game content. Run it with:
//   cargo run --features debug bench play crates/nova_bench/scenarios/slingshot.content.ron \
//       --agent pi --seed 7 --ticks 25000 --deadline 1000 --goal "..."
//
// The player faces -Z. Kestrel is offset to starboard of the direct route to
// EXIT, so a close pass can bend the ship back toward the mark. The pursuer
// wakes after 45 seconds. There is no victory: the goal and final score state
// are the judge, while player destruction remains a definite loss.
[
    Scenario((
        id: "bench_slingshot",
        name: "Bench: Slingshot",
        description: "A gravity-assist course past Kestrel, with a late pursuer and a distant exit mark.",
        cubemap: "base/textures/cubemap.png",
        events: [
            (
                name: OnStart,
                actions: [
                    SpawnScenarioObject((
                        base: (
                            id: "key_light",
                            name: "Key Light",
                            position: (-1500.0, 1800.0, -3500.0),
                            rotation: (-0.24307884, -0.36920026, -0.10068656, 0.8913283),
                        ),
                        kind: Light(Directional(
                            illuminance: 11000.0,
                            color: Srgba((red: 1.0, green: 0.96, blue: 0.9, alpha: 1.0)),
                            shadows: true,
                        )),
                    )),
                    SpawnScenarioObject((
