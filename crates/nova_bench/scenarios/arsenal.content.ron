// A loose agent-bench sandbox for weapon, carving, shell, cheat and abuse
// experiments. It is not installed as game content. Run it with:
//   cargo run --features debug bench play crates/nova_bench/scenarios/arsenal.content.ron \
//       --agent pi --seed 7 --ticks 25000 --deadline 1000 --goal "..."
//
// The player hull is authored inline here, out of base prototypes, so the bench
// owns its own fixture: a railgun spine, a Serpent bay to port, a Lance bay to
// starboard and two point-defense mounts. Quarry is directly ahead, between the
// player and the inert target barge, so a railgun can cut it without a combat
// lock. The hostile wakes after one minute. No goal is built in: audit.jsonl,
// score.json and recorded footage are the evidence.
[
    Scenario((
        id: "bench_arsenal",
        name: "Bench: Arsenal",
        description: "A mixed-weapon demolition yard with a carvable rock, inert hulks, a late hostile and full NOVA OS access.",
        cubemap: "base/textures/cubemap.png",
        events: [
            (
                name: OnStart,
                actions: [
                    SpawnScenarioObject((
                        base: (
                            id: "key_light",
