// The bench's hunt: one player gunship and one hostile raider parked ahead on
// the burn line, with an objective and an outcome so the referee has a
// verdict to score. Loaded loose, never installed:
//   cargo run --features debug bench play crates/nova_bench/scenarios/hunt.content.ron
// The raider holds station under a short engage grace, then fights. Every
// mount has its own free key, so `section.<id>` presses one mount and never
// its neighbour.
[
    Scenario((
        id: "bench_hunt",
        name: "Bench: Hunt",
        description: "Destroy the raider on the burn line.",
        // A loose file registers no `dep://` source; the base pack's cubemap
        // is reachable over the default asset root instead.
        cubemap: "base/textures/cubemap.png",
        events: [
            (
                name: OnStart,
                actions: [
                    Objective((
                        id: "hunt",
                        message: "Destroy the raider ahead.",
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "player",
                            name: "Bench Gunship",
                            position: (0.0, 0.0, 0.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Spaceship((
                            design: Prototype(id: "block_gunship"),
                            controller: Player((
                                input_mapping: {
                                    "pdc_forward_port": [Keyboard(KeyU)],
                                    "pdc_forward_starboard": [Keyboard(KeyI)],
                                    "pdc_aft_port": [Keyboard(KeyJ)],
                                    "pdc_aft_starboard": [Keyboard(KeyK)],
                                    "pdc_ventral_port": [Keyboard(KeyN)],
                                    "pdc_ventral_starboard": [Keyboard(KeyM)],
                                },
                            )),
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "raider",
                            name: "Bench Raider",
                            position: (0.0, 0.0, -2600.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Spaceship((
                            design: Inline((
                                sections: [
                                    (id: "hull_0", position: (-1.0, 0.0, -2.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_1", position: (-1.0, 0.0, -1.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_2", position: (-1.0, 0.0, 0.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_3", position: (-1.0, 0.0, 1.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_4", position: (-1.0, 0.0, 2.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_5", position: (0.0, 0.0, -2.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_6", position: (0.0, 0.0, -1.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_7", position: (0.0, 0.0, 0.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_8", position: (0.0, 0.0, 1.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_9", position: (0.0, 0.0, 2.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_10", position: (1.0, 0.0, -2.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_11", position: (1.0, 0.0, -1.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_12", position: (1.0, 0.0, 0.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_13", position: (1.0, 0.0, 1.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_14", position: (1.0, 0.0, 2.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_15", position: (-1.0, 1.0, -2.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_16", position: (-1.0, 1.0, -1.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_17", position: (-1.0, 1.0, 0.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_18", position: (0.0, 1.0, -1.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_19", position: (0.0, 1.0, 0.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_20", position: (1.0, 1.0, -2.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_21", position: (1.0, 1.0, -1.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_22", position: (1.0, 1.0, 0.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_23", position: (-2.0, 0.0, -1.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_24", position: (-2.0, 0.0, 0.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_25", position: (2.0, 1.0, -1.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_26", position: (2.0, 1.0, 0.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "hull_27", position: (0.0, 0.0, -3.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "reinforced_hull_section")),
                                    (id: "bridge", position: (0.0, 1.0, -2.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "basic_controller_section")),
                                    (id: "drive_port", position: (-1.0, 0.0, 3.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "basic_thruster_section")),
                                    (id: "drive_center", position: (0.0, 0.0, 3.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "basic_thruster_section")),
                                    (id: "drive_starboard", position: (1.0, 0.0, 3.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "basic_thruster_section")),
                                    (id: "drive_outrigger", position: (-2.0, 0.0, 1.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "basic_thruster_section")),
                                    (id: "pdc_dorsal", position: (0.0, 1.75, -1.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "pdc_kinetic_turret_section")),
                                    (id: "pdc_boom", position: (2.0, 1.75, 0.0), rotation: (0.0, 0.0, 0.0, 1.0), source: Prototype(id: "pdc_kinetic_turret_section")),
                                ],
                                integrity: (),
                                presentation: (skin: true, style: Some("salvage")),
                            )),
                            controller: AI((
                                engage_delay: Some(15.0),
                            )),
                        )),
                    )),
                ],
            ),
            (
                name: OnDefeated,
                once: true,
                filters: [
                    Entity((
                        id: Some("raider"),
                    )),
                ],
                actions: [
                    ObjectiveComplete((
                        id: "hunt",
                    )),
                    Outcome((
                        outcome: Victory,
                        message: Some("The raider is down."),
                    )),
                ],
            ),
            (
                name: OnDefeated,
                once: true,
                filters: [
                    Entity((
                        id: Some("player"),
                    )),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("The gunship broke up."),
                    )),
                ],
            ),
            (
                name: OnNeutralized,
                once: true,
                filters: [
                    Entity((
                        id: Some("player"),
                    )),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("The gunship is disarmed."),
                    )),
                ],
            ),
        ],
    )),
]
