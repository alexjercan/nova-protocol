                    NextScenario((scenario_id: "ledger_05_freight_lane", linger: true)),
                ],
            ),
            (
                name: OnDefeated,
                once: true,
                filters: [
                    Entity((id: Some("player_spaceship"))),
                    Expression((LessThan(Term(Factor(Name("stage"))), Term(Factor(Literal(Number(98.0))))))),
                ],
                actions: [
                    VariableSet((key: "stage", expression: Term(Factor(Literal(Number(98.0)))))),
                    Outcome((outcome: Defeat, message: Some("Ship disabled."))),
                    NextScenario((scenario_id: "ledger_04_cold_patrol", linger: true)),
