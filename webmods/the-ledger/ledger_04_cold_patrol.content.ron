                once: true,
                filters: [
                    Expression((GreaterThan(Term(Factor(Name("inspected"))), Term(Factor(Literal(Number(1.0))))))),
                    Expression((GreaterThan(Term(Factor(Name("cleared"))), Term(Factor(Literal(Number(1.0))))))),
                ],
                actions: [
                    ObjectiveComplete((id: "patrol")),
                    VariableSet((key: "stage", expression: Term(Factor(Literal(Number(99.0)))))),
