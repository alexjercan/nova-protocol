// The Ledger, chapter 3 of 4: THE QUIET CHANNEL. Run the box to Broker
// Vesh's yard through the debris channel - thread the NAV gates in order
// (the gauntlet's expression-guarded sequencing) with TWO distinct textured
// beats: a REAL STEALTH run past two NEUTRAL Magpie pickets (task
// 20260723-000320: they patrol the flanks of the lane and only wake -
// SetAllegiance -> Enemy - if the player enters a picket-watch zone,
// paints one, or BURNS TOO HOT through the channel: over 8 u/s reads as
// noise the pickets hear, gated warn-then-trip on the reserved
// player_speed readout, task 20260723-143603), and a debris pinch between
// NAV-1 and NAV-2 (two invulnerable boulders tightening the lane, a
// PILOTING hazard - and the one lane the picket watch does not cover). Slip the channel undetected (spotted == 0)
// and the pickets stay asleep: Vesh's payoff line lands at the yard, then
// the Victory a beat later. Wake them (spotted == 1) and it is the old
// fight - run or shoot, the gates stay the objective either way.
//
// Pacing (task 20260722-214105, the ch1/Shakedown idiom): a paced opening
// conversation briefs the run before the first NAV objective posts, and each
// gate transition arms the beat behind it so the next Vesh line lands a beat
// LATER (announce -> arrive -> confirm -> breathe), not in the arrival frame;
// the pinch has its own warning + far-side confirm beats. The ENGINE holds
// every one of those waits: a beat whose guard is only "later" is a Sequence
// step, and a beat that must still ask something when it lands (which of the
// two arrival acks speaks, whether the run is still live) is a keyed timer.
//
// `gate` is the sequencing variable (1..4); `act` 1 = running, 2 = arrived.
// Player-death Defeat gates act < 2.
[
    Scenario((
        id: "ledger_ch3_quiet_channel",
        name: "The Quiet Channel",
        description: "Go dark and thread the debris channel to Vesh's yard. Chapter three of The Ledger.",
        cubemap: "dep://base/textures/cubemap.png",
        thumbnail: Some("self://thumbnails/ledger_ch3_quiet_channel.png"),
        hidden: true,
        watches: [
            (
                variable: "scenario_elapsed",
                query: Scenario((property: Elapsed)),
            ),
            (
                variable: "player_speed",
                query: Entity((
                    filter: (id: "player_spaceship"),
                    property: Speed,
                )),
            ),
        ],
        events: [
            (
                name: OnStart,
                filters: [],
                actions: [
                    // The scene's own lighting: the engine spawns no light, so a
                    // scenario that authors none renders black. Standard three-point
                    // key/rim/fill, each aimed at the origin.
                    SpawnScenarioObject((
                        base: (
                            id: "ch3_key",
                            name: "Key Light",
                            position: (-60.0, 50.0, 60.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Light(Directional(
                            illuminance: 11000.0,
                            color: Srgba((
                                red: 1.0,
                                green: 0.96,
                                blue: 0.9,
                                alpha: 1.0,
                            )),
                            shadows: true,
                            aim: Some((0.0, 0.0, 0.0)),
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "ch3_rim",
                            name: "Rim Light",
                            position: (30.0, 40.0, -80.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Light(Directional(
                            illuminance: 16000.0,
                            color: Srgba((
                                red: 0.72,
                                green: 0.86,
                                blue: 1.0,
                                alpha: 1.0,
                            )),
                            shadows: false,
                            aim: Some((0.0, 0.0, 0.0)),
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "ch3_fill",
                            name: "Fill Light",
                            position: (70.0, -20.0, 40.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Light(Directional(
                            illuminance: 2600.0,
                            color: Srgba((
                                red: 0.62,
                                green: 0.72,
                                blue: 0.95,
                                alpha: 1.0,
                            )),
                            shadows: false,
                            aim: Some((0.0, 0.0, 0.0)),
                        )),
                    )),
                    VariableSet((
                        key: "act",
                        expression: Term(Factor(Literal(Number(1.0)))),
                    )),
                    VariableSet((
                        key: "gate",
                        expression: Term(Factor(Literal(Number(1.0)))),
                    )),
                    // The corridor's paced beats are Sequence chains and keyed
                    // timers now: the ENGINE holds every cursor and every
                    // delay, so the briefing, the pinch warning and the two
                    // arrival breathers need no step counter, no stamped
                    // deadline and no said-flag between them.
                    //
                    // pinch_warn_said stays: it is not a beat gate but a
                    // BRANCH signal - the far-side confirm reads it to know
                    // whether the warning it answers has landed.
                    VariableSet((
                        key: "pinch_warn_said",
                        expression: Term(Factor(Literal(Number(0.0)))),
                    )),
                    // Stealth state (task 20260723-000320): spotted is the
                    // provocation one-shot (0 = the pickets sleep, 1 = woken
                    // by proximity, paint, or overspeed - and every wake
                    // handler gates on 0, so the flip fires exactly once).
                    VariableSet((
                        key: "spotted",
                        expression: Term(Factor(Literal(Number(0.0)))),
                    )),
                    // speed_warned is the overspeed warn-then-trip state
                    // machine (task 20260723-143603; reaction window
                    // 20260723-182850): 0 = never burned hot,
                    // 1 = warned (Vesh called it, pickets still asleep),
                    // 2 = armed (slowed back under the rearm band),
                    // 3 = counting down (a fresh breach started the `overspeed`
                    // timer; be hot when it ends to wake them, ease off under 7
                    // to cancel back to armed).
                    // Gated on spotted == 0 like the other provocations, so any
                    // wake disarms it and it disarms them.
                    VariableSet((
                        key: "speed_warned",
                        expression: Term(Factor(Literal(Number(0.0)))),
                    )),
                    // The objectives panel stays EMPTY through the opening
                    // conversation; this HOLDING line is all that shows until
                    // the briefing hands off to the first NAV drop (beat sheet:
                    // no objective shares a frame with a conversation).
                    Objective((
                        id: "obj_ch3_recap",
                        message: "Ch.3 - The Quiet Channel: stand by for Vesh's nav drops.",
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "player_spaceship",
                            name: "Salvage Tug Kestrel",
                            position: (0.0, 0.0, 40.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Spaceship((
                            controller: Player((
