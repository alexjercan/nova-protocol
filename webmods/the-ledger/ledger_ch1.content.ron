// The Ledger, chapter 1 of 4: DEAD WEIGHT (task 20260716-123535, spike
// 20260716-183104). The fantasy tutorial: strip a dead freighter for a
// three-crate quota, then the job turns - the fourth ping is a sealed
// military black box nobody logged. Mechanics are the shipped patterns:
// act-gated salvage OnEnter counting (shakedown), per-crate objectives with
// markers, a Neutral patrol ship as set dressing (broadside), Victory ->
// NextScenario chain and player-death Defeat + retry (broadside).
//
// Acts: 1 = quota run, 2 = the black box ping, 3 = resolved (victory beat).
// Every handler is act-gated except the player-death Defeat, which is the
// deliberate global exception - gated to act < 3 so a post-victory death
// cannot overwrite an earned win (the broadside act-gating lesson).
[
    Scenario((
        id: "ledger_ch1_dead_weight",
        name: "Dead Weight",
        description: "Mesa Verde Reclamation contract 4471: strip the freighter Ceres Matron for a three-crate quota. Chapter one of The Ledger.",
        cubemap: "dep://base/textures/cubemap.png",
        thumbnail: Some("self://thumbnails/ledger_ch1_dead_weight.png"),
        watches: [
            (
                variable: "scenario_elapsed",
                query: Scenario((property: Elapsed)),
            ),
        ],
        events: [
            (
                name: OnStart,
                filters: [],
                actions: [
                    // The scene's own lighting: the engine spawns no light, so a
                    // scenario that authors none renders black. Standard three-point
                    // key/rim/fill, each aimed at the origin.
                    SpawnScenarioObject((
                        base: (
                            id: "ch1_key",
                            name: "Key Light",
                            position: (-600.0, 500.0, 600.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Light(Directional(
                            illuminance: 11000.0,
                            color: Srgba((
                                red: 1.0,
                                green: 0.96,
                                blue: 0.9,
                                alpha: 1.0,
                            )),
                            shadows: true,
                            aim: Some((0.0, 0.0, 0.0)),
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "ch1_rim",
                            name: "Rim Light",
                            position: (300.0, 400.0, -800.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Light(Directional(
                            illuminance: 16000.0,
                            color: Srgba((
                                red: 0.72,
                                green: 0.86,
                                blue: 1.0,
                                alpha: 1.0,
                            )),
                            shadows: false,
                            aim: Some((0.0, 0.0, 0.0)),
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "ch1_fill",
                            name: "Fill Light",
                            position: (700.0, -200.0, 400.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Light(Directional(
                            illuminance: 2600.0,
                            color: Srgba((
                                red: 0.62,
                                green: 0.72,
                                blue: 0.95,
                                alpha: 1.0,
                            )),
                            shadows: false,
                            aim: Some((0.0, 0.0, 0.0)),
                        )),
                    )),
                    VariableSet((
                        key: "act",
                        expression: Term(Factor(Literal(Number(1.0)))),
                    )),
                    VariableSet((
                        key: "crates",
                        expression: Term(Factor(Literal(Number(0.0)))),
                    )),
                    // Opening-conversation sequencer (the Shakedown idiom):
                    // open_step walks the briefing lines on the scenario
                    // clock; quota_posted is the one-shot hand-off that lazy-
                    // posts the first crate objective. The between-pickup
                    // breathers are keyed timers and need no seed.
                    VariableSet((
                        key: "open_step",
                        expression: Term(Factor(Literal(Number(0.0)))),
                    )),
                    VariableSet((
                        key: "quota_posted",
                        expression: Term(Factor(Literal(Number(0.0)))),
                    )),
                    // The objectives panel stays EMPTY through the opening
                    // conversation; this HOLDING line is all that shows until
                    // the briefing hands off to the first crate (beat sheet:
                    // no objective shares a frame with a conversation).
                    Objective((
                        id: "obj_ch1_recap",
                        message: "Ch.1 - Dead Weight: stand by for the work order.",
                    )),
                    // The tug: the gauntlet player loadout (turret included -
                    // later chapters fight, and the belt is not polite).
                    SpawnScenarioObject((
                        base: (
                            id: "player_spaceship",
                            name: "Salvage Tug Kestrel",
                            position: (0.0, 0.0, 400.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Spaceship((
                            controller: Player((
                                input_mapping: {
                                    "turret_starboard": [
                                        Mouse(Left),
                                        Gamepad(RightTrigger2),
                                    ],
                                    "turret_port": [
                                        Mouse(Left),
                                        Gamepad(RightTrigger2),
                                    ],
                                },
                                speed_cap: Some(250.0),
                            )),
                            hull: Inline((
                                sections: [
                                    (
                                        id: "engine_starboard",
                                        position: (
                                            1.205,
                                            0.6,
                                            1.975,
                                        ),
                                        rotation: (
                                            0.0,
                                            0.0,
                                            0.0,
                                            1.0,
                                        ),
                                        source: Prototype("cargoa_engine_starboard"),
                                        modifications: [],
                                    ),
                                    (
                                        id: "engine_port",
                                        position: (
                                            -1.205,
                                            0.6,
                                            1.975,
                                        ),
                                        rotation: (
                                            0.0,
                                            0.0,
                                            0.0,
                                            1.0,
                                        ),
                                        source: Prototype("cargoa_engine_port"),
                                        modifications: [],
                                    ),
                                    (
                                        id: "pod_starboard",
                                        position: (
                                            1.205,
                                            0.7,
                                            0.47500002,
                                        ),
                                        rotation: (
                                            0.0,
                                            0.0,
                                            0.0,
                                            1.0,
                                        ),
                                        source: Prototype("cargoa_pod_starboard"),
                                        modifications: [],
                                    ),
                                    (
                                        id: "pod_port",
                                        position: (
                                            -1.205,
                                            0.7,
                                            0.47500002,
                                        ),
                                        rotation: (
                                            0.0,
                                            0.0,
                                            0.0,
                                            1.0,
                                        ),
                                        source: Prototype("cargoa_pod_port"),
                                        modifications: [],
                                    ),
                                    (
                                        id: "nose",
                                        position: (
                                            0.0,
                                            0.8,
                                            -1.8,
                                        ),
                                        rotation: (
                                            0.0,
                                            0.0,
                                            0.0,
                                            1.0,
                                        ),
                                        source: Prototype("cargoa_nose"),
                                        modifications: [],
                                    ),
                                    (
                                        id: "tail",
                                        position: (
                                            0.0,
                                            0.5875,
                                            1.975,
                                        ),
                                        rotation: (
                                            0.0,
                                            0.0,
                                            0.0,
                                            1.0,
                                        ),
                                        source: Prototype("cargoa_tail"),
                                        modifications: [],
                                    ),
                                    (
                                        id: "fuselage",
                                        position: (
                                            0.0,
                                            0.8,
                                            0.17500001,
                                        ),
                                        rotation: (
                                            0.0,
                                            0.0,
                                            0.0,
                                            1.0,
                                        ),
                                        source: Prototype("cargoa_fuselage"),
                                        modifications: [],
                                    ),
                                    (
                                        id: "turret_starboard",
                                        position: (
                                            0.95,
                                            0.8,
                                            -1.8,
                                        ),
                                        rotation: (
                                            0.0,
                                            0.0,
                                            -0.70710677,
                                            0.70710677,
                                        ),
                                        source: Prototype("pdc_kinetic_turret_section"),
                                        modifications: [],
                                    ),
                                    (
                                        id: "turret_port",
                                        position: (
                                            -0.95,
                                            0.8,
                                            -1.8,
                                        ),
                                        rotation: (
                                            0.0,
                                            0.0,
                                            0.70710677,
                                            0.70710677,
                                        ),
                                        source: Prototype("pdc_kinetic_turret_section"),
                                        modifications: [],
                                    ),
                                ],
                            )),
                        )),
                    )),
                    // The wreck: two dead hull masses, invulnerable set
                    // dressing (nothing in this chapter should pop the stage).
                    // Nominal radius is NOT the visible size: the asteroid
                    // noise mesh reaches ASTEROID_GEOMETRIC_FACTOR_MIN..MAX
                    // (3.5..6.0) past the nominal sphere, so the real hull is
                    // radius * ~6 at worst. These stay small (real ~70..120 m) so
                    // the quota crates 150..160 m out never end up buried inside
                    // the rock, AND so they stay under min_well_radius (5.0) -
                    // a bigger nominal would silently make each wreck a gravity
                    // well that tugs the tug across the whole work site.
                    SpawnScenarioObject((
                        base: (
                            id: "matron_bow",
                            name: "Ceres Matron - Bow Section",
                            position: (0.0, 0.0, -800.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Asteroid((
                destroy_sound: Some("dep://base/sounds/destroy_rock.wav"),
                            radius: 20.0,
                            texture: "dep://base/textures/asteroid.png",
                            mass: None,
                            invulnerable: true,
                            lock_signature: None,
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "matron_stern",
                            name: "Ceres Matron - Stern Section",
                            position: (200.0, -80.0, -1000.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Asteroid((
                destroy_sound: Some("dep://base/sounds/destroy_rock.wav"),
                            radius: 17.0,
                            texture: "dep://base/textures/asteroid.png",
                            mass: None,
                            invulnerable: true,
                            lock_signature: None,
                        )),
                    )),
                    // The manifest: three quota crates, each its own objective
                    // + marker so pickup order does not matter.
                    SpawnScenarioObject((
                        base: (
                            id: "ledger_crate_1",
                            name: "Container MV-1",
                            position: (120.0, 50.0, -700.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: SalvageCrate((
                            pickup_sound: Some("dep://base/sounds/salvage_pickup.wav"),
                            size: 20.0,
                            area_radius: 60.0,
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "ledger_crate_2",
                            name: "Container MV-2",
                            position: (-140.0, -30.0, -880.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: SalvageCrate((
                            pickup_sound: Some("dep://base/sounds/salvage_pickup.wav"),
                            size: 20.0,
                            area_radius: 60.0,
                        )),
                    )),
                    SpawnScenarioObject((
                        base: (
                            id: "ledger_crate_3",
                            name: "Container MV-3",
                            position: (80.0, -100.0, -1080.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: SalvageCrate((
                            pickup_sound: Some("dep://base/sounds/salvage_pickup.wav"),
                            size: 20.0,
                            area_radius: 60.0,
                        )),
                    )),
                    // The fourth ping. Spawned dark: no objective, no marker,
                    // until the quota flips act 2.
                    SpawnScenarioObject((
                        base: (
                            id: "ledger_blackbox",
                            name: "Unlogged Container",
                            position: (20.0, -160.0, -1240.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: SalvageCrate((
                            pickup_sound: Some("dep://base/sounds/salvage_pickup.wav"),
                            size: 20.0,
                            area_radius: 60.0,
                        )),
                    )),
                    // The three crate objectives + their markers are NOT
                    // posted here - the crates spawn as set dressing and the
                    // objectives lazy-post on the briefing hand-off (the
                    // open_step cascade below), so a blind burn cannot start
                    // the quota before Okono has called it.
                    // A Magpie watches the job from a lazy patrol loop.
                    // Neutral: chapter one has no fight, only a bad feeling.
                    SpawnScenarioObject((
                        base: (
                            id: "magpie_scout",
                            name: "Magpie Scout 'Sixpence'",
                            position: (1100.0, 200.0, -1200.0),
                            rotation: (0.0, 0.0, 0.0, 1.0),
                        ),
                        kind: Spaceship((
                            allegiance: Some(Neutral),
                            controller: AI((
                                patrol: [
                                    (1100.0, 200.0, -1200.0),
                                    (600.0, -100.0, -400.0),
                                    (1400.0, 0.0, -300.0),
                                ],
                            )),
                            hull: Inline((
                                sections: [
                                    (
                                        id: "engine_starboard",
                                        position: (
                                            1.205,
                                            0.6,
                                            1.975,
                                        ),
                                        rotation: (
                                            0.0,
                                            0.0,
                                            0.0,
                                            1.0,
                                        ),
                                        source: Prototype("cargoa_engine_starboard"),
                                    ),
                                    (
                                        id: "engine_port",
                                        position: (
                                            -1.205,
                                            0.6,
                                            1.975,
                                        ),
                                        rotation: (
                                            0.0,
                                            0.0,
                                            0.0,
                                            1.0,
                                        ),
                                        source: Prototype("cargoa_engine_port"),
                                    ),
                                    (
                                        id: "pod_starboard",
                                        position: (
                                            1.205,
                                            0.7,
                                            0.47500002,
                                        ),
                                        rotation: (
                                            0.0,
                                            0.0,
                                            0.0,
                                            1.0,
                                        ),
                                        source: Prototype("cargoa_pod_starboard"),
                                    ),
                                    (
                                        id: "pod_port",
                                        position: (
                                            -1.205,
                                            0.7,
                                            0.47500002,
                                        ),
                                        rotation: (
                                            0.0,
                                            0.0,
                                            0.0,
                                            1.0,
                                        ),
                                        source: Prototype("cargoa_pod_port"),
                                    ),
                                    (
                                        id: "nose",
                                        position: (
                                            0.0,
                                            0.8,
                                            -1.8,
                                        ),
                                        rotation: (
                                            0.0,
                                            0.0,
                                            0.0,
                                            1.0,
                                        ),
                                        source: Prototype("cargoa_nose"),
                                    ),
                                    (
                                        id: "tail",
                                        position: (
                                            0.0,
                                            0.5875,
                                            1.975,
                                        ),
                                        rotation: (
                                            0.0,
                                            0.0,
                                            0.0,
                                            1.0,
                                        ),
                                        source: Prototype("cargoa_tail"),
                                    ),
                                    (
                                        id: "fuselage",
                                        position: (
                                            0.0,
                                            0.8,
                                            0.17500001,
                                        ),
                                        rotation: (
                                            0.0,
                                            0.0,
                                            0.0,
                                            1.0,
                                        ),
                                        source: Prototype("cargoa_fuselage"),
                                    ),
                                ],
                            )),
                        )),
                    )),
                    // Loose debris for depth, outside the work site.
                    ScatterObjects((
                        id_prefix: "ledger_debris_",
                        count: 10,
                        seed: 4471,
                        region: Ring(
                            inner: 1500.0,
                            outer: 2100.0,
                            y_min: -500.0,
                            y_max: 100.0,
                        ),
                        template: (
                            base: (
                                id: "ledger_debris_",
                                name: "Debris",
                                position: (0.0, 0.0, 0.0),
                                rotation: (0.0, 0.0, 0.0, 1.0),
                            ),
                            kind: Asteroid((
                destroy_sound: Some("dep://base/sounds/destroy_rock.wav"),
                                radius: 10.0,
                                texture: "dep://base/textures/asteroid.png",
                                mass: None,
                                invulnerable: false,
                                lock_signature: None,
                            )),
                        ),
                        asteroid_radius: Some((8.0, 20.0)),
                    )),
                ],
            ),
            // --- Opening conversation (the Shakedown idiom): Okono briefs
            // over the scenario clock, one line per handler/beat, spaced
            // ~9s apart. The objectives panel holds on the stand-by line the
            // whole time; the first crate objective lazy-posts only when the
            // briefing hands off (open_step == 4 below), so a blind burn
            // cannot start the quota before it is called. ---
            (
                name: OnUpdate,
                filters: [
                    Expression((Equal(
                        Term(Factor(Name("open_step"))),
                        Term(Factor(Literal(Number(0.0)))),
                    ))),
                    Expression((GreaterThan(
                        Term(Factor(Name("scenario_elapsed"))),
                        Term(Factor(Literal(Number(2.0)))),
                    ))),
                ],
                actions: [
                    VariableSet((
                        key: "open_step",
                        expression: Term(Factor(Literal(Number(1.0)))),
                    )),
                    StoryMessage((
                        speaker: "Foreman Okono",
                        text: "Kestrel, the Ceres Matron's yours. She died out here three weeks back - reactor scrammed, crew lifted off, and nobody's been back since.",
                        dwell: Some(7.0),
                    )),
                ],
            ),
            (
                name: OnUpdate,
                filters: [
                    Expression((Equal(
                        Term(Factor(Name("open_step"))),
                        Term(Factor(Literal(Number(1.0)))),
                    ))),
                    Expression((GreaterThan(
                        Term(Factor(Name("scenario_elapsed"))),
                        Term(Factor(Literal(Number(11.0)))),
                    ))),
                ],
                actions: [
                    VariableSet((
                        key: "open_step",
                        expression: Term(Factor(Literal(Number(2.0)))),
                    )),
                    StoryMessage((
                        speaker: "You",
                        text: "Copy, Okono. She's a big one. What's Mesa Verde want off her?",
                    )),
                ],
            ),
            (
                name: OnUpdate,
                filters: [
                    Expression((Equal(
                        Term(Factor(Name("open_step"))),
                        Term(Factor(Literal(Number(2.0)))),
                    ))),
                    Expression((GreaterThan(
                        Term(Factor(Name("scenario_elapsed"))),
                        Term(Factor(Literal(Number(20.0)))),
                    ))),
                ],
                actions: [
                    VariableSet((
                        key: "open_step",
                        expression: Term(Factor(Literal(Number(3.0)))),
                    )),
                    StoryMessage((
                        speaker: "Foreman Okono",
                        text: "Three containers on the manifest, that's the whole contract. Strip it clean and we call it a shift. Quota's quota.",
                        dwell: Some(7.0),
                    )),
                ],
            ),
            (
                name: OnUpdate,
                filters: [
                    Expression((Equal(
                        Term(Factor(Name("open_step"))),
                        Term(Factor(Literal(Number(3.0)))),
                    ))),
                    Expression((GreaterThan(
                        Term(Factor(Name("scenario_elapsed"))),
                        Term(Factor(Literal(Number(29.0)))),
                    ))),
                ],
                actions: [
                    VariableSet((
                        key: "open_step",
                        expression: Term(Factor(Literal(Number(4.0)))),
                    )),
                    StoryMessage((
                        speaker: "You",
                        text: "Understood. Working the wreck line now.",
                    )),
                ],
            ),
            // The hand-off: the briefing is done, so lazy-post the first
            // crate objective and its marker. Gated quota_posted == 0 so it
            // fires exactly once. The other two crate objectives post on
            // pickup, a beat apart, in the OnEnter handlers below.
            (
                name: OnUpdate,
                filters: [
                    Expression((Equal(
                        Term(Factor(Name("open_step"))),
                        Term(Factor(Literal(Number(4.0)))),
                    ))),
                    Expression((Equal(
                        Term(Factor(Name("quota_posted"))),
                        Term(Factor(Literal(Number(0.0)))),
                    ))),
                ],
                actions: [
                    VariableSet((
                        key: "quota_posted",
                        expression: Term(Factor(Literal(Number(1.0)))),
                    )),
                    ObjectiveComplete((
                        id: "obj_ch1_recap",
                    )),
                    Objective((
                        id: "obj_crate_1",
                        message: "Salvage container MV-1.",
                    )),
                    ObjectiveMarkerAttach((
                        target_id: "ledger_crate_1",
                        label: "MV-1",
                    )),
                    Objective((
                        id: "obj_crate_2",
                        message: "Salvage container MV-2.",
                    )),
                    ObjectiveMarkerAttach((
                        target_id: "ledger_crate_2",
                        label: "MV-2",
                    )),
                    Objective((
                        id: "obj_crate_3",
                        message: "Salvage container MV-3.",
                    )),
                    ObjectiveMarkerAttach((
                        target_id: "ledger_crate_3",
                        label: "MV-3",
                    )),
                ],
            ),
            // --- Act 1: the quota. One handler per crate, order-free. ---
            (
                name: OnEnter,
                filters: [
                    Entity((
                        id: Some("ledger_crate_1"),
                        other_id: Some("player_spaceship"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("act"))),
                        Term(Factor(Literal(Number(1.0)))),
                    ))),
                ],
                actions: [
                    DespawnScenarioObject((
                        id: "ledger_crate_1",
                    )),
                    VariableSet((
                        key: "crates",
                        expression: Add(Factor(Name("crates")), Term(Factor(Literal(Number(1.0))))),
                    )),
                    ObjectiveComplete((
                        id: "obj_crate_1",
                    )),
                    // Breather: stamp this crate's OWN gate and hand the
                    // follow-up Okono line to the delayed handler below, so
                    // the acknowledgment lands a beat after the pickup, not
                    // on the same frame (the beat-sheet breather). Per-crate
                    // gates keep the three pickups order-free and independent.
                    TimerStart((
                        key: "ack1",
                        seconds: Term(Factor(Literal(Number(2.5)))),
                    )),
                ],
            ),
            (
                name: OnEnter,
                filters: [
                    Entity((
                        id: Some("ledger_crate_2"),
                        other_id: Some("player_spaceship"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("act"))),
                        Term(Factor(Literal(Number(1.0)))),
                    ))),
                ],
                actions: [
                    DespawnScenarioObject((
                        id: "ledger_crate_2",
                    )),
                    VariableSet((
                        key: "crates",
                        expression: Add(Factor(Name("crates")), Term(Factor(Literal(Number(1.0))))),
                    )),
                    ObjectiveComplete((
                        id: "obj_crate_2",
                    )),
                    TimerStart((
                        key: "ack2",
                        seconds: Term(Factor(Literal(Number(2.5)))),
                    )),
                ],
            ),
            (
                name: OnEnter,
                filters: [
                    Entity((
                        id: Some("ledger_crate_3"),
                        other_id: Some("player_spaceship"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("act"))),
                        Term(Factor(Literal(Number(1.0)))),
                    ))),
                ],
                actions: [
                    DespawnScenarioObject((
                        id: "ledger_crate_3",
                    )),
                    VariableSet((
                        key: "crates",
                        expression: Add(Factor(Name("crates")), Term(Factor(Literal(Number(1.0))))),
                    )),
                    ObjectiveComplete((
                        id: "obj_crate_3",
                    )),
                    TimerStart((
                        key: "ack3",
                        seconds: Term(Factor(Literal(Number(2.5)))),
                    )),
                ],
            ),
            // The three delayed pickup acknowledgments: each fires a beat
            // after ITS crate is on the hook, on the `ackN` timer that
            // crate's pickup starts. A timer that was never started never
            // ends, and `once` retires the handler, so the three are
            // independent and the pickups stay order-free.
            (
                name: OnTimerEnd,
                once: true,
                filters: [
                    Timer((key: "ack1")),
                ],
                actions: [
                    StoryMessage((
                        speaker: "Foreman Okono",
                        text: "MV-1 on the hook. Two to go.",
                    )),
                ],
            ),
            (
                name: OnTimerEnd,
                once: true,
                filters: [
                    Timer((key: "ack2")),
                ],
                actions: [
                    StoryMessage((
                        speaker: "Foreman Okono",
                        text: "MV-2 logged. Keep it moving, the Matron isn't getting any deader.",
                    )),
                ],
            ),
            (
                name: OnTimerEnd,
                once: true,
                filters: [
                    Timer((key: "ack3")),
                ],
                actions: [
                    StoryMessage((
                        speaker: "Foreman Okono",
                        text: "MV-3. That's the manifest done.",
                    )),
                ],
            ),
            // Quota met (`> 2`, not `== 3`: a double-fire cannot skip the
            // gate - the count-gate lesson) -> act 2. This only ARMS the
            // reveal (starts the `ping` timer); the reveal is the chapter's
            // hook, so it gets its own announce -> breathe -> objective beats
            // below, not a single frame-0 dump.
            (
                name: OnUpdate,
                filters: [
                    Expression((Equal(
                        Term(Factor(Name("act"))),
                        Term(Factor(Literal(Number(1.0)))),
                    ))),
                    Expression((GreaterThan(
                        Term(Factor(Name("crates"))),
                        Term(Factor(Literal(Number(2.0)))),
                    ))),
                ],
                actions: [
                    VariableSet((
                        key: "act",
                        expression: Term(Factor(Literal(Number(2.0)))),
                    )),
                    // Let the "manifest done" line breathe before the hook.
                    TimerStart((
                        key: "ping",
                        seconds: Term(Factor(Literal(Number(4.0)))),
                    )),
                ],
            ),
            // The 4th-ping reveal ANNOUNCE (a beat after the quota closes):
            // one line, then the `beat` timer for the objective breather.
            (
                name: OnTimerEnd,
                once: true,
                filters: [
                    Timer((key: "ping")),
                    Expression((Equal(
                        Term(Factor(Name("act"))),
                        Term(Factor(Literal(Number(2.0)))),
                    ))),
                ],
                actions: [
                    TimerStart((
                        key: "beat",
                        seconds: Term(Factor(Literal(Number(3.5)))),
                    )),
                    StoryMessage((
                        speaker: "Foreman Okono",
                        text: "Hold up. Scope's showing a fourth return, deep in the stern... that container is not on any manifest I've ever filed.",
                        dwell: Some(8.0),
                    )),
                    // The belt turns wrong the moment the black box shows up.
                    // Fires once (`once` on the handler above).
                    SetSkybox((cubemap: "dep://base/textures/cubemap_alt.png")),
                ],
            ),
            // The reveal BREATHE -> objective: the unlogged container posts a
            // beat after the reveal line lands, on the `beat` timer that line
            // starts. The timer only exists because the reveal fired, so the
            // old ping_said == 1 filter has nothing left to say.
            (
                name: OnTimerEnd,
                once: true,
                filters: [
                    Timer((key: "beat")),
                ],
                actions: [
                    Objective((
                        id: "obj_blackbox",
                        message: "Investigate the unlogged container.",
                    )),
                    ObjectiveMarkerAttach((
                        target_id: "ledger_blackbox",
                        label: "UNLOGGED",
                    )),
                ],
            ),
            // The black box -> act 3, victory, chapter 2.
            (
                name: OnEnter,
                filters: [
                    Entity((
                        id: Some("ledger_blackbox"),
                        other_id: Some("player_spaceship"),
                    )),
                    Expression((Equal(
                        Term(Factor(Name("act"))),
                        Term(Factor(Literal(Number(2.0)))),
                    ))),
                ],
                actions: [
                    DespawnScenarioObject((
                        id: "ledger_blackbox",
                    )),
                    VariableSet((
                        key: "act",
                        expression: Term(Factor(Literal(Number(3.0)))),
                    )),
                    ObjectiveComplete((
                        id: "obj_blackbox",
                    )),
                    Outcome((
                        outcome: Victory,
                        message: Some("The quota's in the hold - and so is a sealed military casing that was never on the books. Okono's board is already lighting up with buyers nobody called."),
                    )),
                    NextScenario((
                        scenario_id: "ledger_ch2_claim_jumpers",
                        linger: true,
                    )),
                ],
            ),
            // Player death before the win: Defeat + retry this chapter.
            // Gated act < 3 so a post-victory death cannot overwrite the win.
            (
                name: OnDestroyed,
                filters: [
                    Entity((
                        id: Some("player_spaceship"),
                    )),
                    Expression((LessThan(
                        Term(Factor(Name("act"))),
                        Term(Factor(Literal(Number(3.0)))),
                    ))),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("The belt keeps the Kestrel. Mesa Verde files the claim, and the debt rolls over."),
                    )),
                    NextScenario((
                        scenario_id: "ledger_ch1_dead_weight",
                        linger: true,
                    )),
                ],
            ),
            (
                name: OnNeutralized,
                filters: [
                    Entity((
                        id: Some("player_spaceship"),
                    )),
                    Expression((LessThan(
                        Term(Factor(Name("act"))),
                        Term(Factor(Literal(Number(3.0)))),
                    ))),
                ],
                actions: [
                    Outcome((
                        outcome: Defeat,
                        message: Some("Nothing left to fight with - the belt keeps the Kestrel. Mesa Verde files the claim, and the debt rolls over."),
                    )),
                    NextScenario((
                        scenario_id: "ledger_ch1_dead_weight",
                        linger: true,
                    )),
                ],
            ),
        ],
    )),
]
